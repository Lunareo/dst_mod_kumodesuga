msgstr "What was this thing originally for."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMAREPIE"
msgid "有点瘆人。"
msgstr "A bit eerie."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "一切正常。"
msgstr "All is normal."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "噩梦快结束了。"
msgstr "The nightmare is almost over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "这附近没有魔力。"
msgstr "No magic in this area."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "保持稳定。"
msgstr "Holding steady."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "在退。"
msgstr "Receding."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "这附近的魔力浓了。"
msgstr "The magic in this area is thickening."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "在变浓。"
msgstr "Thickening."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTSTICK"
msgid "带电。"
msgstr "Electrified."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NIGHTSWORD"
msgid "谁会做这种东西。很可怕。"
msgstr "Who would make such a thing. Terrifying."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.NITRE"
