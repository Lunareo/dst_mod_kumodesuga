msgstr "A smell of sulfur."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "花跟治疗魔法很配。"
msgstr "The flower suits healing magic well."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
