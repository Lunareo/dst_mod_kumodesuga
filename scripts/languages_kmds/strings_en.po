msgstr "Not warm enough."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
