msgstr "This shouldn't be kept on one's person."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "想一个人待着？"
msgstr "Want to be alone?"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "她开始愿意搭话了。"
msgstr "She's becoming willing to talk."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "今天格外有精神。"
msgstr "Unusually spirited today."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.LONG"
