msgstr "This tree has been dug up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
