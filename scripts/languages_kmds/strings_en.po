msgstr "Almost done!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_COOKPOT.DONE"
