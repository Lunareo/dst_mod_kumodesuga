msgstr "Rain, stop."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
