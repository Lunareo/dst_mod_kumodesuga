msgid "雕得很庄严呢～女王的架子有了～"
msgstr "A stately statue."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "石头做的主教～"
msgstr "A stone bishop."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "棋子自己动起来了哟～有趣～"
msgstr "The piece moved itself."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "漂亮……吧？嗯，算漂亮～"
msgstr "Pretty... I suppose."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CARRAT"
msgid "优胜者的雕像～真威风呢～"
msgstr "The champion."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CATCOON"
msgid "猫会跑来磨爪子的哟～"
msgstr "The cats will come sharpen their claws."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "陶犬～脑袋只有一颗，那就安心啦～"
msgstr "A clay hound, only one head, reassuring."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "没吃上饭就结束了呢～真可惜～"
msgstr "No dinner for it, finished."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_CRABKING"
msgid "比麦斯威尔脾气好一点呢～"
msgstr "Less temperamental than Maxwell."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "跑到不知哪里去了呢～"
msgstr "Gone off to who knows where."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "跟废品堆是一伙的呀～"
msgstr "A line for the scrap heap."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "那只眼睛一直跟着人呢～"
msgstr "The eyes follow you."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "碍眼的雕塑呢～砸了算啦？"
msgstr "An eyesore of a sculpture."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "虫子～果然是这样呢～"
msgstr "A worm, naturally."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "让我想起不太美好的回忆呢～"
msgstr "A memory, the bad kind."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "石头也会盯着人看呀～我可不怕～"
msgstr "A stone gaze."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_FORMAL"
msgid "一点也不像王呢～王可不是这个样子哟～"
msgstr "Doesn't look like a king."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "这个样子反而更好呢～"
msgstr "Better this way."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "光看着就饿了呀～"
msgstr "Just looking makes me hungry."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KITCOON"
msgid "这一只倒是好找呢～"
msgstr "This one's easy to find."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KLAUS"
msgid "「不带装饰」的克劳斯呀～这个我想要～"
msgstr "An 'unadorned' Klaus, I want one."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "石头做的马～"
msgstr "A knight, in stone."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "棋子自己动起来了哟～有趣～"
msgstr "The piece moved itself."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "不来袭击我的话还挺好看的～"
msgstr "Fine, as long as it doesn't attack."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "好想抱一下～可惜石头磨人呢～"
msgstr "I want to hug it, but stone chafes."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "这回换你僵在原地咯～"
msgstr "This time, you're the one frozen."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MOON"
msgid "最近灵感不错呀～"
msgstr "I've had ideas lately."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "栩栩如生……唔，太像了反而不妙呢～"
msgstr "Lifelike... mm."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_MUSE"
msgid "嗯……见过这张脸？在哪儿呢～"
msgstr "Mm... have I seen this? Where."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_PAWN"
msgid "小卒呀～这滋味我懂哟～"
msgstr "A pawn, I know the type."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_PIPE"
msgid "烟斗～这个我可不抽～"
msgstr "A pipe, I don't smoke."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "比看起来还重呢～"
msgstr "Heavier than it looks."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "棋子自己动起来了哟～有趣～"
msgstr "The piece moved itself."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "这鳍的感觉抓得不错哟～"
msgstr "It has a finny sort of feeling."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_STALKER"
msgid "骸骨的标准静止姿态～摆得不错～"
msgstr "A skeleton, standard-issue stillness."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "当凳子？不行不行，坐着扎人～"
msgstr "A stool? No, not quite."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "那一晚的眼神交流最糟糕啦～"
msgstr "The worst eye contact of that night."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "个子还差得远哟～"
msgstr "Not tall enough."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "月亮之上的心情呀～我不太想懂～"
msgstr "Above the moon, what a mood."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "设计得挺好，执行嘛……微妙～"
msgstr "Fine design, dubious execution."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "就差一口吐息了呀～"
msgstr "Only a breath away."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "现在想起来还发抖呢～骗你的哟～"
msgstr "I'm still shivering now."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_YOTD"
msgid "光是看着，心跳就加速了呢～"
msgstr "Just looking, and my heart races."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_YOTH"
msgid "命苦的骑士呢～"
msgstr "A hard-luck knight."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESSPIECE_YOTS"
msgid "拜金要远离～这可是我的原则～"
msgstr "No idol worship, on principle."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTER"
msgid "切斯特～毛球做的箱子，可爱～"
msgstr "Chester, the fuzzy box."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "它在看我呢～"
msgstr "It's watching me."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "睡着了哟～"
msgstr "Asleep."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "物理法则意外地柔软呢～"
msgstr "The laws of physics, surprisingly soft."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "装得不错！差点咬到我～"
msgstr "Well disguised! It nearly bit me~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHIPS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHIPS"
msgid "薯片呀～咔嚓咔嚓，一眨眼就见底了。D那孩子在这方面倒是有好品味嘛～"
msgstr "Chips~ Crunch crunch, and before you know it, they're gone. That little D child has good taste too."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CHUM"
msgid "鱼饵！这就开钓～"
msgstr "Chum!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CLAYHOUND.GENERIC"
msgid "放出来啦！"
msgstr "It's loose!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CLAYHOUND.STATUE"
msgid "做得挺像真的呢～"
msgstr "Like the real thing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CLAYWARG.GENERIC"
