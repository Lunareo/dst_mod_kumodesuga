msgstr "A moon mushtree, stranger than the rest."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "被酸糊了一层呢～别碰哟～"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "正在繁殖呢～加油哟～"
msgstr "It's breeding."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_SMALL.GENERIC"
