msgstr "Cooking is learning put into practice."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TURNIP_SEEDS"
msgid "一把奇怪的种子。"
msgstr "A handful of strange seeds."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TURTILLUS"
msgid "它的壳很多刺。"
msgstr "Its shell is covered in spikes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.BURNING"
msgid "浪费木头。"
msgstr "A waste of wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.BURNT"
msgid "火的事，与我无关。"
msgstr "The fire isn't my business."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "接着，自然。"
msgstr "Carry on, nature."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "看着病了。比平时更明显。"
msgstr "Looks sick. More visibly than usual."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "全是枝条。"
msgstr "All twigs."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGY_NUT"
msgid "里面有一棵想出来的树。"
msgstr "A tree that wants out is inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "它不需要人帮就能长。"
msgstr "It can grow without anyone's help."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGGY_OLD"
msgid "那棵树看着很虚。"
msgstr "That tree looks weak."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWIGS"
msgid "一把小树枝。"
msgstr "A handful of twigs."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWINOFTERROR1"
msgid "它们也许是友善的。……也许不是。"
msgstr "They might be friendly.... They might not."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TWINOFTERROR2"
msgid "它们也许是友善的。……也许不是。"
msgstr "They might be friendly.... They might not."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.UMBRELLA"
msgid "我讨厌头发被淋湿蓬起来。"
msgstr "I hate wet, frizzy hair."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.UNAGI"
msgid "鳗鱼饭。手艺过关。"
msgstr "Eel rice. The craftsmanship passes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.UNIMPLEMENTED"
msgid "它看着没做完。可能很危险。"
msgstr "It looks unfinished. Possibly dangerous."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "灯灭了。"
msgstr "The lights are out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "没有能比得上的。"
msgstr "Nothing else compares."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "它一直在把我引向这个房间。"
msgstr "It's been leading me to this room all along."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "它在这里似乎不起作用。"
msgstr "It doesn't seem to work here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "它偏要在我顺手的时候掉下来。"
msgstr "It insists on dropping when I'm in reach."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "插得刚好。"
msgstr "Fits perfectly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "只是一根神秘的拉杆，能出什么事。"
msgstr "Just a mysterious lever, what could go wrong."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_DECON_DOOR"
msgid "它是为了关住什么，还是为了拦住什么。"
msgstr "Is it for keeping something in, or keeping something out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_DECON_MISTER"
msgid "很神秘。"
msgstr "Very mysterious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY"
msgid "我终于找到回家的钥匙了吗。"
msgstr "Have I finally found the key to going home."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "我脑子里冒出一个主意。"
msgstr "An idea just came to me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_EXIT"
msgid "这里没法绑绳子。"
msgstr "There's nowhere to tie a rope here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "那就是一切的钥匙。"
msgstr "That's the key to everything."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "空的。"
msgstr "Empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "要是绑一根绳子，我就能爬回去。"
msgstr "With a rope tied on, I could climb back up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_ORB"
msgid "我想这个有它的作用。"
msgstr "I suppose this serves its purpose."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_ORB_REFINED"
msgid "它确实让我动起来。"
msgstr "It really does get me moving."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "我们的开始有点坎坷。"
msgstr "Our start was a bit rocky."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "它还需要什么。"
msgstr "What else does it need."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "得给它找个好位置。"
msgstr "Must find a good spot for it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "什么都过不了这家伙。"
msgstr "Nothing gets past this fellow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "一座塔。"
msgstr "A tower."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "它只需要一点启发的火花。"
msgstr "It only needs a spark of inspiration."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "这一定是那座会走的塔的重要部件。"
msgstr "This must be a vital part of that walking tower."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "这技术很古老。"
msgstr "The technology is ancient."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_RUNE"
msgid "那个我读不懂。"
msgstr "I can't read that one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_STATUE.LORE1"
msgid "他似乎结局很黑暗。"
msgstr "His ending seems to have been a dark one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_STATUE.LORE2"
msgid "这个让我很不舒服。"
msgstr "This one makes me very uncomfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_STATUE.LORE3"
msgid "它们的说法很尖锐。"
msgstr "Their phrasing is sharp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "它坏了。"
msgstr "It's broken."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "这一件确实让我动起来。"
msgstr "This one really gets me moving."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "它需要电。"
msgstr "It needs electricity."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION"
msgid "\"此路标正在为将来的更新开发中。\""
msgstr "\"This waypoint is under development for a future update.\""

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "那个开关看着坏了。"
msgstr "That switch looks broken."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "那是电灯开关吗。"
msgstr "Is that a light switch."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VEGGIEOMLET"
msgid "早餐是一天里最讲道理的一餐。"
msgstr "Breakfast is the most reasonable meal of the day."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "运气很差。"
msgstr "Terrible luck."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VEGSTINGER"
msgid "那根芹菜能当吸管用吗。"
msgstr "Could that celery be used as a straw."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "我祖母大概穿过类似的东西。"
msgstr "My grandmother probably wore something like this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH"
msgid "那些影子都是同一块布上剪下来的。"
msgstr "All those shadows were cut from the same cloth."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTHHAT"
msgid "它让我觉得自己黑暗而神秘。"
msgstr "It makes me feel dark and mysterious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "退货规则是什么。"
msgstr "What is the return policy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_KIT"
msgid "我用影子缝东西的知识很零碎。"
msgstr "My knowledge of sewing with shadows is patchy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "它让收成变得容易得可怕。"
msgstr "It makes harvesting terrifyingly easy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "我讨厌头发被酸融掉。"
msgstr "I hate my hair being dissolved by acid."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.VOLTGOATJELLY"
msgid "好吃得让人一震。"
msgstr "Delicious enough to jolt you."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAFFLES"
msgid "要不要再加糖浆，我还在犹豫。"
msgstr "Whether to add syrup, I'm still deliberating."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT"
msgid "很有意思。"
msgstr "Fascinating."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "现在还盖着。"
msgstr "Still covered for now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "大的机器确实会装在小包裹里。"
msgstr "Big machines really do come in small packages."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "它是散件的。"
msgstr "It comes unassembled."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "它撑了一阵。"
msgstr "It held up for a while."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "有人试过把它重置吗。"
msgstr "Has anyone tried resetting it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "很有意思。"
msgstr "Fascinating."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_BEACON"
msgid "这能帮着把东西圈住。"
msgstr "This helps keep things corralled."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "它坏得修不了，但零件我能救回来。"
msgstr "It's broken beyond repair, but I can salvage the parts."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "像从地狱里冲出来的机器。"
msgstr "A machine straight out of hell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "该带它转一圈。"
msgstr "Time to take it for a spin."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_PARTS"
msgid "现在我能让事情朝好的方向转了。"
msgstr "Now I can turn things around."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "我可以修它，也可以拆零件。"
msgstr "I could fix it, or salvage the parts."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "转起来就赢了。"
msgstr "Roll it out and we've won."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "它们只会一直嗡嗡响。"
msgstr "They just keep buzzing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "该带它转一圈。"
msgstr "Time to take it for a spin."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNKBITS_KIT"
msgid "修别的机器的机器。接下来还会做出什么。"
msgstr "A machine that fixes other machines. What will they make next."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNKHAT"
msgid "它让我的齿轮转起来。"
msgstr "It gets my gears turning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_BITS"
msgid "用这个我大概能做出很有学问的东西。"
msgstr "With this I could probably make something very learned."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "要墙，或者什么都不要。"
msgstr "Walls, or nothing at all."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "这是什么地板。"
msgstr "What kind of floor is this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_LEVER"
msgid "正是换个方式的好时候。"
msgstr "Just the moment for a change of approach."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "开始干活。"
msgstr "Time to get to work."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "奇怪，这只手套不是投影。"
msgstr "Strange, this glove isn't a projection."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "这块写字板是……真的。"
msgstr "This writing tablet is... real."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "这堆废料里也许有值得发现的东西。"
msgstr "There may be something worth discovering in this scrap heap."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "很有意思。很有启发。让脑子变大。"
msgstr "Fascinating. Enlightening. Enlarges the brain."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.WAGSTAFF_NPC"
msgid "他讲道理，我出力。等价交换。"
