msgstr "Meat, drying."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "架子烧干了。"
msgstr "The rack itself dried out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "肉干好了！"
msgstr "Jerky time!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
