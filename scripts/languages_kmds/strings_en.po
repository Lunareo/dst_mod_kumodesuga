msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NOGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NONEWMOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NONEWMOON"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NOTNIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NOTNIGHT"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.OCEAN_FISHING_POND.WRONGGEAR"
msgid "池塘这么小，竿子这么大。谁教你的？"
msgstr "The pond is small, this rod too large."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.OPEN_CRAFTING.PROFESSIONALCHEF"
msgid "要更专业的厨师。我负责吃，这叫分工。"
msgstr "A proper chef is required. I handle the eating. Division of labor."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "这不是我的领域。影子的东西，少碰。"
msgstr "This doesn't belong to me."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "空的。白高兴一场，真讨厌。"
msgstr "Empty. All that hope, wasted."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICK.STUCK"
msgid "卡住了。再用点力，我可不想输给一株植物。"
msgstr "Stuck. Pull harder."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "缠满诅咒了。不碰——我身上的诅咒已经够多了。"
msgstr "Wrapped in curses. Not touching it. I carry quite enough curses already."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.INUSE"
msgid "有人在拿。排队，我等着。"
msgstr "Queue. Wait."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NOTMINE_SPIDER
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NOTMINE_SPIDER"
msgid "only_used_by_webber"
msgstr "only_used_by_webber"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "这不是我的胡萝卜鼠。"
msgstr "That is not my carrat."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "咬我？！你胆子真大啊。"
msgstr "It bit me?! The audacity."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NO_HEAVY_LIFTING
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.NO_HEAVY_LIFTING"
msgid "only_used_by_wanda"
msgstr "only_used_by_wanda"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "这东西我用不了。……别问为什么。"
msgstr "I can't use this."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "肥料的事，我不想知道得更多了。"
msgstr "Don't want to know more."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "都记住了。没有新东西。"
msgstr "I know it all. Nothing new."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "跑了。差一点。"
msgstr "It got away."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "水用完了。"
msgstr "The water is spent."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "壶空了。谁去装满，快点。"
msgstr "The can is empty. Who's refilling it."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.READ.ALREADYFULLMOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.READ.ALREADYFULLMOON"
