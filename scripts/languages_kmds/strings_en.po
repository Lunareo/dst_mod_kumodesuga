#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "哼！差点被吓到。……才没有！"
msgstr "Hmph! It nearly startled me.... As if!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHIPS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHIPS"
msgid "薯片……哼，膨化食品我才不看在眼里。……就吃一片。"
msgstr "Chips... hmph, junk food means nothing to me.... Just one piece."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHUM"
msgid "鱼饵！"
msgstr "Fish bait!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CLAYHOUND.GENERIC"
msgid "放出来了！"
msgstr "It charged!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CLAYHOUND.STATUE"
msgid "跟真的一样。"
msgstr "It resembles the real one."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CLAYWARG.GENERIC"
