#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LOG.GENERIC"
msgid "又大又重的木头。"
msgstr "A big, heavy log."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LORDFRUITFLY"
