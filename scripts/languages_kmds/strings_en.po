msgstr "\"Merms only\". ...So it is written."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "「鱼人专用」，上面这样写着。"
msgstr "\"Merms only\". ...So it is written."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_LUNAR"
msgid "鱼人往下一步变了。"
msgstr "The merm's next stage of evolution."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_PRINCE"
msgid "先来的先得。"
msgstr "First come, first served."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_SHADOW"
msgid "只剩从前的影子。"
msgstr "Only the shadow of what it was."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERM_TOOL"
