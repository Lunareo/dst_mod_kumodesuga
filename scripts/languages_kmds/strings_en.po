msgstr "Time to hang the meat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
