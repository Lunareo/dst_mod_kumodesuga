msgstr "What happened to the head."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "花长回来了，头没有。"
msgstr "The flowers grew back. The head didn't."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUEMAXWELL"
msgid "本人矮得多。"
msgstr "The real one is much shorter."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "一座讲究的大理石像。"
msgstr "A refined marble statue."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "别把头丢了。"
msgstr "Don't lose your head."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "很有雕像的样子。"
msgstr "Very befitting of a statue."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "作者是谁。"
msgstr "Who was the artist."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STEELWOOL"
msgid "扎人的金属纤维。"
msgstr "Prickly metal fibers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STEERINGWHEEL"
msgid "换一种活法，我大概会是水手。"
msgstr "In another life, I might have been a sailor."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "那会是舵轮。"
msgstr "That would be the wheel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STINGER"
msgid "很尖。"
msgstr "Very sharp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "我想坐在那把石头椅上。"
msgstr "I'd like to sit on that stone chair."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "别人坐在那上面。"
msgstr "Someone else is sitting there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_TABLE.GENERIC"
msgid "我会周期性地用桌子。"
msgstr "I use tables periodically."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "我会周期性地用桌子。"
msgstr "I use tables periodically."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "它坏了。"
msgstr "It's broken."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "别得意忘形。"
msgstr "Don't get carried away."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STRAWHAT"
msgid "帽子总会毁掉我的头发。"
msgstr "Hats always ruin my hair."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STUFFEDEGGPLANT"
