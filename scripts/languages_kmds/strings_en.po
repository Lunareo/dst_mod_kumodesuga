msgstr "Its pitch is a bit lower."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
