msgstr "The ground doesn't like it."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ICON"
msgid "你知道该回哪儿去呢～"
msgstr "You know where it belongs."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_IDOL"
msgid "有种想把它搬到某处去的冲动～"
msgstr "An urge to carry it somewhere."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_LINK"
msgid "在准备什么呢～我可期待着～"
msgstr "It's preparing something."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "里面的东西被困住了呢～"
msgstr "Something is trapped inside."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "里面的东西被困住了呢～"
msgstr "Something is trapped inside."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "里面的东西被困住了呢～"
msgstr "Something is trapped inside."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_SEED"
msgid "它想要个家哟～"
msgstr "It wants a home."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_ALTAR_WARD"
msgid "它想和同伴在一起哟～"
msgstr "It wants to be with its friends."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_CAP"
msgid "食欲一点都涌不上来呢～"
msgstr "My appetite doesn't rise."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_CAP_COOKED"
msgid "为了美味，这点付出不算什么～"
msgstr "For science, the price was high."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "才刚刚开始呢。"
msgstr "Science has only begun."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "越来越有样子了～"
msgstr "The sense of science grows."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "正在封入能量哟～当然，用途我可是知道的～"
msgstr "Energy sealed within, and naturally, I know its use."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "平静和警告一起跳。做得还挺讲究～"
msgstr "Calm and a warning leap up at once. Well designed~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "这里有裂纹显出来了呢～"
msgstr "Here the crack shows itself."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "说不上原理，但确实有效。"
msgstr "Not science, but it works."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.BURNING"
msgid "树烧起来啦！"
msgstr "The tree is burning!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.BURNT"
msgid "树烧掉了呢～"
msgstr "The tree has burnt."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.CHOPPED"
msgid "好厚实的树～"
msgstr "A thick trunk."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE.GENERIC"
msgid "长在月亮上的树呀～我可是头一回听说～"
msgstr "A tree that grows on the moon, news to me."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "月树落下的花～挺漂亮呢～"
msgstr "Blossoms of the moon tree."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "晒得干干的～不错～"
msgstr "Dried, good."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOOSE"
msgid "这是什么呀，看不明白呢～"
msgstr "What this is, unclear."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOOSEEGG"
msgid "孩子在里面兴奋地蹦呢～有活力真好～"
msgstr "The children bounce with excitement."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "孩子就放在这里呀～"
msgstr "The children are kept here."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOQUECA"
msgid "他厨艺高超，我可不是科学派，是魔女派～"
msgstr "His skill is superb, and I'm no science school, I'm the witch school~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITO.GENERIC"
msgid "吸血虫呀～讨厌讨厌～"
msgstr "Bloodsuckers, hateful."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITO.HELD"
msgid "这个……是我的血吗？还我哟～"
msgstr "This, is it my blood?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOBOMB"
msgid "手痒痒的～真想扔出去～"
msgstr "My hand itches to throw it."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOFERTILIZER"
msgid "植物很喜欢～据说是这样呢～"
msgstr "Plants love it, so I hear."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOMERMSALVE"
msgid "在鱼人圈里正流行哟～"
msgstr "All the rage in merm circles."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOMUSK"
msgid "蚊子叮不到啦～"
msgstr "The mosquitoes can't bite me."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSQUITOSACK"
msgid "这是谁的血呢……算了，别想了～"
msgstr "Whose blood..."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOSSLING"
msgid "啊！这不是电子的那种呀～"
msgstr "Ah! Not electronic!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOUND.DUG"
msgid "大概是该的吧～我可没内疚哟～"
msgstr "Probably deserved."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MOUND.GENERIC"
msgid "下面有好东西哟！挖挖看～"
msgstr "Something good down below!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULLEDDRINK"
msgid "酒劲够足～好酒！再来一桶～"
msgstr "It has a kick, good drink~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULTIPLAYER_PORTAL"
