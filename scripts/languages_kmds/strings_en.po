msgstr "I finally caught this fancy fish."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_8"
