msgstr "You used to be tall and sturdy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
