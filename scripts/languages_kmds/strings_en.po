msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "这不对。让它死得安稳些。"
msgstr "This is wrong."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERDEN"
msgid "巢。丝很粘。……主人的亲戚开的店？"
msgstr "A den. Sticky silk.... A shop run by Master's relatives?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "装饰过的巢。手很巧。"
msgstr "A decorated den. Skillful hands."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDEREGGSACK"
msgid "卵袋。别孵出来。"
msgstr "An egg sac. Don't let it hatch."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERGLAND"
msgid "腺体。一股消毒水味。"
msgstr "Glands. A medicinal smell."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERHAT"
msgid "王冠。粘液洗掉了吧？"
msgstr "A crown. Did the slime wash out?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERHOLE"
msgid "结着旧网。"
msgstr "An old web, still strung."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERHOLE_ROCK"
msgid "石头上结着旧网。"
msgstr "Old webbing, over a rock."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEEN"
msgid "女王。很大。……稍微给点敬意。"
msgstr "A queen. Huge. Some respect.... Just a little."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "火葬。这样好些。"
msgstr "Cremation. Better."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "女王的尸体。就这样了。"
msgstr "The queen's body. Awkward."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "要爬起来了。麻烦。"
msgstr "Not good."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERSCYTHE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDERSCYTHE"
msgid "被这东西捆住过的回忆……不许笑！"
msgstr "Memories of being tied by this thing... don't you dare laugh!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_DROPPER"
msgid "呜哇，虫子！……算是主人的亲戚？那，饶你。"
msgstr "Augh, an insect.... Master's relative? Then, never mind."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_HEALER"
msgid "蜘蛛能自愈了。哦。"
msgstr "Spiders can heal themselves now. Oh."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "见到蜘蛛……就给它们。大概。"
msgstr "When I see spiders... I'll give them out. Probably."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_HIDER"
msgid "虫子。……等等，主人的亲戚？那就不打了。"
msgstr "An insect.... Wait, Master's relative?... Then I stand down."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_MOON.DEAD"
msgid "真的死了？"
msgstr "Is it truly dead?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "月亮变的蜘蛛。可怜。……也算主人的亲戚？"
msgstr "A moon-changed spider. Pitiable.... A relative of Master's too?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "不动了。很好。"
msgstr "It stopped moving. Good."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_REPELLENT"
msgid "对我没效果。幸好。"
msgstr "On me... no effect. Fortunately."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_SPITTER"
msgid "喷丝的蜘蛛。远亲吧……哼，勉强算。"
msgstr "A web-spitting spider. A relative.... Hmph, barely counts."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "战士。辛苦了。……主人的亲戚也辛苦。"
msgstr "A warrior. Well fought.... Well fought, relative of Master's."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "战士。挺凶。……主人的亲戚里也有好坏。"
msgstr "A warrior. Vicious.... Master's relatives come in good and bad."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "保持距离。"
msgstr "Keep a distance."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WATER"
msgid "海上的蜘蛛。为什么能浮着。……主人的亲戚也会游泳。"
msgstr "A sea spider. How does it float.... Master's relatives can swim too."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPIDER_WHISTLE"
msgid "不想叫蜘蛛。……主人的亲戚另说。"
msgstr "I won't summon spiders.... Master's relatives are another matter."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FISH.CAN_PROCESS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FISH.CAN_PROCESS"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FISH.GENERIC"
msgid "臭……不想确认。"
msgstr "Foul... I would rather not confirm."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FOOD.CAN_PROCESS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FOOD.CAN_PROCESS"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPOILED_FOOD.GENERIC"
msgid "毛球一样的腐食。"
msgstr "A moldy, rotten morsel."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "悠哉悠哉的。"
msgstr "Idle and carefree."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "口袋里在发光。"
msgstr "A pocketful of light."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_MOON"
msgid "孢子。蘑菇当盾用。"
msgstr "Spores. A mushroom used as a shield."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "小孢子。"
msgstr "Small spores."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_SMALL.HELD"
msgid "口袋里在发光。"
msgstr "A pocketful of light."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_TALL.GENERIC"
msgid "飘着呢。"
msgstr "Drifting."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SPORE_TALL.HELD"
msgid "口袋里在发光。"
msgstr "A pocketful of light."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SQUID"
msgid "乌贼。有种会有用的预感。"
msgstr "A squid. A useful hunch."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFFCOLDLIGHT"
msgid "冷。……哼，冷这方面我可是专业的。"
msgstr "Cold.... Hmph, my specialty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFFLIGHT"
msgid "看起来很危险。"
msgstr "A dangerous look."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFF_LUNARPLANT"
msgid "植物的力量！"
msgstr "The power of plants!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAFF_TORNADO"
msgid "转起来很凶。"
msgstr "A vicious spin."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEHAND.AWAKE"
msgid "把自己的手管好。"
msgstr "Hand, mind your own affairs."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEHAND.HIDING"
msgid "哪里怪怪的。指头放不上去。"
msgstr "Something's off. My fingers won't stay."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEUSHER.SITTING"
msgid "有种违和感。原因不明。"
msgstr "Something's off. I can't say what."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STAGEUSHER.STANDING"
msgid "手别伸过来。好吗。"
msgstr "Hands to yourself. Understood?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALAGMITE"
msgid "石头。"
msgstr "Stone."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALAGMITE_TALL"
msgid "石头，还是石头……"
msgstr "Stone, stone..."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER"
msgid "骸骨和影子融合了！"
msgstr "Bone and shadow, fused!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER_ATRIUM"
msgid "为什么这么大。"
msgstr "Why is it so large."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER_MINION"
msgid "专咬脚踝的东西。"
msgstr "The ankle-biters."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER_NPC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STALKER_NPC"
msgid "过去的事。不再追究。算是协定。"
msgstr "The past. We agreed to pursue it no longer."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STASH_MAP"
msgid "藏宝图。宝物归我了。"
msgstr "A direction in life. A good thing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "碎了。得查一查。"
msgstr "Smashed. An investigation is required."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "这是什么东西。看不懂。"
msgstr "What is this. Unclear."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEHARP"
msgid "头怎么了？"
msgstr "What happened to the head?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "花恢复了。头没恢复。"
msgstr "The flowers grew back. The head didn't."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUEMAXWELL"
msgid "本人比这个矮。"
msgstr "In person, he is shorter."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "豪华的大理石像。"
msgstr "A luxurious marble figure."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "头别掉下来！"
msgstr "Mind the head does not fall!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "雕像很庄严。"
msgstr "A solemn statue."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "这是谁做的？"
msgstr "Who is the sculptor?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STEELWOOL"
msgid "金属纤维。很扎手。"
msgstr "Metal fibers. Prickly."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STEERINGWHEEL"
msgid "掌舵的人得有素质。"
msgstr "I have a sailor's aptitude."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "预定要做舵轮。"
msgstr "A rudder wheel, planned."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STINGER"
msgid "尖！"
msgstr "Sharp!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "石椅。我想坐。"
msgstr "A stone chair. I want to sit."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "被别人坐了。让开。"
msgstr "Someone else is seated."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_TABLE.GENERIC"
msgid "石桌。摆在这儿倒是合适。"
msgstr "A table. I use it periodically."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "有人把东西放这儿了。……是给我的？"
msgstr "A table. I use it periodically."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "坏了。修不修随你。"
msgstr "Broken."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "不许得意忘形。"
msgstr "No getting carried away."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STRAWHAT"
msgid "帽子把头发压坏了。"
msgstr "A hat that ruins hair."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STUFFEDEGGPLANT"
msgid "很饱。"
msgstr "Filling."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.STUFFING"
msgid "填料很不错。"
msgstr "Fine stuffing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_PICKED"
msgid "能吃。但我不想。"
msgstr "Edible. But I don't want it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "干得不错。"
msgstr "Dried, and well."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_PLANT"
msgid "芦荟。在这里。"
msgstr "The aloe is here."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUCCULENT_POTTED"
msgid "盆栽多肉。"
msgstr "A potted succulent."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "宝物……路上就已经拿到了。"
msgstr "Treasure... already gained along the way."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "关得很紧。"
msgstr "Shut tight."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPERTACKLECONTAINER"
msgid "高价购入。"
msgstr "Bought at a high price."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR"
msgid "该修了。迟早。"
msgstr "It needs repairs. Sooner or later."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "曾经又高又壮。"
msgstr "Once tall and strong."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "有安心感。"
msgstr "A sense of security."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "该修了。迟早。"
msgstr "It needs repairs. Sooner or later."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "塌得很惨。"
msgstr "A sorry sight."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "可怕的强度。"
msgstr "A fearsome strength."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "现在还包着。"
msgstr "Presently under wraps."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "现在还包着。"
msgstr "Presently under wraps."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.SURFNTURF
