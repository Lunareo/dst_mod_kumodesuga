msgstr "A cooling cocoon."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_EGG.GENERIC"
