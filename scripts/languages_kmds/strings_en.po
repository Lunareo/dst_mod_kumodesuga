msgstr "Why am I still where I stood."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HIGHRESEARCH"
msgid "学到了不少。多谢。"
msgstr "Learned a fair amount."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HOT"
msgid "热。得找水。"
msgstr "Hot. ...Find water."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HOUNDS"
msgid "狗叫声。来了。摆好架势。"
msgstr "Hounds' cries. ...They come. Take stance."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNGRY"
msgid "饿了。肚子在叫，失礼。"
msgstr "Hungry. ...My stomach growls. Excuse me."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNGRY_FASTBUILD.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNGRY_FASTBUILD.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNGRY_SLOWBUILD.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNGRY_SLOWBUILD.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_AVOID_FORK"
msgid "这边安全。绕过去。"
msgstr "Safer this way. ...Go around."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "足迹很新。就在附近。"
msgstr "The tracks are fresh. It is close."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "足迹断了。"
msgstr "The trail is lost."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "湿土留不住脚印。没办法。"
msgstr "Wet soil keeps no prints. ...Nothing to be done."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_START_FORK"
msgid "这条路危险。那就走这条。"
msgstr "This path... is dangerous. Even so, I walk it."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "选对了。运气不错。"
msgstr "Chose well. ...Good fortune."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_HUNT_WRONG_FORK"
msgid "有东西在盯着我……"
msgstr "Something... is watching me..."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "土还饿着。再添些肥。"
msgstr "Is the soil still hungry?"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_INV_FULL"
msgid "满了。再拿不动了。"
msgstr "Full. I can carry no more."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_IS_FEASTING"
msgid "冬之盛宴。吵闹的日子，我并不讨厌。"
msgstr "Winter's Feast. ...Joyful, is it."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KILLEDPLANT.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KILLEDPLANT.1"
msgid "only_used_by_wormwood"
msgstr "only_used_by_wormwood"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KINGCREATED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KINGCREATED"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KINGDESTROYED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KINGDESTROYED"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "就知道你藏在这里。"
msgstr "I knew it hid here."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "找到了。"
msgstr "Found you."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "在那里。"
msgstr "There."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "就知道。"
msgstr "I knew it."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "看见你了。"
msgstr "I see you."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "全找到了。"
msgstr "All found."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "{name}找到了最后一只。"
msgstr "{name} found the last one."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "还剩最后一只。在哪里。"
msgstr "Where is the last one?"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "不玩了吗。……可惜。"
msgstr "No more playing... then."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "它们等不及了。"
msgstr "They can wait no longer."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "不会藏这么远……吧。"
msgstr "They would not hide this far. ...Surely."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "回去。它们就在附近。"
msgstr "Go back. They are near."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "在玩捉迷藏吗。……可爱。"
msgstr "Playing hide-and-seek. ...Adorable."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "三、二、一。我来找了。"
msgstr "Three, two, one. ...Here I come."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "叫帮手了。卑鄙，但在预料之内。"
msgstr "It calls for aid. ...Cowardly. But within expectation."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KLAUS_ENRAGE"
msgid "它火了。正好，我还没打完。"
msgstr "Cannot I win...? No. It is not over."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KLAUS_UNCHAINED"
msgid "锁链断了。……来吧。"
msgstr "The chains have broken. ...Come."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_KNOCKEDOUT"
msgid "头晕，站不稳。"
msgstr "Dizzy... I cannot stand straight."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LIGHTFIRE.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LIGHTFIRE.1"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "闪电，躲开了。"
msgstr "The lightning, evaded."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "那只手，在做什么。"
msgstr "What is that hand doing."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LOWRESEARCH"
msgid "没什么收获。是我悟性不够。"
msgstr "Little learned. ...My insight falls short."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "又来了。"
msgstr "It comes again."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "鸟在坠落。愿它们安息。"
msgstr "The birds are falling. ...Heaven keep them."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "乌鸦的大合唱。"
msgstr "A grand chorus of crows."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "月亮的光。裂隙开到最大了。"
msgstr "The moon's light. ...The rift is at its fullest."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MAX_CLOCKWORKS"
msgid "一对就是上限。合理。"
msgstr "A pair is the limit. ...Reasonable."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "大信号。麻烦要来了。"
msgstr "A great signal. ...Trouble is coming."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MIGHTYTONORMAL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MIGHTYTONORMAL"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "身体里面在烧。"
msgstr "It burns inside my body."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "胃，在烧。"
msgstr "My stomach... burns."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "这个实验不再重复了。"
msgstr "This experiment will not be repeated."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MONKEY_CURSE_1"
msgid "身体，怪怪的。"
msgstr "Something feels... off."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "毛！？为什么长出毛来！"
msgstr "Fur!? Why have I grown fur!"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "猴子到此为止。幸好。"
msgstr "No more of this monkey. ...Thankfully."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "快出来了。"
msgstr "Nearly out."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "里面有形状了。"
msgstr "There is a shape within."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "出来了。"
msgstr "It has emerged."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "快出来了。"
msgstr "Nearly out."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "里面有形状了。"
msgstr "There is a shape within."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "出来了。"
msgstr "It has emerged."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "快出来了。"
msgstr "Nearly out."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "里面有形状了。"
msgstr "There is a shape within."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "出来了。"
msgstr "It has emerged."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOONPOTION_FAILED"
msgid "泡得不够久吗。"
msgstr "Not steeped long enough, it seems."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOSQUITOS"
msgid "吵。走开。"
msgstr "So loud...! Away with you!"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "它受伤了。让它歇着。"
msgstr "It is wounded. ...Let it rest."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "秃鹫。变异的。在盘旋。"
msgstr "Buzzards. Mutated. ...They circle."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODANGERGIFT"
msgid "附近有怪物。礼物等等再拆。"
msgstr "Monsters about. Gifts are opened later."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODANGERSIESTA"
msgid "有危险。午睡取消。"
msgstr "Danger. The siesta is cancelled."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODANGERSLEEP"
msgid "这种时候睡下去会死。撑住。"
msgstr "Sleep now and I die. ...Hold on."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODAYSLEEP"
msgid "太亮了，睡不着。"
msgstr "Too bright to sleep."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "还不困。"
msgstr "Not tired yet."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOHUNGERSIESTA"
msgid "饿了。先吃饭。"
msgstr "Hungry. Eat first."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOHUNGERSLEEP"
msgid "太饿了。空着肚子睡不安稳。"
msgstr "Too hungry. An empty stomach sleeps poorly."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOINSPIRATION
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOINSPIRATION"
msgid "only_used_by_wathgrithr"
msgstr "only_used_by_wathgrithr"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOMOUNTEDGIFT"
msgid "先下来，再拆。"
msgstr "Dismount first, then open."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NONIGHTSIESTA"
msgid "夜里就该好好睡。"
msgstr "Night is the time for sleep."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "这里放松不下来。"
msgstr "I cannot unwind here."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "南瓜熟透了。过火了。"
msgstr "The pumpkin is well and truly cooked. ...Overdone."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NORMALTOMIGHTY
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NORMALTOMIGHTY"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NORMALTOWIMPY
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NORMALTOWIMPY"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOSLEEPONFIRE"
msgid "还烧着火。先灭了它。"
msgstr "I cannot sleep while burning. ...Put out the fire first."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOTSKILLEDENOUGH
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOTSKILLEDENOUGH"
msgid "only_used_by_wathgrithr"
msgstr "only_used_by_wathgrithr"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOWARDROBEONFIRE"
msgid "着火了。换衣服的事，之后再说。"
msgstr "It is on fire. Wardrobe, later."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOWATERNEARBY
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NOWATERNEARBY"
msgid "only_used_by_waxwell_and_wicker"
msgstr "only_used_by_waxwell_and_wicker"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_NO_TRAP"
msgid "空的。也好，少一条命。"
msgstr "Empty-handed. ...Fine. No killing today."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "抛歪了。再来。"
msgstr "A crooked cast. ...Again."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "跑了。……可惜。"
msgstr "It escaped. ...A pity."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "鱼在哪里。"
msgstr "Where are the fish."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "换个地方，如何。"
msgstr "Try another spot, perhaps."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "耐心。耐心。"
msgstr "Patience. ...Patience."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "垂钓比挥剑难。"
msgstr "Angling is harder than the sword."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "线断了。"
msgstr "The line snapped."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
