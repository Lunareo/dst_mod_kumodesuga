msgstr "Time to eat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
