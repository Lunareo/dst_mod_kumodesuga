#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "意外地可爱。"
msgstr "Surprisingly cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMKING"
