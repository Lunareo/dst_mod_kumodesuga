msgstr "One more item for the checklist."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_PRIMEMATE"
