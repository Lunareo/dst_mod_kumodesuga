msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "没降下来。手滑了，不许看。"
msgstr "It didn't come down."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "帆不听话。啧，连布也敢反抗我？"
msgstr "The sail defies me. Fine."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "下次一定降下来。我说的话，不会错。"
msgstr "Next time it comes down. I said so."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "已经选好了。现在改主意太晚了。"
msgstr "Already chosen."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "没有参赛资格？我？！凭什么啊！"
msgstr "No entry? Me?! Inconceivable!"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MODSLINGSHOT.NOSLINGSHOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MODSLINGSHOT.NOSLINGSHOT"
msgid "only_used_by_walter"
msgstr "only_used_by_walter"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MOUNT.INUSE"
msgid "被抢先了。啧。"
msgstr "Beaten to it."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MOUNT.SLEEPING"
msgid "起来，时间到了。别装睡。"
msgstr "Up. It is time."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "它正在气头上。这种时候我不碰。"
msgstr "It's in a temper. I won't touch it."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.CAVE
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.CAVE"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NOFULLMOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.MUTATE.NOFULLMOON"
