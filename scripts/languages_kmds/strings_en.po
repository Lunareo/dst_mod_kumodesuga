msgstr "Faintly warm within."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
