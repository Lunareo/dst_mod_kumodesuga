msgstr "Poor thing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKEDMEAT"
msgid "烤得刚刚好～火候是要天分的呢～"
msgstr "Perfectly roasted."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKEDMONSTERMEAT"
msgid "比生的好那么一点点～只有一点点哟～"
msgstr "A touch better than raw."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKEDSMALLMEAT"
msgid "这样就不用担心寄生虫啦～"
msgstr "No parasites to worry about now."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKIECUTTER"
msgid "它盯上我的船了～这可让人不安呢～"
msgstr "It has eyes on my boat, unsettling."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKIECUTTERHAT"
msgid "至少头发是干的呢～"
msgstr "At least my hair stays dry."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKIECUTTERSHELL"
msgid "只剩个壳啦～"
msgstr "Only the shell remains."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "这字迹我认不出来呀～真可惜～"
msgstr "The handwriting is unreadable, a shame."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.BURNT"
msgid "锅自己被煮了呢～"
msgstr "The pot got cooked."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "要煮一会儿呢～急不得哟～"
msgstr "It needs a while yet~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "快好啦～"
msgstr "Almost done."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.DONE"
msgid "好了，开饭！我可要多盛一碗哟～"
msgstr "Done, dinner time!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKPOT.EMPTY"
msgid "空锅看着就饿呀～"
msgstr "Just looking makes me hungry."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOLANT"
msgid "咕嘟咕嘟冒泡～可能性满满哟～"
msgstr "Bubbling, full of possibility."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COONTAIL"
msgid "还在摇呢～真顽强～"
msgstr "Still wagging."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN"
msgid "糖分很高呢～我不介意哟～"
msgstr "High in sugar."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN_COOKED"
msgid "烤过糖分还是很高～那就多吃点～"
msgstr "Still sugary after roasting."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN_OVERSIZED"
msgid "玉米穗，大得夸张呢～"
msgstr "A corn cob, big."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CORN_SEEDS"
msgid "种子～"
msgstr "Seeds."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "铁匠的衣服～"
msgstr "A blacksmith costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_DOLL_BODY"
msgid "人偶的衣服～"
msgstr "A doll costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_FOOL_BODY"
msgid "愚者的衣服～"
msgstr "A fool costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_KING_BODY"
msgid "国王的衣服～"
msgstr "A king costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "一套服装～"
msgstr "A costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "有反对的人吗？无视～"
msgstr "Dissenters, ignore them."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "女王的衣服～"
msgstr "A queen costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COSTUME_TREE_BODY"
msgid "树的衣服～"
msgstr "A tree costume."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "需要燃料哟～"
msgstr "It needs fuel."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "让人安心的光呢～"
msgstr "A reassuring light."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "需要燃料哟～"
msgstr "It needs fuel."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "值得敬佩的像～"
msgstr "An image worthy of reverence."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "需要燃料哟～"
msgstr "It needs fuel."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "能一直注视下去呢，永远地……"
msgstr "I could gaze at it forever, forever..."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COTL_TRINKET"
msgid "王冠带来的成果～"
msgstr "The fruits of a crown."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COZY_BUNNYMAN"
msgid "暖和又舒适～这样就够啦～"
msgstr "Warm, cozy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING.GENERIC"
msgid "蟹王～这家伙不好惹呢～"
msgstr "The crab king, not to be trifled with."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING.INERT"
msgid "这座城要装饰一下啦～"
msgstr "The rook wants decorating."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_CANNONTOWER"
msgid "炮台～果然有这一手呢～"
msgstr "A cannon tower, as expected."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_CLAW"
msgid "钳子很危险哟～"
msgstr "Dangerous pincers."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_ICEWALL"
msgid "这是我和蟹之间的问题哟～"
msgstr "A matter between the crab and me."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_MOB"
msgid "脾气很坏的蟹～"
msgstr "A bad-tempered crab."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "壳很硬～是个强敌呢～"
msgstr "A hard shell, a formidable foe."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTERLAB"
msgid "里面装着什么呢～我可等不及了～"
msgstr "What could be inside."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_BULBIN"
msgid "不会做坏事的……吧？"
msgstr "It does no harm... probably."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_DRAGONLING"
msgid "小龙～这孩子住进我心里啦～"
msgstr "A little dragon, it's moved into my heart."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_EETS"
msgid "它在打量人呢～有点意思～"
msgstr "It's watching."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "眼睛多才安心～不过这只就够啦～"
msgstr "Many eyes are reassuring, just one."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_GLOMLING"
msgid "空气力学的小生物～飘得挺开心呢～"
msgstr "An aerodynamic creature."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_KITTEN"
msgid "合格的小助手～来，替我干活吧～"
msgstr "A qualified little helper."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_LAMB"
msgid "比它妈妈少了点黏液呢～"
msgstr "A little less slimy than its mother."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "月蛾～会发光，这点我给满分～"
msgstr "A lunar moth, it glows, good."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_PERDLING"
msgid "长羽毛的朋友～"
msgstr "A feathered friend."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRITTER_PUPPY"
msgid "小怪物一只～可爱～"
msgstr "A little critter, cute."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CROW.GENERIC"
msgid "不吉利呀～不过我可不信这些～"
msgstr "An ill omen."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CROW.HELD"
msgid "被关着不开心呢～"
msgstr "Unhappy in there."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CRUMBS"
msgid "连屑都藏不住～真笨呢～"
msgstr "Can't even hide the crumbs, silly."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "看着挺无害的呢～"
msgstr "It looks harmless."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTGRASS"
msgid "切好的草～手工活要用的哟～"
msgstr "Cut grass, for crafts."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTLESS"
msgid "不锋利，木刺还多～"
msgstr "Not sharp, plenty of splinters."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTLICHEN"
msgid "有营养，就是放不住呢～快点吃掉吧～"
msgstr "Nutritious, but it won't keep."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTREEDS"
msgid "切好的芦苇～"
msgstr "Cut reeds."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CUTSTONE"
msgid "滑滑的石头～摸着舒服～"
msgstr "Smooth stones."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER.GENERIC"
msgid "把他放出来，也许是我失策了呢～"
msgstr "Letting him out may have been a mistake."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "同情嘛……只有一点点哟～"
msgstr "Sympathy, a modicum."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER2.BURIED"
msgid "被困在垃圾底下啦～"
msgstr "Trapped beneath the junk."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER2.GENERIC"
msgid "可别惹他生气哟～"
msgstr "Best not to anger it."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "一副气冲冲的样子呢～"
msgstr "It looks cross."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "硬得异常的柱子～"
msgstr "An abnormally hard pillar."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "大理石里面有发光的东西呢～"
msgstr "Inside the marble, something glowing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEADLYFEAST"
msgid "剧毒料理呀～这个连我都要犹豫一下呢～"
msgstr "A lethal dish."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEAD_SEA_BONES"
msgid "上陆的代价呀～真是不划算呢～"
msgstr "The price of coming ashore."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "浪费木头呀～真可惜～"
msgstr "Such a waste of wood."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "这本来是能避免的呢……"
msgstr "This could have been prevented..."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "大自然呀，对不住咯～"
msgstr "Forgive me, nature."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "叶子挺多，普普通通的树～"
msgstr "Leafy, ordinary."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECIDUOUSTREE.POISON"
