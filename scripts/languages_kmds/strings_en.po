msgstr "Strictly speaking, this counts as a boat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_ITEM"
msgid "在水上做点试验也不错。"
msgstr "A few experiments on the water wouldn't hurt."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_LEAK"
msgid "该在沉下去之前补好。"
msgstr "Should be patched before it sinks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "它起作用了。呃，我当然知道它会。"
msgstr "It works. Well, of course I knew it would."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "我一直被物理吸引，像……啊，想不起那个词。"
msgstr "I've always been attracted to physics, like... ah, the word escapes me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "磁力。"
msgstr "Magnetism."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "这会吸引附近所有强磁的东西。"
msgstr "This attracts all strongly magnetic things nearby."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_MAGNET_KIT"
msgid "这算我比较聪明的主意之一。"
msgstr "One of my cleverer ideas."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_ROTATOR"
msgid "事情在朝正确的方向走。也可能是左边。"
msgstr "Things are moving in the right direction. Or possibly the left one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "我要带它出去转一圈。"
msgstr "I'll take it out for a spin."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "要是它没有牛的味道就好了。"
msgstr "If only it didn't smell of beefalo."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_KELP"
msgid "比我想要的更湿。"
msgstr "Wetter than I wanted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_PETALS"
msgid "至少比那个牛毛枕头好闻。"
msgstr "At least it smells better than that beefalo one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "谁会睡在这上面。"
msgstr "Who would sleep on this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOMB_LUNARPLANT"
msgid "植物学和化学一起工作。"
msgstr "Botany and chemistry, working together."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "我们的朋友似乎越来越贴近他月亮的根了。"
msgstr "Our friend seems ever closer to his moon's roots."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BONESHARD"
msgid "骨头的碎片。"
msgstr "A fragment of bone."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BONESOUP"
msgid "毫无疑问，沃利会做菜。"
msgstr "Without question, Warly can cook."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BONESTEW"
msgid "能让人长肉的汤。"
msgstr "A soup that puts meat on you."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOKSTATION.BURNT"
msgid "图书馆关门了。"
msgstr "The library is closed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOKSTATION.GENERIC"
msgid "写书的桌子。我只看小说。"
msgstr "A writing desk. I only read novels."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_BEES"
msgid "不明白它为什么受欢迎。"
msgstr "Don't understand why it's popular."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_BIRDS"
msgid "关于鸟的书。故事性不足。"
msgstr "A book about birds. Lacks narrative."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_BRIMSTONE"
msgid "开头很闷，结尾还不错。"
msgstr "Dull opening, decent ending."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_ELEMENTAL"
msgid "上面的字我看不懂。"
msgstr "I can't read the writing on it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_FIRE"
msgid "没有非读不可的理由。"
msgstr "No reason I must read it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_FISH"
msgid "没有勾住我。"
msgstr "Didn't hook me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_FOSSIL"
msgid "这能把那些怪物困住一会儿。"
msgstr "This could trap those monsters for a while."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_GARDENING"
msgid "种田的书。不有趣。"
msgstr "A farming book. Not interesting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_HORTICULTURE"
msgid "种田的书。不有趣。"
msgstr "A farming book. Not interesting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "和看草长一样刺激。"
msgstr "As thrilling as watching grass grow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_LIGHT"
msgid "写这本的人很亮。"
msgstr "Whoever wrote this is very bright."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "亮。"
msgstr "Bright."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_MOON"
msgid "对月亮的兴趣，只是一个阶段。"
msgstr "Interest in the moon was just a phase."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_RAIN"
msgid "听起来不太讲道理。"
msgstr "Doesn't sound very logical."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "凡事照书办的人会喜欢这个。"
msgstr "People who do everything by the book will like this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_SILVICULTURE"
msgid "种树的书。太慢。"
msgstr "A tree-planting book. Too slow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_SLEEP"
msgid "五百页的电报码。奇怪的品味。"
msgstr "Five hundred pages of telegraph code. Strange taste."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_TEMPERATURE"
msgid "温的。评价也是。"
msgstr "Lukewarm. So is the review."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_TENTACLES"
msgid "会有人被这本书吸进去。"
msgstr "Someone will get sucked into this book."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOK_WEB"
msgid "蛛网的书。我认识一只更大的。"
msgstr "A book of spiderwebs. I know a bigger one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOMERANG"
msgid "符合空气动力学。"
msgstr "Aerodynamic."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOOTLEG"
msgid "外面某处有个海盗少了一只靴子。"
msgstr "Somewhere out there, a pirate is missing one boot."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BROKEN_FORGEDITEM"
msgid "它坏了，但我大概能修好。"
msgstr "It's broken, but I can probably fix it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "把它烧得够热，就能把碎片熔回去。"
msgstr "Heat it enough, and the fragments could be ironed back together."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BRUSH"
msgid "皮弗娄牛应该很喜欢这个。"
msgstr "The beefalo should love this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUGNET"
msgid "用来捉虫。"
msgstr "For catching bugs."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "嗯。是海带。"
msgstr "Hm. Kelp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "我控制不住自己。"
msgstr "I couldn't help myself."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BULLKELP_ROOT"
msgid "能种在深水里。"
msgstr "Can be planted in deep water."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNDLE"
msgid "补给都在里面。"
msgstr "All the supplies are inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNDLEWRAP"
msgid "包起来会好拿一些。"
msgstr "Wrapping makes it easier to carry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNNYMAN"
msgid "忽然很想做点什么。"
msgstr "Suddenly feel like doing something."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUNNYSTEW"
msgid "这一只的运气用完了。"
msgstr "This one's luck ran out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "全烧光了。"
msgstr "All burned away."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUSHHAT"
msgid "有点扎人。"
msgstr "A bit prickly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTER"
msgid "居然是黄油。"
msgstr "Butter, of all things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "蝴蝶，飘过去了。"
msgstr "A butterfly, drifting past."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLY.HELD"
msgid "抓到你了。"
msgstr "Caught you."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "配方扔掉了。凭感觉做的。"
msgstr "Recipe thrown out. Made by feel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUTTERFLYWINGS"
msgid "没有这个，它就只是黄油。"
msgstr "Without this, it's just butter."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARD"
msgid "奇怪的秃鹫。"
msgstr "A strange buzzard."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "这才叫火鸟。"
msgstr "Now that's a fire bird."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "我说这是禽。"
msgstr "I say it's a fowl."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "它正在变成新的物种。"
msgstr "It's becoming a new species."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CABBAGEROLLS"
msgid "肉躲在菜里，为了避开猎手。"
msgstr "The meat hides in the cabbage, evading hunters."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS.GENERIC"
msgid "扎人。但好吃。"
msgstr "Prickly. But tasty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS.PICKED"
msgid "瘪了。还是带刺。"
msgstr "Deflated. Still spiky."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS_FLOWER"
msgid "带刺的植物开出的漂亮花。"
msgstr "A pretty flower from a prickly plant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS_MEAT"
msgid "我和一顿好饭之间还隔着几根刺。"
msgstr "A few spikes still stand between me and a good meal."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "沙漠的果实，烤过的。"
msgstr "The fruit of the desert, roasted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CALIFORNIAROLL"
msgid "但我没有筷子。"
msgstr "But I have no chopsticks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.EMBERS"
msgid "火要灭了。得加燃料。"
msgstr "The fire is dying. Needs fuel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.GENERIC"
msgid "比黑暗好。"
msgstr "Better than darkness."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.HIGH"
msgid "火有点失控。"
msgstr "The fire is getting out of hand."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.LOW"
msgid "火小下去了。"
msgstr "The fire has shrunk."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.NORMAL"
msgid "舒服。"
msgstr "Comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAMPFIRE.OUT"
msgid "结束了。"
msgstr "It's over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANARY.GENERIC"
msgid "某种黄色的生物。"
msgstr "Some kind of yellow creature."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANARY.HELD"
msgid "没捏死。算你结实。"
msgstr "Not crushed. Sturdier than you look."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANARY_POISONED"
msgid "大概没事。"
msgstr "Probably fine."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANDYBAG"
msgid "一个装甜食的口袋维度。"
msgstr "A pocket dimension for sweets."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANE"
msgid "严格说，走路只是受控制的跌倒。"
msgstr "Strictly speaking, walking is just controlled falling."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "这个正好塞进炮里。"
msgstr "Fits into the cannon perfectly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "很响。"
msgstr "Very loud."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "这个实验是故意炸的。"
msgstr "This experiment was designed to explode."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALCANNON_KIT"
msgid "把东西弄炸，这方面我经验很多。"
msgstr "Making things explode is an area where I have much experience."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "这些亮闪闪的装饰大概很衬我。"
msgstr "These shiny decorations would probably suit me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "要我自己搭吗。我早该想到有附带条件。"
msgstr "I have to assemble it myself? I should've expected fine print."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "我能看它好几个小时。"
msgstr "I could watch it for hours."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "希望这个奖品名副其实。"
msgstr "Hope this prize lives up to its name."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "我好像拿到很多这个。"
msgstr "I seem to have gotten a lot of these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "看。这证明把同一件事反复做下去，最后会成功。"
msgstr "Look. Proof that repeating the same thing eventually pays off."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "这种式样不常见。"
msgstr "This style is uncommon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
