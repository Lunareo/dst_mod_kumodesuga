msgstr "Not much left."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATFRAGMENT04"
