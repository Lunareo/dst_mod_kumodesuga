msgstr "This one won't bring me bad luck."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_5"
