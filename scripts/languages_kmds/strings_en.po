msgstr "A fish this size won't last long."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_5"
