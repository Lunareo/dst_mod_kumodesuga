msgstr "An axe, reliable."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "可爱～毛球球一只～"
msgstr "Adorable, a fuzzy little ball."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BABYBEEFALO.SLEEPING"
