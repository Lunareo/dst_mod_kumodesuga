#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "亮起来啦～"
msgstr "Glowing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "烧焦了呢～"
msgstr "Burnt."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT2.OFF"
