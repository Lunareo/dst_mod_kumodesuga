msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCHOR"
msgid "防止船漂走用的～"
msgstr "It keeps the boat from drifting."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCHOR_ITEM"
msgid "能做锚哟～"
msgstr "It can be an anchor."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "刚采下来的～还热腾腾呢～"
msgstr "Freshly picked, still warm."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "抽动得少一点就好啦～"
msgstr "Twitching, less would be better."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "至少不再抽动了呢～"
msgstr "At least it stopped twitching."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "既是植物又是矿物～妙呀～"
msgstr "Plant and mineral at once, ingenious."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "被开采完啦～"
msgstr "Mined out."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "这树得谨慎处理哟～"
msgstr "A tree, handle with care."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "树桩～"
msgstr "A stump."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "正在长大！大概吧～"
msgstr "Growing! Probably?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "地方合适，可时机还没到呢～"
msgstr "Suitable, but the timing is off."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "看着养分不够呢～"
msgstr "It seems short on nutrients."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "得种在合适的地方哟～"
msgstr "It needs planting in the right place."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENTTREE_SEED"
msgid "没什么意外～只是我的数据不够呢～"
msgstr "No surprises, merely insufficient data."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_ALTAR"
msgid "古代的神秘祭坛呀～这种东西背后总藏着麻烦事呢～"
msgstr "An ancient, mystic altar."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "坏掉了呢～真可惜～"
msgstr "Broken."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_HUSK"
msgid "这里发生过坏事呢。"
msgstr "Something bad happened here."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANCIENT_STATUE"
msgid "它在动呢……和这世界不一样的节奏哟～"
msgstr "It moves... to a rhythm apart from this world."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANIMAL_TRACK"
msgid "食物的足迹～是动物哟～"
msgstr "Tracks of food, an animal."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANTCHOVIES"
msgid "能放回去吗？……算了，吃掉吧～"
msgstr "May I put them back?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANTLION.GENERIC"
msgid "想要什么呀？说来听听，我们做笔交易～"
msgstr "What is it you want? Let's trade~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ANTLION.UNHAPPY"
