msgstr "Mm! Ready to eat!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
