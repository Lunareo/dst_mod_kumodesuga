msgstr "A buoy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "浮标。"
msgstr "A buoy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
