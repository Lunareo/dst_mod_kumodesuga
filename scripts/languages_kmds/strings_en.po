msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "还不太像个「鸦年华」。"
msgstr "It does not yet look like a \"Crow-nival\"."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "听小鸟说，该再添些装饰。"
msgstr "Small bird intelligence. ...More decoration is due."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "树成了，该庆祝一下。"
msgstr "The tree, complete. ...Time to celebrate."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "鸟喜欢树。据说是这样。"
msgstr "Birds like trees. ...So science has proven."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "看上那个奖品了。"
msgstr "A prize in my sights. ...That one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "真正的奖品，路上再做。"
msgstr "Real prizes. ...Made along the way."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "券。没错。"
msgstr "Tickets, the right answer!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "券，很多张。"
msgstr "Tickets, a great many!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "券，好几张。"
msgstr "Tickets, several!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "有点饿了。"
msgstr "Somewhat hungry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_VEST_A"
msgid "像个走江湖的。"
msgstr "It resembles an adventurer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_VEST_B"
msgid "把阴凉带在身上。"
msgstr "Shade, carried with me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARNIVAL_VEST_C"
msgid "只要虫子进不来就好。"
msgstr "So long as no bugs get in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "月色玻璃的刃，很锋利。好刃。"
msgstr "A moon glass blade. ...Sharp. ...A fine blade."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "再做不出家具了。"
msgstr "No more furniture."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "做家具的台子。"
msgstr "A furniture-making machine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.DEAD"
msgid "结束了。"
msgstr "It is over."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.GENERIC"
msgid "长了脚的胡萝卜？"
msgstr "A carrot, with legs?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.HELD"
msgid "近看不好看。"
msgstr "Up close, it is ugly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT.SLEEPING"
msgid "有点可爱。"
msgstr "Somewhat cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARRAT_GHOSTRACER"
msgid "有点发凉。"
msgstr "Somewhat eerie."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT"
msgid "从土里长出来的。有点苦。"
msgstr "Out of the soil. ...Bitter."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_COOKED"
msgid "软了。"
msgstr "Soft."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_OVERSIZED"
msgid "好大一把胡萝卜！"
msgstr "A great bundle of carrots!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_PLANTED"
msgid "土里在育苗。"
msgstr "The soil is raising seedlings."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARROT_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "糟了。"
msgstr "Not good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "只剩灰了。"
msgstr "Only ash remains."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "能分享地图。"
msgstr "Maps, shared."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOON"
msgid "淘气的猫。"
msgstr "A mischievous cat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOONDEN.EMPTY"
msgid "主人不在了。"
msgstr "The owner is gone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOONDEN.GENERIC"
msgid "树桩做的窝。"
msgstr "A den in a stump."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CATCOONHAT"
msgid "带耳朵的帽子。可爱。"
msgstr "An ear hat. ...Cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CATTOY_MOUSE"
msgid "带轮子的老鼠，手艺没有尽头。"
msgstr "A mouse with wheels. ...Science has no limits."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "能举起来。"
msgstr "It can be lifted."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "够不到。"
msgstr "Out of reach."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA"
msgid "软。"
msgstr "Soft."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA_BURNT"
msgid "不是我烧的。"
msgstr "Not me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA_COOKED"
msgid "好吃。"
msgstr "Tasty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_BANANA_TREE"
msgid "香蕉树。洞穴的版本。"
msgstr "A banana tree. ...The cave edition."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE"
msgid "这石头搬得开吗。"
msgstr "Could the boulder be shifted? ...Tempting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "满了。只能等。"
msgstr "Full. ...It must wait."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "大地不让我下去。"
msgstr "The earth itself refuses."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "下面有东西。去看看。"
msgstr "Something below. ...A risk."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "下面藏着什么。"
msgstr "It hides something."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_EXIT.FULL"
msgid "地面上太挤。"
msgstr "The surface is too crowded."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "就待在下面吧。"
msgstr "It stays below."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_EXIT.OPEN"
msgid "探险够了。"
msgstr "Exploration enough."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_FERN"
msgid "蕨。"
msgstr "A fern."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_FERN_WITHERED"
msgid "枯了的草。"
msgstr "A withered fern."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "气用尽了！"
msgstr "Out of gas!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "这是什么？"
msgstr "What is this?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "小心，会醒。"
msgstr "Careful. ...It will wake."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "气冲冲地往外喷！"
msgstr "Venting its rage!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "在往外出气。"
msgstr "Venting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "通风口……不知通往哪。"
msgstr "A vent. ...Direction, unknown."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "越来越热。"
msgstr "Growing hot."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "有毒的气。"
msgstr "Miasma, indeed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CEILING_ROPE"
msgid "往上爬的绳。"
msgstr "A climbing rope."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CEVICHE"
msgid "换个大点的碗……可以吗？"
msgstr "A slightly bigger bowl. ...Might do?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARCOAL"
msgid "小小的黑块。有烧木头的味道。"
msgstr "Small and black. ...It smells of burnt wood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_HAND"
msgid "想要不祥的东西。"
msgstr "It wants an ominous thing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_HECKLER"
msgid "专为搅局而来。"
msgstr "Intent on disruption."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_LECTURN"
msgid "谁在演戏？"
msgstr "Who is performing?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_NPC"
msgid "等等，那是？"
msgstr "Wait, wait. ...That is?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHARLIE_STAGE_POST"
msgid "像个圈套，处处是演出的痕迹。"
msgstr "A sense of a snare. ...Strong traces of a performance."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSJUNK1"
msgid "一堆碎棋子。"
msgstr "A heap of broken chess."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSJUNK2"
msgid "又是一堆。"
msgstr "Another heap."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSJUNK3"
msgid "碎棋子更多了。"
msgstr "More broken chess."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "看起来就重。"
msgstr "Heavy just to look at."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ANTLION"
msgid "停住的蚁狮。"
msgstr "A stilled antlion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEARGER"
msgid "实物要更大。印象很深。"
msgstr "The real one is bigger. ...An impression."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "比本尊还容易发火。"
msgstr "Even shorter of temper than the original."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "结实的雕塑。"
msgstr "A robust sculpture."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "雕像很庄严。"
msgstr "A solemn statue."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "石头做的主教。"
msgstr "A stone bishop."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "棋子自己动了。"
msgstr "The chess piece moved of its own accord."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "漂亮。……应该算漂亮。"
msgstr "Lovely. ...Surely."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CARRAT"
msgid "优胜者。"
msgstr "The champion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CATCOON"
msgid "猫会过来磨爪子。"
msgstr "The cats will come to sharpen their claws."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "陶做的狗。只有一个头，放心。"
msgstr "A clay hound. ...At least the head is a relief."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "到最后也没吃上。"
msgstr "Its appetite went unfed, in the end."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_CRABKING"
msgid "比麦斯威尔温和些。"
msgstr "Less violent than Maxwell."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "不知去了何处。"
msgstr "Gone, to who knows where."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "放在废品堆里也行。"
msgstr "Fit for the scrap heap."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "那只眼一直跟着人。"
msgstr "The eye follows one about."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "看着就碍眼的雕塑。"
msgstr "An eyesore of a sculpture."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "虫，果然是。"
msgstr "A worm. ...As I thought."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "让人想起些事。不太好的事。"
msgstr "A memory. ...The bad kind."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "石头也在盯着人。"
msgstr "A stone stare."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_FORMAL"
msgid "不太像个王。"
msgstr "It does not resemble a king."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "这样反倒更好。"
msgstr "Better this way."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "看着就饿了。"
msgstr "Looking at it, my stomach growled."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KITCOON"
msgid "这个好找。"
msgstr "This one is easy to find."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KLAUS"
msgid "没有装饰的克劳斯。想要一个。"
msgstr "Klaus, \"undecorated\". ...I want one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "马。石头做的。"
msgstr "A knight. ...In stone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "棋子自己动了。"
msgstr "The chess piece moved of its own accord."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "只要不来袭击，倒也还好。"
msgstr "So long as it does not attack, all is well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "想抱一下。是石头做的。"
msgstr "I want to hold it. ...But stone chafes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "这回换你不动了。"
msgstr "This time, you are the one frozen."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MOON"
msgid "最近有些灵感。"
msgstr "Ideas have come to me of late."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "做得跟活的一样。不错。"
msgstr "Lifelike. ...Mm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_MUSE"
msgid "嗯，在哪里见过？"
msgstr "Mm... have I seen it? ...Where."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_PAWN"
msgid "卒。我懂它。"
msgstr "A pawn. ...I know the feeling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_PIPE"
msgid "烟斗。我不抽。"
msgstr "A pipe. ...I do not smoke."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "比看起来更重。"
msgstr "Heavier than it looks."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "棋子自己动了。"
msgstr "The chess piece moved of its own accord."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "背上有鳍的那种感觉。"
msgstr "It has the feel of a fin."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_STALKER"
msgid "骸骨，规规矩矩地不动。"
msgstr "A skeleton, properly still."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "当凳子？不太合适。"
msgstr "A stool? ...No. Unfitting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "那一晚的对视，最难受。"
msgstr "That night, the worst meeting of eyes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "身高差了些。"
msgstr "Falls short in height."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "月亮之上。那种心情。"
msgstr "Above the moon. ...In spirit."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "设计不错。做出来就一般。"
msgstr "Fine design. ...The execution, questionable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "只差一口吐息。"
msgstr "Lacking only the howl."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "现在想起来还发抖。"
msgstr "I am still trembling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_YOTD"
msgid "只看着，心就跳快了。"
msgstr "Just looking. ...My heartbeat quickens."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_YOTH"
msgid "吃苦的骑士。"
msgstr "The bitter knights."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESSPIECE_YOTS"
msgid "对钱财，我一向远着。原则。"
msgstr "Greed, keep away. ...A principle of mine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTER"
msgid "切斯特。会走的毛球箱子。"
msgstr "Chester. ...A chest of fluff."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "在看着我。"
msgstr "It is watching me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "睡了。"
msgstr "It sleeps."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "物理法则意外地好说话。"
msgstr "The laws of physics, surprisingly flexible."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "大意了。记住这个形状。"
msgstr "Careless of me. ...I'll remember that shape."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHIPS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHIPS"
msgid "点心。偶尔的奢侈，可以原谅。多谢款待。"
msgstr "A snack. ...An occasional indulgence can be forgiven. Thanks for the treat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CHUM"
msgid "鱼饵！"
msgstr "Fish bait!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYHOUND.GENERIC"
msgid "放出来了！"
msgstr "It charged!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYHOUND.STATUE"
msgid "像真的一样。"
msgstr "It resembles the real one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYWARG.GENERIC"
msgid "陶做的怪物！"
msgstr "A clay monster!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CLAYWARG.STATUE"
msgid "动了？"
msgstr "Did it move?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.EMBERS"
msgid "快灭了。加些柴。"
msgstr "Nearly out. ...More wood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.GENERIC"
msgid "比黑暗好。"
msgstr "Better than the dark."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.HIGH"
msgid "火太大了。"
msgstr "The fire is excessive."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.LOW"
msgid "火小了。"
msgstr "The fire is low."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.NORMAL"
msgid "正合适。"
msgstr "Just right."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIRE.OUT"
msgid "结束了。"
msgstr "Over."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "快灭了。添些柴。"
msgstr "Nearly out. ...Add more."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "比黑暗好。"
msgstr "Better than the dark."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.HIGH"
msgid "有石头拦着，放心些。"
msgstr "Good, to have a rim."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.LOW"
msgid "火小了。"
msgstr "The fire is low."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "正合适。"
msgstr "Just right."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLDFIREPIT.OUT"
msgid "还能再点起来。"
msgstr "It can be lit again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COLLAPSEDCHEST"
msgid "物理法则被弯过去了。"
msgstr "The laws of physics, bent."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.E"
msgid "东。"
msgstr "East."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.GENERIC"
msgid "朝哪边。"
msgstr "Which way?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.N"
msgid "北。"
msgstr "North."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.NE"
msgid "东北。"
msgstr "Northeast."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.NW"
msgid "西北。"
msgstr "Northwest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.S"
msgid "南。"
msgstr "South."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.SE"
msgid "东南。"
msgstr "Southeast."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.SW"
msgid "西南。"
msgstr "Southwest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPASS.W"
msgid "西。"
msgstr "West."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOST"
msgid "给植物的养料。仅此而已。"
msgstr "Plant feed. ...Nothing more."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "正好！"
msgstr "Just right!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "还能更臭，没想到。"
msgstr "It can stink worse. ...Unexpected."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "唔，太干。"
msgstr "Mm. ...Too dry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "臭到头了。"
msgstr "The stench. ...At my limit."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTINGBIN.WET"
msgid "太湿。"
msgstr "Too wet."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COMPOSTWRAP"
msgid "沃姆伍德劝我吃。我谢过了。"
msgstr "Wormwood urged me to eat it. ...I declined."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CONSTRUCTION_PLANS"
msgid "设计图。有用。"
msgstr "Blueprints. ...Useful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKBOOK"
msgid "料理的学问。看着就饿。"
msgstr "Cooking knowledge. ...Now I am hungry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDMANDRAKE"
msgid "可怜的家伙。"
msgstr "Poor creature."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDMEAT"
msgid "烤得正好。"
msgstr "Roasted to perfection."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDMONSTERMEAT"
msgid "比生的好一点。"
msgstr "A little better than raw."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKEDSMALLMEAT"
msgid "不用担心寄生虫了。"
msgstr "No more worry of parasites."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKIECUTTER"
msgid "它盯着我的船，不安。"
msgstr "It eyes my boat. Uneasy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKIECUTTERHAT"
msgid "至少头发是干的。"
msgstr "At least my hair stays dry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKIECUTTERSHELL"
msgid "只剩壳。"
msgstr "Only the shell remains."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "字迹认不出来。"
msgstr "The handwriting cannot be read."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.BURNT"
msgid "锅自己被煮了。"
msgstr "The pot itself was cooked."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "还要一会。"
msgstr "It will take a while."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "快好了。"
msgstr "Nearly done."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.DONE"
msgid "好了。……吃吧。"
msgstr "Done. ...Eat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOKPOT.EMPTY"
msgid "看着就饿。"
msgstr "It looks hungry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COOLANT"
msgid "在冒泡，门道不少。"
msgstr "It fizzes. ...Full of possibility."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COONTAIL"
msgid "还在摇。"
msgstr "Still swishing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN"
msgid "糖分很高。"
msgstr "High in sugar."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN_COOKED"
msgid "烤过也一样甜。"
msgstr "Roasted, and still sugary."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN_OVERSIZED"
msgid "玉米，穗很大。"
msgstr "A corn ear. ...Large."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CORN_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "铁匠的衣裳。"
msgstr "A blacksmith's costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_DOLL_BODY"
msgid "人偶的衣裳。"
msgstr "A doll's costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_FOOL_BODY"
msgid "愚者的衣裳。"
msgstr "A fool's costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_KING_BODY"
msgid "国王的衣裳。"
msgstr "A king's costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "一套衣裳。"
msgstr "A costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "有人反对，不理。"
msgstr "Dissenters. ...Ignore them."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "女王的衣裳。"
msgstr "A queen's costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COSTUME_TREE_BODY"
msgid "树的衣裳。"
msgstr "A tree costume."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "缺燃料。"
msgstr "It wants fuel."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "有光，安心些。"
msgstr "A reassuring light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "缺燃料。"
msgstr "It wants fuel."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "让人起敬的像。"
msgstr "An admirable statue."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "缺燃料。"
msgstr "It wants fuel."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "能一直看着。一直……"
msgstr "It can gaze forever. ...Forever..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COTL_TRINKET"
msgid "王冠的成果。"
msgstr "The crown's achievement."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.COZY_BUNNYMAN"
msgid "又暖又舒服。"
msgstr "Warm, and comfortable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING.GENERIC"
msgid "蟹王，不好惹。"
msgstr "The Crab King. ...Not to be trifled with."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING.INERT"
msgid "城里也该有个像样的摆设。"
msgstr "A castle needs decoration."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_CANNONTOWER"
msgid "炮台，果然有。"
msgstr "A gun turret. ...There it is, after all."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_CLAW"
msgid "那对钳子很危险。"
msgstr "Dangerous pincers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_ICEWALL"
msgid "我和它之间的事。"
msgstr "Between me and the crab. ...A problem."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_MOB"
msgid "横着走的家伙，脾气不好。"
msgstr "An ill-tempered crab."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "壳很硬，不好对付。"
msgstr "A hard shell. ...A strong foe."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTERLAB"
msgid "里面有什么。"
msgstr "There is something inside."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_BULBIN"
msgid "不会做坏事。……大概。"
msgstr "It does no wrong. ...Probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_DRAGONLING"
msgid "小龙。心都被它占去了。"
msgstr "A small dragon. ...It has claimed my heart."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_EETS"
msgid "在看。看人。"
msgstr "It watches. ...People."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "眼睛多些，也安心。就一只。"
msgstr "Many eyes. ...Reassuring. ...At least one of them."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_GLOMLING"
msgid "会飞的小东西。"
msgstr "A creature of aerodynamics."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_KITTEN"
msgid "当助手够格了。"
msgstr "A qualified assistant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_LAMB"
msgid "比母亲少些黏液。"
msgstr "Less slime than its mother."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "月之蛾。会发光，很好。"
msgstr "A lunar moth. ...Glowing is good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_PERDLING"
msgid "长羽毛的朋友。"
msgstr "A feathered friend."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRITTER_PUPPY"
msgid "小怪物，可爱。"
msgstr "A small beast. Cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CROW.GENERIC"
msgid "不吉利。"
msgstr "Ill omens."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CROW.HELD"
msgid "关在里面不开心。"
msgstr "Unhappy inside."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CRUMBS"
msgid "想用碎屑藏踪迹，太笨。"
msgstr "The crumbs hide poorly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "看着无害。"
msgstr "It looks harmless."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTGRASS"
msgid "切好的草。做手工用。"
msgstr "Cut grass. ...For crafts."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTLESS"
msgid "不算锋利，木刺还多。"
msgstr "Not sharp. ...Many splinters."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTLICHEN"
msgid "有营养。放不住。"
msgstr "Nourishing. ...It will not keep."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTREEDS"
msgid "切好的苇。"
msgstr "Cut reeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.CUTSTONE"
msgid "很平滑的石头。"
msgstr "Smooth. ...Stone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER.GENERIC"
msgid "把他放出来……也许失策。"
msgstr "Letting him out. ...Perhaps a misstep."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "有一点同情。"
msgstr "Sympathy. ...In trace amounts."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER2.BURIED"
msgid "被压在垃圾底下。"
msgstr "Trapped beneath the refuse."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER2.GENERIC"
msgid "别惹恼他。"
msgstr "Do not anger it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "像是气着了。"
msgstr "It looks angry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "硬得出奇的柱子。"
msgstr "An abnormally hard pillar."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "大理石里，有发光的东西。"
msgstr "Within the marble. ...A glowing thing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEADLYFEAST"
msgid "含着猛毒的料理。"
msgstr "A dish of deadly poison."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEAD_SEA_BONES"
msgid "上岸的代价。"
msgstr "The price of coming ashore."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "在浪费木头。"
msgstr "Such a waste of wood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "本来是能拦住的……"
msgstr "This could have been prevented..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "对不住这片林子。"
msgstr "My apologies, nature."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "叶子很多。平常的树。"
msgstr "Many leaves. ...Ordinary."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "橡子被拿走了。它生气了。"
msgstr "The acorns were stolen. ...Rage, rising."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECK_OF_CARDS"
msgid "牌齐吗？"
msgstr "The deck, complete?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_CENTERPIECE"
msgid "做得精细。"
msgstr "Exquisite."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "花瓶。空着。"
msgstr "A vase. ...Without flowers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "小小的光，很好。"
msgstr "A small light. ...Good to have."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "花瓶。花在里面。"
msgstr "A vase. ...With flowers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "麦斯威尔，催过换灯了。"
msgstr "Maxwell. ...He urged a bulb change."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "不新鲜了。"
msgstr "No longer fresh."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_LAMP"
msgid "把光引进屋里。"
msgstr "Light, welcomed in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "很美。"
msgstr "Beautiful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "该画点什么。"
msgstr "Something should be drawn."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "好看。"
msgstr "Fine looking."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER.ANTLER"
msgid "那对角很气派。"
msgstr "A splendid set of antlers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER.GENERIC"
msgid "在盯着我？不。"
msgstr "Is it staring? ...No."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPS"
msgid "好大！独眼。"
msgstr "Huge! ...One-eyed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "再小心也不多余。"
msgstr "One cannot be too careful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "结束了……对吧？"
msgstr "It is over. ...Is it not?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "眼前这事，不愿相信。"
msgstr "I would rather not believe my eyes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "结着冰的目光。如何？"
msgstr "A gaze of ice. ...How about it?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "谁掉了眼睛？"
msgstr "Who dropped an eye?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "都退开些，这活我熟。"
msgstr "Everyone stand back. ...I am the expert."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "实在恶心。"
msgstr "Genuinely sickening."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER_ANTLER"
msgid "本来会自己掉吗。"
msgstr "Would it have shed on its own?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEER_GEMMED"
msgid "被操纵的野兽。"
msgstr "Puppeted. ...By that beast."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "大概是草丛。"
msgstr "Grass, probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DESERTHAT"
msgid "护眼很好。"
msgstr "Kind to the eyes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DESICCANT"
msgid "干了还要更干！"
msgstr "Dried, and dried again!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DESICCANTBOOSTED"
msgid "彻底干透。"
msgstr "Completely dry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEVTOOL"
msgid "培根的味道。"
msgstr "Bacon-scented."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DEVTOOL_NODEV"
msgid "拿不动。力气不够。"
msgstr "It cannot be lifted. ...Strength falls short."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIRTPILE"
msgid "一堆土。……只是土吗。"
msgstr "A mound of dirt. ...Is it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.COLD"
msgid "信号很弱。"
msgstr "The signal is weak."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.GENERIC"
msgid "探知用的机器。"
msgstr "A divining device."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.HOT"
msgid "反应很激烈。"
msgstr "A violent reaction."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.WARM"
msgid "方向对了。"
msgstr "The direction is right."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGROD.WARMER"
msgid "很近了。"
msgstr "Very close now."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "这是做什么用的。"
msgstr "What is it for."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODBASE.READY"
msgid "要一把大钥匙。"
msgstr "It wants the large key."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "机器能动了。"
msgstr "The machine can move."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DIVININGRODSTART"
msgid "那根棒子有用。"
msgstr "That rod is useful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DOCK_KIT"
msgid "搭码头的一套料。"
msgstr "Dock materials, all in one set."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "哦！缺的正是这个。"
msgstr "Oh! ...This is what was missing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DOLL_BLUEPRINT"
msgid "我的牛，要打扮得可爱些。"
msgstr "My beefalo. ...A cute plan."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONBOAT_KIT"
msgid "别拖了，快搭起来。"
msgstr "No more dawdling. ...Build it quickly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONBOAT_PACK"
msgid "造船省事多了！"
msgstr "Boat-building, simplified!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONBODYHAT"
msgid "我当中间。"
msgstr "I take the middle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONCHILISALAD"
msgid "但愿这股火能忍住。"
msgstr "I hope the spice is bearable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLY"
msgid "龙一样的蝇。带着火。"
msgstr "A dragonfly. ...Fire."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "第二个箱子。安全。"
msgstr "A second chest. ...Safe."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "容量不太正常。"
msgstr "An abnormal capacity."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "热得多，光却少。"
msgstr "Much heat. ...Little light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "坏掉的样子。"
msgstr "It looks broken."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "烫！"
msgstr "Hot!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "在眨眼吗。"
msgstr "Is it blinking?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT"
msgid "奇怪的果子。"
msgstr "A strange fruit."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "还是很奇怪。"
msgstr "Still strange."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "长出翅膀，也不奇怪。"
msgstr "It would not surprise me if it grew wings."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONHEADHAT"
msgid "谁当头。"
msgstr "Who takes the head?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONPIE"
msgid "火龙果派。很饱。"
msgstr "Dragonpie. ...Filling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGONTAILHAT"
msgid "当尾巴的人。"
msgstr "The one assigned the tail."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRAGON_SCALES"
msgid "还是温的。"
msgstr "Still warm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DREADSTONE"
msgid "不是光，是影在反照。"
msgstr "Not light. ...Shadow, reflected."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DREADSTONEHAT"
msgid "护住脑袋要紧。"
msgstr "Precious brain protection."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DREADSTONE_STACK"
msgid "从深处冒出来的。"
msgstr "It wells up from the bottom of the abyss."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_LOG"
msgid "浮在水上。"
msgstr "It floats on water."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "浮木在烧！"
msgstr "Driftwood, burning!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "没用了。"
msgstr "No use left in it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "挖一挖，还有能用的。"
msgstr "Something worth digging remains."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "岸边漂来的枯木。"
msgstr "Deadwood, drifted ashore."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRUMSTICK"
msgid "鸡腿。开吃。"
msgstr "A drumstick. ...I dig in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DRUMSTICK_COOKED"
msgid "更好吃了。"
msgstr "Even tastier."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_BANANABUSH"
msgid "香蕉丛。甜味太重。"
msgstr "A banana bush. ...Overly fragrant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_BERRYBUSH"
msgid "能带走了。"
msgstr "It can be carried off now."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "种在家附近。"
msgstr "Plant it near home."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_GRASS"
msgid "哪里都能种。"
msgstr "It will grow anywhere."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_MARSH_BUSH"
msgid "得种下去。"
msgstr "It should be planted."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_MONKEYTAIL"
msgid "能吃？得试试。"
msgstr "Edible? ...Experimentation required."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_SAPLING"
msgid "得种下去。"
msgstr "It should be planted."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUG_TRAP_STARFISH"
msgid "这次骗不到我。"
msgstr "It will not fool me today."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL"
msgid "重活，靠脑子。"
msgstr "Heavy labor. ...For the brain."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "再凉不过了。"
msgstr "Cooler than this. ...Impossible."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_GEM"
msgid "把这重量压下去。啊！腰！！"
msgstr "This weight, conquered. ...Argh! My back!!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_GOLDEN"
msgid "跟金子一样贵。"
msgstr "Of equal value in gold."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_HEAT"
msgid "拿来热身。"
msgstr "For warming up."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_MARBLE"
msgid "脑子，才是最强的一块肌肉。"
msgstr "The brain. ...Trained into the strongest muscle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUMBBELL_REDGEM"
msgid "有股烧的感觉。"
msgstr "A burning feel."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN"
msgid "臭。"
msgstr "Rank."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN_COOKED"
msgid "更臭了。"
msgstr "Ranker still."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN_OVERSIZED"
msgid "更大的臭味，在等着。"
msgstr "A greater stench. ...Scheduled."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DURIAN_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUSTMERINGUE"
msgid "这是谁吃的？"
msgstr "Who eats this?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUSTMOTH"
msgid "尘土里的虫，爱干净。"
msgstr "A dust moth. ...Fond of cleanliness."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.DUSTMOTHDEN"
msgid "里面看着挺舒服。"
msgstr "Comfortable within, it seems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EARMUFFSHAT"
msgid "耳朵暖了。……心也暖些。大概。"
msgstr "Warm ears. ...And heart. ...Probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EEL"
msgid "鳗鱼。好吃。"
msgstr "An eel. ...Tasty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EEL_COOKED"
msgid "香。"
msgstr "Fragrant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT"
msgid "不太像蛋。"
msgstr "It resembles no egg."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT_COOKED"
msgid "更不像了。"
msgstr "Even less so."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "还是没见到蛋。只是名字像。"
msgstr "It resembles an egg. ...Still, I see none."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EGGPLANT_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ELIXIR_CONTAINER"
msgid "不是篮子，是丧事人家的袋。"
msgstr "Not a basket. ...A mortician's bag."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EMBERLIGHT"
msgid "不用燃料的火？也无妨。"
msgstr "Fire without fuel? ...No problem."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.BURNT"
msgid "瓶子和桌子都烧了。"
msgstr "A burnt bottle, a burnt table."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.EMPTY"
msgid "该放点什么。"
msgstr "Set something on it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "小小的灯。很好。"
msgstr "A small lamp. ...Good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.GENERIC"
msgid "带花瓶的桌子。"
msgstr "A vase, a table."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "灯该换了吗。"
msgstr "Has the bulb been changed?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ENDTABLE.WILTED"
msgid "不新鲜了。"
msgstr "No longer fresh."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.BURNING"
msgid "在浪费木头。"
msgstr "Such a waste of wood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.BURNT"
msgid "本来是能拦住的……"
msgstr "This could have been prevented..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.CHOPPED"
msgid "对不住这片林子。"
msgstr "My apologies, nature."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN.GENERIC"
msgid "松树。"
msgstr "A pine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "在浪费木头。"
msgstr "Such a waste of wood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "本来是能拦住的……"
msgstr "This could have been prevented..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "对不住这片林子。"
msgstr "My apologies, nature."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "可怜的树。……没有球果。"
msgstr "A pitiful tree. ...No cones."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEBRELLAHAT"
msgid "它在守护戴着它的人。"
msgstr "It watches over its wearer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEMASKHAT"
msgid "眼力还是有的。"
msgstr "An aesthetic eye. ...I have one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEOFTERROR"
msgid "眼睛来了！"
msgstr "An eye attacks!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEOFTERROR_MINI"
msgid "被看着，不自在。"
msgstr "Being watched. ...Unsettling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "像是快孵出来了。"
msgstr "It looks close to hatching."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYEPLANT"
msgid "被盯着。"
msgstr "I am being watched."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYETURRET"
msgid "别对准我。"
msgstr "Do not aim that at me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.EYETURRET_ITEM"
msgid "睡着了。"
msgstr "Asleep."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.BURNT"
msgid "灰里长不出东西。"
msgstr "Nothing grows in ash."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.GENERIC"
msgid "种点什么吧。"
msgstr "Plant something."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.GROWING"
msgid "在长。"
msgstr "Growing, growing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "要施肥。"
msgstr "It wants fertilizer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_HOE"
msgid "把土整松，种子会舒服。"
msgstr "The soil. ...Made comfortable for seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.BURNING"
msgid "这对植物不好。"
msgstr "Not good for the plant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.FULL"
msgid "用心照料，该收了。"
msgstr "Time for a careful harvest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "费了功夫，长成这么大一个。"
msgstr "The power of science. ...A monster-class crop, complete."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "冒牌的，终于露了馅。"
msgstr "An impostor. ...Finally exposed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.GENERIC"
msgid "植物！"
msgstr "A plant!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.GROWING"
msgid "我种的，长大了！"
msgstr "My work. ...Growing!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "失败了！早点采就好。"
msgstr "Failed! ...I should have picked sooner."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "烂了，可惜。"
msgstr "Rotted. A waste."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLANT.SEED"
msgid "然后就是等。"
msgstr "Now, we wait."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLOW"
msgid "翻土很省力。"
msgstr "A convenient plow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_PLOW_ITEM"
msgid "先找块地。"
msgstr "First, find a place for the garden."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "地里乱了。"
msgstr "The garden has grown messy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHERFAN"
msgid "羽毛扇。能降温。"
msgstr "A feather fan. ...It cools."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHERHAT"
msgid "像只鸟了。"
msgstr "I have become a bird!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHERPENCIL"
msgid "羽毛笔。字很清楚。"
msgstr "A quill. ...The letters come out clean."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_CANARY"
msgid "金丝雀的羽毛。"
msgstr "A canary's feather."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_CROW"
msgid "黑鸟的羽毛。"
msgstr "A black bird's feather."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_ROBIN"
msgid "红鸟的羽毛。"
msgstr "A red bird's feather."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "雪鸟的羽毛。"
msgstr "A snow bird's feather."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FEM_PUPPET"
msgid "她被困住了！"
msgstr "She is trapped!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE"
msgid "木栅栏。"
msgstr "A wooden fence."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "单独一个不动。"
msgstr "Alone, it does nothing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "哦，接上了。"
msgstr "Oh, it is connected."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "不是树，也得种下去。"
msgstr "Not a tree. ...But it needs planting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_GATE"
msgid "能开。也有关上的时候。"
msgstr "Open. ...There are times it closes, too."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_GATE_ITEM"
msgid "够建一扇结实的门。"
msgstr "Builds into a sturdy gate."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ITEM"
msgid "够建一段结实的栅栏。"
msgstr "Builds into a sturdy fence."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_JUNK"
msgid "说它丑我也不恼。废铁围的。"
msgstr "Called ugly, I take no offense. ...A junk fence."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FENCE_ROTATOR"
msgid "守好！栅栏重新摆一遍！"
msgstr "Defense! ...The fence, reset!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FERTILIZER"
msgid "一桶肥。确实。"
msgstr "A bucket of droppings. ...Certain."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FESTIVEFISH"
msgid "尝一口季节的鱼。"
