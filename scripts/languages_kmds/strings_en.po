msgstr "She is opening her heart."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "今天精神很好。……姐姐也放心了吧。"
msgstr "In good spirits today. ...Elder sister."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "看着它，心会痛。"
msgstr "Looking at it pains the heart."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "花，不对劲了。"
msgstr "Something is wrong with the flower."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "快了。当心。"
msgstr "Soon. ...Take care."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "没什么新意。"
msgstr "No originality."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "只是雕像，幸好。"
msgstr "Only statues. ...Thankfully."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "这里，被引力管着。我也一样。"
msgstr "This place. ...Gravity rules. ...And me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "用它。让世界知道。"
msgstr "Use it. ...Let the world know."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ACORN"
msgid "里面一定有东西。"
msgstr "There is definitely something inside."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ACORN_COOKED"
msgid "烤得正好。"
msgstr "Roasted just right."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ACORN_SAPLING"
msgid "很快就成树了。"
msgstr "Nearly a tree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ADVENTURE_PORTAL"
msgid "第二次可不上当。"
msgstr "I will not be fooled twice."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIANHAT"
msgid "无穷的门路，看得见了。"
msgstr "Infinite possibility. ...Visible."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "一片也，还亮着。"
msgstr "Even one shard. ...It shines."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "怪物的力，正被抽出来！"
msgstr "The monster's energy. ...Being drawn out!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "抓到了。"
msgstr "Caught it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "破坏这般本事，总要付代价。"
msgstr "Destructive science. ...There is a price."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "和你像。又不同。"
msgstr "It resembles you. ...But different."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "他要的应该是这个。"
msgstr "What he wants. ...Surely this."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "这次确实倒了。"
msgstr "This time, certainly down."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "好像被我惹恼了。"
msgstr "It seems I have enraged it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "你的意思，我懂了。"
msgstr "Your meaning. ...Understood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "彻底恼了！"
msgstr "Fully enraged!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "谁去碰一下，确认看看。"
msgstr "Someone give it a poke. ...To be sure."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "死了？奇怪的力。还留着。"
msgstr "Dead? ...Strange energy. ...It lingers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "试过之后，只想睡。"
msgstr "The test results. ...I want to sleep."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "都砸坏了，还不够？！"
msgstr "Science, destroyed. ...Still not enough?!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.AMULET"
msgid "戴着安心。"
msgstr "Wearing it eases the mind."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCHOR"
msgid "免得船漂走。"
msgstr "It keeps the boat from drifting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCHOR_ITEM"
msgid "能做个锚。"
msgstr "An anchor can be made."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "刚采下，还热着。"
msgstr "Just picked, and still warm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "在抽动，少些才好。"
msgstr "It twitches. ...Less would be better."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "至少不动了。"
msgstr "At least it stopped twitching."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "既是草木，又是石。有趣。"
msgstr "Plant, and mineral. ...Ingenious."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "被挖空了。"
msgstr "Mined out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "这树，要小心待它。"
msgstr "A tree. ...Handle with care."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "树桩。"
msgstr "A tree stump."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "在长！……大概？"
msgstr "Growing! ...Probably?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "地方对了，时候未到。"
msgstr "Suitable. ...But the moment has not come."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "养分不够。"
msgstr "It seems short on nutrients."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "得找个合适的地方种。"
msgstr "It needs planting in a suitable place."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENTTREE_SEED"
msgid "不觉意外，只是所知太少。"
msgstr "Unexpectedly ordinary. ...Only, the data is lacking."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_ALTAR"
msgid "古代的祭坛。神秘。"
msgstr "An ancient, mystic altar."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "坏了。"
msgstr "Broken."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_HUSK"
msgid "这里出过坏事。"
msgstr "Something bad happened here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANCIENT_STATUE"
msgid "它在动。和这世界的节奏不同。"
msgstr "It moves. ...To a rhythm unlike this world's."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANIMAL_TRACK"
msgid "食物的踪迹。有动物。"
msgstr "Tracks of food. ...An animal's."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTCHOVIES"
msgid "能放回去吗。"
msgstr "May I put them back?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLION.GENERIC"
msgid "你想要什么。……说吧，可以交换。"
msgstr "What is it you want. ...Speak. I will trade."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLION.UNHAPPY"
msgid "它在生气。地要陷了。"
msgstr "It is angry. ...Sinkholes are dangerous."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLION.VERYHAPPY"
msgid "关系还算和睦。安全。"
msgstr "On good terms. ...Safe."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLIONHAT"
msgid "隔热的帽子。厉害。"
msgstr "A heat-proof hat. ...Impressive."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ANTLIONTRINKET"
msgid "小玩具。有人会想要。"
msgstr "A small trinket. ...Someone will want it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARAMASA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARAMASA"
msgid "神代之器的仿作。八连之技，不可轻慢。"
msgstr "An imitation of a divine-age relic. An eightfold technique, not to be taken lightly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "多足的虫，拦不住。"
msgstr "A centipede. ...It will not stop me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "一堆旧零件。"
msgstr "A heap of old parts."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "锅被烧了。"
msgstr "The pot was burned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "还要些时候。"
msgstr "It takes time."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "快好了！"
msgstr "Nearly ready!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "唔！能吃了！"
msgstr "Mm! ...Edible!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "旧锅，先擦干净。"
msgstr "An old pot. ...It needs cleaning."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "学问，怎么取出来。"
msgstr "Knowledge. ...How to draw it out?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "站在旁边，很想说两句。"
msgstr "Standing beside it. ...A strong urge to make small talk."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "要是有办法让它再动就好了。"
msgstr "A way to run it again. ...If only there were."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "月亮的像，很壮。有些动心。"
msgstr "A moon statue. ...Magnificent. ...My heart stirs."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "像是故意让人听不懂。"
msgstr "Deliberately cryptic. ...It seems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "奇怪，有电，却不动。"
msgstr "Strange. ...It has power, but will not move."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "彻底死了。"
msgstr "Completely dead."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "不看图，偏要用这么复杂的机器。想不通。"
msgstr "Without a map. ...Using a complex machine. ...A mystery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "该找的，都找完了。"
msgstr "What should be found. ...All of it, discovered."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "哦！把秘密的学问拿来用。像见过。"
msgstr "Oh! ...Secret knowledge, applied. ...A sense of deja vu."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "写了不少……可惜我读不懂。"
msgstr "Much knowledge. ...A pity I cannot read it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "这些记号，和遗迹里的不一样。"
msgstr "The marks. ...Different from the other ruins."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "写了不少……可惜我读不懂。"
msgstr "Much knowledge. ...A pity I cannot read it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "这些记号，和遗迹里的不一样。"
msgstr "The marks. ...Different from the other ruins."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "写了不少……可惜我读不懂。"
msgstr "Much knowledge. ...A pity I cannot read it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "有种被接待的感觉。"
msgstr "A sense of reception."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "从前做什么用的。现在不动了。"
msgstr "What it once did. ...Now, motionless."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "去哪里？有意思的地方？"
msgstr "Where does it go? ...Somewhere interesting?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "槽是空的。"
msgstr "The slot is empty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "宝石，就是动力。……大概算学问。"
msgstr "Gems. ...Power. ...Science, probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORDRAGONFLY"
msgid "耐热的甲。"
msgstr "Hot armor."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORDREADSTONE"
msgid "轻巧又结实。好看。"
msgstr "Light, and sturdy. ...Fine looking."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORGRASS"
msgid "草编的甲。别夹着虫子。"
msgstr "Grass armor. ...There will be bugs in it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORMARBLE"
msgid "看着就重。"
msgstr "Heavy just to look at."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORRUINS"
msgid "很轻。不可思议。"
msgstr "Light. ...Uncanny."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORSKELETON"
msgid "骸骨做的铠甲。冷。"
msgstr "Armor of bone. ...Cold."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORSLURPER"
msgid "湿透的一套。倒是有营养。"
msgstr "A wet suit. ...Nourishing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORSNURTLESHELL"
msgid "背上会粘住。"
msgstr "It will stick to my back."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORWAGPUNK"
msgid "可怕的机件。"
msgstr "A terrifying machine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMORWOOD"
msgid "木甲。普通。"
msgstr "Wooden armor. ...Ordinary."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_BRAMBLE"
msgid "防守就是最好的进攻。"
msgstr "The finest defense is attack."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_CARROTLURE"
msgid "捆成一束的菜，很结实。……好。"
msgstr "A bundle of carrots. ...Tightly packed. ...Good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_LUNARPLANT"
msgid "这身防具，没什么可改的了。"
msgstr "This armor. ...No room for improvement."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "刺痛，也算与敌为伴。"
msgstr "A prickling feel. ...In both senses."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_SANITY"
msgid "安全，却不安。"
msgstr "Safe, and yet unsettling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "唉，前面裂了！"
msgstr "Argh. ...It split at the front!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "疑问不少。"
msgstr "A mountain of questions."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "「别玩火」。"
msgstr "\"Do not play with matches.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "写着「往那边」。"
msgstr "It reads, \"Over there.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "空白的牌子。"
msgstr "A blank sign."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "「别玩火」。"
msgstr "\"Do not play with matches.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "写着「往那边」。"
msgstr "It reads, \"Over there.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "空白的牌子。"
msgstr "A blank sign."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.GENERIC"
msgid "火留下的东西。"
msgstr "Fire's legacy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "骸骨在传送时烧掉了。"
msgstr "The bone, teleported and burned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "花在传送时烧掉了。"
msgstr "The flower, teleported and burned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "总有个解释。……大概。"
msgstr "There is an explanation. ...Probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS"
msgid "青菜。"
msgstr "A vegetable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUSSOUP"
msgid "香味就是味道。"
msgstr "The aroma is the flavor."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS_COOKED"
msgid "对身体好。据说。"
msgstr "Good for the body. ...So they say."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "这几天都吃它了。"
msgstr "An asparagus life, for now."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ASPARAGUS_SEEDS"
msgid "一些种子。"
msgstr "Some seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "力在变大。"
msgstr "The power grows."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "要缓一缓。我也一样。"
msgstr "It must recover. ...So must I."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "门开始不稳。"
msgstr "The gate grows unstable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.OFF"
msgid "主要的零件都还好。"
msgstr "The main parts are intact."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_GATE.ON"
msgid "在运作。"
msgstr "In operation."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_KEY"
msgid "力从里面放出来。"
msgstr "It radiates power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "要有动力。"
msgstr "It wants power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "让人不安的光。"
msgstr "An unsettling light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "这些记号我不认识。"
msgstr "A mark I do not recognize."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "古文明的画。人在饿，脸上有恐惧。"
msgstr "A depiction of an ancient civilization. ...Faces gaunt with hunger."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "磨掉了，读不出来。"
msgstr "Too worn to be read."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "黑暗正在吞掉城和人。"
msgstr "A darkened city, and its people, corroding."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "人在换皮。里面是别的东西。"
msgstr "The people shed their skins. ...Something else within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "画着巨大的机械之城。"
msgstr "A depiction of a city of colossal technology."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.ATRIUM_STATUE"
msgid "不像是真的。"
msgstr "Not entirely of this reality."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.AXE"
msgid "斧。可靠。"
msgstr "An axe. ...Dependable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "可爱。一团毛。"
msgstr "Cute. ...A ball of fluff."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "好梦，小臭孩。"
msgstr "Sweet dreams, little one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BACKPACK"
msgid "背包。能装很多。"
msgstr "A pack. ...It holds much."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BACONEGGS"
msgid "完美的早饭。"
msgstr "A perfect breakfast."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALATRO_MACHINE"
msgid "赌局的机子。来一局如何。"
msgstr "A game machine. ...One round, how about it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOON"
msgid "为什么，浮着。"
msgstr "Why does it float."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONHAT"
msgid "静电。头发要遭殃。"
msgstr "Static. ...My hair suffers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONPARTY"
msgid "里面还有小的？怎么进去的。"
msgstr "The little one is inside? ...How to get in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "普通的气球。"
msgstr "An ordinary balloon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "中间有洞。飞得快。"
msgstr "A hole in the middle. ...It flies fast."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONS_EMPTY"
msgid "小丑的货币。"
msgstr "The clown's currency."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BALLOONVEST"
msgid "颜色鲜艳，还会叫。容易招怪。"
msgstr "Bright colors. ...It squeals too. ...It draws monsters."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BANANABUSH"
msgid "香蕉丛。甜味太重。"
msgstr "A banana bush. ...Overly fragrant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BANANAJUICE"
msgid "喝着有点使坏的意思。"
msgstr "It feels slightly wicked."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BANANAPOP"
msgid "冻脑子不好。但也需要。"
msgstr "Brain freeze will not do. ...It is necessary."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BANDAGE"
msgid "干净。……大概。"
msgstr "Clean. ...Probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "虫翅做的绷带，临时凑的。"
msgstr "A butterfly bandage. ...An improvisation."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLE"
msgid "看着，像一节节的指头。"
msgstr "It looks. ...Unlike knuckles."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLEPITA"
msgid "看不见的时候，更好吃。"
msgstr "Unseen. ...All the tastier."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "饿了的话，也值得考虑。"
msgstr "Hungry. ...Worth considering."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLESUSHI"
msgid "又没带筷子。"
msgstr "Again, no chopsticks."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLE_COOKED"
msgid "听说是珍品。"
msgstr "A delicacy, I hear."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BARNACLINGUINE"
msgid "面来了。请。"
msgstr "Noodles, please."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BASALT"
msgid "很硬，凿不透。"
msgstr "Hard. It cannot be pierced."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BAT"
msgid "吵。走开。"
msgstr "Eek. ...Loud."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATBAT"
msgid "两把一起拿。……可惜不会飞。"
msgstr "Wielding two. ...Still cannot fly. ...A pity."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATCAVE"
msgid "别吵醒它们。"
msgstr "Do not wake them."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATHBOMB"
msgid "书上写的化学。"
msgstr "Textbook chemistry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATNOSE"
msgid "这是从谁脸上取的？"
msgstr "Whose nose?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATNOSEHAT"
msgid "不用手就能喝了。"
msgstr "Hands-free milk drinking."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATNOSE_COOKED"
msgid "烤过了。味道还在。"
msgstr "Out of the oven, and already nose-flavored."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_CONTAINER"
msgid "曲子都收在这里。"
msgstr "Many tunes, stored."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_DURABILITY"
msgid "看戏，我坐立不安。"
msgstr "Theatre. ...It makes me fidget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "看戏之前，背心先烧了。讽刺。"
msgstr "Before the show. ...The vest burned. ...Ironic."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "看戏，我坐立不安。"
msgstr "Theatre. ...It makes me fidget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "我没有做诗人的本事。"
msgstr "No qualifications as a poet."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "轻快的曲子。"
msgstr "A lively tune."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "我没有做诗人的本事。"
msgstr "No qualifications as a poet."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "演戏，我坐不住。"
msgstr "Theatre. ...It makes me fidget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "看戏，我坐立不安。"
msgstr "Theatre. ...It makes me fidget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "看戏，我坐立不安。"
msgstr "Theatre. ...It makes me fidget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "演戏，我坐不住。"
msgstr "Theatre. ...It makes me fidget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATWING"
msgid "蝙蝠的翅膀。"
msgstr "A bat wing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BATWING_COOKED"
msgid "至少不会再飞回来。"
msgstr "At least it will not come back."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARDHAIR"
msgid "别人的胡子。不敢恭维。"
msgstr "Another man's beard. ...I cannot praise it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGER"
msgid "很大的熊。不好对付。"
msgstr "A bear, a badger. ...Big."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "好险。"
msgstr "That was close."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "臭气冲天！"
msgstr "The stench, at its limit!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "总该有个说法！"
msgstr "There must be a scientific explanation!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERFUR_SACK"
msgid "毛还留着。寒气也在。"
msgstr "Fur still remains. ...It is cold."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGERVEST"
msgid "冬眠用的一身。"
msgstr "A hibernation suit."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEARGER_FUR"
msgid "厚实的毛。"
msgstr "Thick fur."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEAST_BLUEPRINT"
msgid "这个，感觉不错。"
msgstr "This one. ...A good premonition."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEDROLL_FURRY"
msgid "暖和，舒服。"
msgstr "Warm, and comfortable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEDROLL_STRAW"
msgid "舒服。有股旧草的味道。"
msgstr "Comfortable. ...It smells of mold."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEE.GENERIC"
msgid "蜂。"
msgstr "A bee."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEE.HELD"
msgid "小心。"
msgstr "Careful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.BURNT"
msgid "怎么烧了。"
msgstr "How did it burn?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.FULLHONEY"
msgid "蜂蜜满了。"
msgstr "Full of honey."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.GENERIC"
msgid "蜂！"
msgstr "Bees!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.NOHONEY"
msgid "空的。"
msgstr "Empty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.READY"
msgid "蜂蜜满了。"
msgstr "Full of honey."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BEEBOX.SOMEHONEY"
