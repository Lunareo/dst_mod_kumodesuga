msgstr "I've caught his eye!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK"
msgid "浮标～又是浮标呢～"
msgstr "A buoy, another buoy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "浮标～又是浮标呢～"
msgstr "A buoy, another buoy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "浮标～又是浮标呢～"
msgstr "A buoy, another buoy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "浮标～又是浮标呢～"
msgstr "A buoy, another buoy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "声援～气氛烧起来啦～"
msgstr "Cheering, ignited."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_START"
msgid "总得有个起点呢～"
msgstr "Every race needs a start."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "起点放哪儿好呢～"
msgstr "Where shall the start be?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "「货物」～船员的说法嘛，就是「东西」啦～"
msgstr "'Cargo', sailor-speak for 'things'."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "看来是旧式的做法呢～"
msgstr "An old-fashioned approach, it seems."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "这条船，可有王冠的荣耀哟～"
msgstr "The boat, crowned in glory."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "预定给船当护舷的～"
msgstr "Bumpers for the boat, planned."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_KELP"
msgid "不能全挡下来，不过有用就行～"
msgstr "Can't block everything, but useful."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "预定给船当护舷的～"
msgstr "Bumpers for the boat, planned."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "贝壳做的防御～"
msgstr "Seashell defense."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "预定给船当护舷的～"
msgstr "Bumpers for the boat, planned."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "撞上龙船，可要被角顶哟～"
msgstr "Bump the dragon boat, get the horns."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "预定给船当护舷的～"
msgstr "Bumpers for the boat, planned."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "炮～可以发射咯！"
msgstr "The cannon, ready to fire!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "该装弹药啦～"
msgstr "Time to load it."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "我可没忘～期待正在培养中～"
msgstr "I haven't forgotten, anticipation growing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_CANNON_KIT"
msgid "还不算是炮～不过马上就是啦～"
msgstr "Not yet a cannon, but soon."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_GRASS_ITEM"
msgid "姑且也算是船吧～"
msgstr "It passes for a boat."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ITEM"
msgid "想划着它出海兜风呢～"
msgstr "I want to try experiments on water."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_LEAK"
msgid "得在沉下去之前补好哟～"
msgstr "Patch it before we sink."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "动了～当然啦，都在我预料之内～"
msgstr "It moved, naturally, as expected."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "被物理吸过去～合适的词我一时想不出来呢～"
msgstr "Physically attracted, no word for it."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "磁力！"
msgstr "Magnetism!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "附近有强磁铁，会被吸过去哟～"
msgstr "A strong magnet nearby, we'll be pulled in."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_MAGNET_KIT"
msgid "天才点子，自夸～"
msgstr "A genius idea, if I say so myself~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ROTATOR"
msgid "方向是对的吧，也许～往左～"
msgstr "The direction is right, perhaps, left."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "该试着转转看啦～"
msgstr "Time for a test turn."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "牛毛做的～那股味儿还留着呢～"
msgstr "Beefalo wool, the smell lingers."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_KELP"
msgid "湿得太过头啦～"
msgstr "Far too damp."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_PETALS"
msgid "比牛毛枕头香多了呢～"
msgstr "Fragrant, unlike the wool ones."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "谁会睡这个呀～"
msgstr "Who would sleep on this?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOMB_LUNARPLANT"
msgid "植物学加化学，携手合作～"
msgstr "Botany and chemistry, cooperating."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "沃姆伍德呀～看着是月之力觉醒了呢～"
msgstr "Wormwood, it seems the moon's power has awakened."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BONESHARD"
msgid "骨头碎片～"
msgstr "Bone shards."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BONESOUP"
msgid "骨头汤～沃利的真本事呀～"
msgstr "Bone soup, genuine Warly."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BONESTEW"
msgid "骨头汤～有营养，暖胃～"
msgstr "Bone stew, nutritious."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOKSTATION.BURNT"
msgid "图书馆闭馆咯～还挺可惜的呢。"
msgstr "The library is closed~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOKSTATION.GENERIC"
msgid "书架呀～闲着也是闲着，翻两页打发时间正好～"
msgstr "A bookstand... experiments first, books later."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_BEES"
msgid "蜂的书～嗡嗡嗡，光看着就吵起来了～"
msgstr "A bee book, buzzing and noisy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_BIRDS"
msgid "鸟的书～从头到尾叽叽喳喳，看得我耳朵都响了～"
msgstr "A book of birds, chirp chirp."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_BRIMSTONE"
msgid "开头无聊得要命，结尾却很棒～作者一定憋了很久吧～"
msgstr "A boring start, a splendid finish."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_ELEMENTAL"
msgid "上面的字我认不出来呢～"
msgstr "The script, unknown."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_FIRE"
msgid "火的书……写得一点也不烫人呢，缺了点迫切感～"
msgstr "A book of fire... no urgency there."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_FISH"
msgid "钓鱼的书～可惜鱼是不看书的哟～"
msgstr "A fishing book, the fish won't take that bait."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_FOSSIL"
msgid "能把怪物拘住～不过时间很短哟～"
msgstr "Binds monsters, briefly."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_GARDENING"
msgid "园艺书～不过说到底还是土最重要嘛～"
msgstr "A gardening book... but the soil matters more."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_HORTICULTURE"
msgid "园艺书～已经翻完啦，比想象中有趣呢～"
msgstr "A horticulture book, been through it already."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "看草一根根长大……嗯，都长一个样呢～"
msgstr "Watching grass grow... all the same."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_LIGHT"
msgid "光的书～写这本书的人一定亮得很刺眼吧～"
msgstr "A book of light, its writer must be very bright."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "亮，非常亮～再亮一点我就要抗议啦～"
msgstr "Bright, very bright."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_MOON"
msgid "月亮的书～那种东西的流行也就一时的事哟～"
msgstr "A moon book, a passing fad."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_RAIN"
msgid "雨的书～滴滴答答的，光听着就要犯困啦～"
msgstr "A rain book, hardly scientific~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "守规矩守到这份上的老妇人，可敬可敬～我可学不来哟。"
msgstr "A rule-abiding old granny, respectable, respectable."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_SILVICULTURE"
msgid "造林的书～把树当孩子养，这心态我很喜欢～"
msgstr "A silviculture book, mm~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_SLEEP"
msgid "整整五百页的电报码……呼，催眠效果一流哟～"
msgstr "Five hundred pages of telegraph code... whew, first-rate as a sleeping aid."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_TEMPERATURE"
msgid "温度的书～不冷也不热，读起来刚好犯困～"
msgstr "A temperature book, neither cold nor hot."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_TENTACLES"
msgid "触手的书～谁读谁上钩，这种恶趣味我懂哟～"
msgstr "A book of tentacles, whoever reads it takes the bait."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOK_WEB"
msgid "蛛网教材呀～这织法嘛，业余业余，差我几万年的功夫呢～"
msgstr "A web-weaving primer... this technique, amateur, amateur."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOMERANG"
msgid "空气力学呀～想出这个的人真了不起～"
msgstr "Aerodynamics, remarkable."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOOTLEG"
msgid "某个海盗要少一件战利品咯～"
msgstr "Some pirate is one trophy short."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BROKEN_FORGEDITEM"
msgid "坏了呀～看着是能修的呢～"
msgstr "Broken, but repairable by the look of it."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "够热的话就能熔接哟～"
msgstr "Hot enough to weld."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BRUSH"
msgid "牛很喜欢这个哟～"
msgstr "The beefalo love this."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUGNET"
msgid "捕虫网～抓虫子比钓鱼简单多啦～"
msgstr "A bug net."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "嗯，是昆布呢～"
msgstr "Mm, kelp."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "采完啦～"
msgstr "All picked."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BULLKELP_ROOT"
msgid "在深水里能种哟～"
msgstr "It can be planted in deep water."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNDLE"
msgid "补给都在里面呢～"
msgstr "Supplies inside."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNDLEWRAP"
msgid "打包好了搬着方便～"
msgstr "Bundled for easy carrying."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNNYMAN"
msgid "兔人呀～胡萝卜可要收好咯～"
msgstr "A bunnyman, mind the carrots."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUNNYSTEW"
msgid "运气到此用尽咯～"
msgstr "My luck has run out."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BURNT_MARSH_BUSH"
msgid "全焦啦～"
msgstr "Fully charred."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BUSHHAT"
msgid "扎人呢～不过藏起来倒是方便～"
msgstr "Prickly."

