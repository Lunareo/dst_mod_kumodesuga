msgstr "The scholarly term. ...\"Dried\"."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
