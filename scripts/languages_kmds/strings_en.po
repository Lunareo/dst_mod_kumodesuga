#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.GENERIC"
msgid "怀表女士。很忙。"
msgstr "The clock lady. ...Busy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.GHOST"
msgid "心脏。要快。"
msgstr "A heart. ...Urgently."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.MURDERER"
msgid "没有第二次机会。"
msgstr "There is no second chance."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDA.REVIVER"
msgid "%s……多亏了你。历史没有改变。"
msgstr "%s... Thanks to her. ...History holds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "长相奇怪的牛。"
msgstr "A strangely-faced beefalo."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "做过买卖之后，能算朋友？"
msgstr "After trading. ...Could we be friends?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARDROBE.BURNING"
msgid "烧起来了，快！"
msgstr "It burns, fast!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARDROBE.BURNT"
msgid "过时了。"
msgstr "Out of fashion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARDROBE.GENERIC"
msgid "暗处藏着不能说的东西……"
msgstr "Forbidden dark secrets, hidden..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARG"
msgid "很大的犬。不好惹。"
msgstr "A great hound. ...Not to be trifled with."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGCORPSE.BURNING"
msgid "这样最好。"
msgstr "This is for the best."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGCORPSE.GENERIC"
msgid "为何还是不安。"
msgstr "Why is it still not at peace."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGCORPSE.REVIVING"
msgid "什么情形，讲不通。"
msgstr "What is happening. ...Science cannot explain."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGLET"
msgid "今天大概就是这种日子。"
msgstr "I sense a day like this coming."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.BURNING"
msgid "做起来很愉快。"
msgstr "A well-made thing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.BURNT"
msgid "烧完了。"
msgstr "Burnt to the end."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.EMPTY"
msgid "要放火把进去。"
msgstr "It wants a torch."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARGSHRINE.GENERIC"
msgid "做起来很愉快。"
msgstr "A well-made thing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.ATTACKER"
msgid "这道菜是场灾难。"
msgstr "A recipe for disaster."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.FIRESTARTER"
msgid "全都烧了。厨房完了。"
msgstr "Everything, aflame. ...The kitchen is done for."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.GENERIC"
msgid "厨师。很期待他的料理。"
msgstr "A chef. ...I look forward to his cooking."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.GHOST"
msgid "幽灵辣椒吃多了吗。"
msgstr "Too many ghost peppers?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.MURDERER"
msgid "半生不熟的计划。不成。"
msgstr "A half-baked scheme. ...No chance."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WARLY.REVIVER"
msgid "%s……连救人都像在下厨。"
msgstr "%s... Plans his cooking. Always."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAR_BLUEPRINT"
msgid "勇猛的样式。"
msgstr "A valiant design."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WASPHIVE"
msgid "蜂在发怒。"
msgstr "The wasps are in a fury."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERBALLOON"
msgid "水球。不错。"
msgstr "A water balloon. ...Not bad."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERINGCAN.EMPTY"
msgid "附近有水塘就好了。"
msgstr "A pond nearby. ...If only there were."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERINGCAN.GENERIC"
msgid "浇水用的。"
msgstr "For watering."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON"
msgid "又粘又甜。"
msgstr "Sticky, sweet."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELONHAT"
msgid "汁流到脸上。夏天限定。"
msgstr "Juice streams down my face. ...A summer exclusive."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELONICLE"
msgid "冰过的西瓜。"
msgstr "Watermelon ice."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON_COOKED"
msgid "汁是温的。"
msgstr "Warm juice."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON_OVERSIZED"
msgid "好大的西瓜。水很多。"
msgstr "A big watermelon. ...Juicy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERMELON_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT"
msgid "不采它，就还能相处。"
msgstr "I will not pick the barnacles. ...The friendship holds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT_BABY"
msgid "还是小苗。"
msgstr "This one is still a sprout."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT_BOMB"
msgid "在挨打！"
msgstr "Under attack!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPLANT_PLANTER"
msgid "长在海边石头上。长得不错。"
msgstr "On the sea rock. ...It grows well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERPUMP"
