msgstr "Caught the scent."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
