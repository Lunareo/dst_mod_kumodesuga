msgstr "Built for lightness and mobility."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "防护程度不错。"
msgstr "Good protection."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "攻击稍微涨了。"
msgstr "Attacks somewhat stronger."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "精力够用几次。"
msgstr "Energy for several rounds."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "安全有保障。"
msgstr "Safety assured."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "大家一起把军旗砸了！"
msgstr "Everyone, bring down the banner!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_BERNIE"
msgid "适合当诱饵。"
msgstr "Fit as a decoy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_BOARLORD"
msgid "这里的负责人是猪。"
msgstr "The one in charge here is a pig."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "能造成很大的破坏。"
msgstr "Great destruction, possible."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "岩石怪物！"
msgstr "A monster of rock!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "眼环。设计不错。"
msgstr "An eye ring. Good design."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "羽毛冠。跑起来有气势。"
msgstr "A feather crown. It makes me want to run."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_FIREBOMB"
