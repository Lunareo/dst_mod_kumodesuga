#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "还会再长的哟～"
msgstr "Still growing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.STUFFED"
