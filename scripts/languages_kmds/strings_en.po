msgstr "A preservative against decay."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTLICK"
msgid "要舔到中间，得多久。"
msgstr "How many licks to the center?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTLICK_IMPROVED"
msgid "看着就口渴。"
msgstr "Just looking. ...It makes me thirsty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTROCK"
msgid "想尝一口。……说不清为什么。"
msgstr "I want to lick it. ...I know not why."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTSTACK.GENERIC"
msgid "天然长成的？"
msgstr "Naturally formed?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTSTACK.GROWING"
msgid "原来是这样长的。"
msgstr "It grows like this."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "采完了，一点不剩！"
msgstr "Mined out... every last bit!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTY_DOG"
msgid "神气的小海狗。"
msgstr "A proud little sea dog."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SALTY_DOGHAT"
msgid "交情附赠的。"
msgstr "A bonus with friendship."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SANDBLOCK"
msgid "沙。粗糙。"
msgstr "Sand. ...Coarse."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SANDSPIKE"
msgid "沙刺。差点被串起来。"
msgstr "A sand spike. ...It nearly skewered me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SANITYROCK.ACTIVE"
msgid "奇怪的岩石！"
msgstr "A strange rock!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SANITYROCK.INACTIVE"
msgid "剩下的去哪了。"
msgstr "Where did the rest go."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.BURNING"
msgid "烧起来了，快！"
msgstr "It burns, fast!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.DISEASED"
msgid "病了。"
msgstr "Sick."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.DISEASING"
msgid "不太对劲。"
msgstr "Something is off."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.GENERIC"
msgid "树的小苗。可爱。"
msgstr "A baby tree. ...Cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.PICKED"
msgid "剪过了。"
msgstr "Lesson delivered."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SAPLING.WITHERED"
msgid "凉下来就好。"
msgstr "Once it cools, it will be fine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCANDATA"
msgid "新东西的气味。"
msgstr "The smell of new research."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCARECROW.BURNING"
msgid "稻草人着火了。"
msgstr "A burning scarecrow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCARECROW.BURNT"
msgid "把稻草人烧死了……！"
msgstr "Killed the scarecrow...!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCARECROW.GENERIC"
msgid "穿得再好也没人看。"
msgstr "Finely dressed, with nowhere to crow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCORCHED_SKELETON"
msgid "奇怪。"
msgstr "Strange."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCRAPBOOK_PAGE"
msgid "有人爱把这些贴成一本。"
msgstr "A scrapbook enthusiast. ...There seems to be one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCRAPHAT"
msgid "帽子先戴上，我的脑袋也不钝。"
msgstr "The hat first. ...My brain is not sharp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "更像个读书人？"
msgstr "More the scholar now?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "准备雕了。"
msgstr "Ready to sculpt."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "烧完了。"
msgstr "Burnt to the end."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "石头能雕出东西。"
msgstr "The stone can be carved."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "杰作！"
msgstr "A masterpiece!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "旧的样子，新的感觉。"
msgstr "Old shape. New feeling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "然后呢。"
msgstr "And now?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "里面在动。"
msgstr "Something stirs within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "缺了一大块。"
msgstr "Big chunks missing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "头？"
msgstr "A head?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "奇怪的石像。"
msgstr "A strange marble figure."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "复原了一个。"
msgstr "One, restored."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "里面在动。"
msgstr "Something stirs within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "被压碎了。"
msgstr "Crushed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "剩下的在哪。"
msgstr "Where is the rest?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "石头的像。"
msgstr "A marble figure."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "修好了。"
msgstr "Restoration complete."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "里面在动。"
msgstr "Something stirs within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "状态很差。"
msgstr "In poor condition."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "从哪来的。"
msgstr "From where?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "沉到海里去了。"
msgstr "Science, sunk into the sea."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "造船用的台子。"
msgstr "A boat-science device."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEAFOODGUMBO"
msgid "满满一份海鲜汤。"
msgstr "A large seafood stew."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEASTACK"
msgid "石头。"
msgstr "A rock."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "有意思。空的。"
msgstr "Interesting. ...Empty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "可爱，一团纯的力。"
msgstr "Cute. ...A sphere of pure energy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEEDPOUCH"
msgid "口袋里全是种子。麻烦。"
msgstr "A pocketful of seeds. ...Bothersome."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEEDS"
msgid "小小的谜。"
msgstr "A small riddle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEEDS_COOKED"
msgid "烤过就没命了。"
msgstr "A life, roasted away."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SENTRYWARD"
msgid "看地图用的道具。便利。"
msgstr "A map, and an item. ...Convenient."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_KIT"
msgid "缝上！补好！"
msgstr "Sew! ...Mend!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "烧完了，也没有去处。"
msgstr "Burnt up. ...With nowhere to go."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "盛装，却没有去处。"
msgstr "Finely dressed. ...With nowhere to go."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SEWING_TAPE"
msgid "补东西用的。"
msgstr "For repairs."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWDANCER"
msgid "看过一次就忘不了的舞。"
msgstr "A dance I will not forget."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWDIGGER"
msgid "又多了一个他。"
msgstr "Another of him, added."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWHEART"
msgid "靠学问，让它动起来了。"
msgstr "Science... set it moving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "往下落，没有底。"
msgstr "A drop. ...A sense of the boundless."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "很大的东西。当心。"
msgstr "A big one. ...Stay alert."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "翻过来了！"
msgstr "Upside down!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "头？还是头？"
msgstr "A head. ...Or a head?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "别碰！"
msgstr "Do not touch!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "一身战意。"
msgstr "Battle-lust, full."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "话多的家伙。"
msgstr "A many-mouthed fellow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "脑子里发痒。"
msgstr "An itch in the brain."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "翅膀，像是摆设。"
msgstr "Wings. ...Ornamental, it seems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_BATTLEAXE"
msgid "呜！把指望都埋了。"
msgstr "Ugh. ...Bury my hopes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_BEEF_BELL"
msgid "和我的牛铃很像。暗的那一版。"
msgstr "My beefalo bell. ...The very image. ...The shadow edition."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_FORGE"
msgid "会打出什么暗里的东西？"
msgstr "What dark thing will it make?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_FORGE_KIT"
msgid "不试一回，心里不定。"
msgstr "No experiments. ...Most unscientific."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHADOW_HEART_VEIN"
msgid "血管，用处不大。"
msgstr "A vein. ...Meager effect."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHALLOW_GRAVE"
msgid "你还好吗。"
msgstr "May you be well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHARK"
msgid "或许……得要更大的船。"
msgstr "Perhaps. ...A bigger boat is needed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHARKBOI"
msgid "背上一凉……！"
msgstr "A shudder...!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHELLWEAVER"
msgid "做盐的手艺人。"
msgstr "A salt craftsman."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHELL_CLUSTER"
msgid "里面有好贝壳。"
msgstr "Good shells within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHIELDOFTERROR"
msgid "最好的守法，一张大口。"
msgstr "The best defense. ...A big mouth."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHIRO
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHIRO"
msgid "白小姐。%s……在下随时听候差遣。"
msgstr "Lady Shiro. %s... This one is at your service."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHOVEL"
msgid "地下的事很复杂。"
msgstr "Beneath the ground lies complexity."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "挖土，有无穷用处。"
msgstr "The possibilities of digging, infinite."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHROOMBAIT"
msgid "梦的味道。"
msgstr "The smell of dreams."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHROOMCAKE"
msgid "名副其实。"
msgstr "True to its name."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SHROOM_SKIN"
msgid "粗糙的皮。"
msgstr "Warty hide."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SIESTAHUT.BURNT"
msgid "阴凉没了。"
msgstr "The shade is gone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SIESTAHUT.GENERIC"
msgid "午后休息的地方。凉快，也安全。"
msgstr "An afternoon rest. ...Cool, and safe."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SILK"
msgid "丝。和白小姐同源的手艺。……嗯。"
msgstr "Silk. ...Crafted by kin of Lady Shiro. ...Mm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SILK_ROBE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SILK_ROBE"
msgid "丝织的衣裳。针线扎实。让我想起那件和服。"
msgstr "A robe of silk. The stitching is sound. ...It reminds me of that kimono."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "音低了些。"
msgstr "The tone is somewhat low."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "这是海的声音？"
msgstr "Is this the sea's voice?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "高音准备好了。"
msgstr "The high note, ready."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SISTURN.GENERIC"
msgid "有花就好。"
msgstr "Flowers would be nice."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "一大束花，很隆重。"
msgstr "A bouquet. ...Grand."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "这声音让人发冷。"
msgstr "An eerie sound."

