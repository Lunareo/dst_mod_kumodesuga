msgstr "A mountain of old parts."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
