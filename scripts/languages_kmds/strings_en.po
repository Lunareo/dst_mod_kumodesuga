msgstr "Mix all three colors and it lights."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "蓝蓝的，发着光呢～"
msgstr "Blue, and glowing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "被酸糊了一层呢～别碰哟～"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "发着光呢～是繁殖期哟～"
msgstr "Glowing, the breeding season~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
