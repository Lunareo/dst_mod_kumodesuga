msgstr "Looking at it hurts the soul."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
