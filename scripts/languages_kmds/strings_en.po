msgstr "Markings, unfamiliar."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "古文明的画～人饿到脸都变形了呢～"
msgstr "A painting of an ancient civilization, faces hungry and afraid."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "磨损得读不出来啦～"
msgstr "Worn away, unreadable."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "黑暗的都市和人～正在被侵蚀呢～"
msgstr "A dark city and its people, being eroded."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
