msgid "这里发生过不好的事。"
msgstr "Bad things happened here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENT_STATUE"
msgid "它的振动和这个世界不合。"
msgstr "Its vibrations don't fit this world."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANIMAL_TRACK"
msgid "食物留下的脚印。……我是说，动物。"
msgstr "Tracks left by food.... I mean, an animal."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTCHOVIES"
msgid "能扔回去吗。"
msgstr "Can these be thrown back."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLION.GENERIC"
msgid "它想从我这里拿点什么。"
msgstr "It wants something from me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLION.UNHAPPY"
msgid "它在生气。"
msgstr "It's angry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLION.VERYHAPPY"
msgid "关系还算不错。"
msgstr "Our relations are decent."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLIONHAT"
msgid "划开地面的成就。"
msgstr "A monument to carving open the ground."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANTLIONTRINKET"
msgid "有人会对这个感兴趣。"
msgstr "Someone would take an interest in this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARAMASA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARAMASA"
msgid "创世者的仿品。八次判定，很直白。"
msgstr "A copy of a creator's tool. Eight hit checks. Very direct."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "你挡不住我。"
msgstr "You won't stop me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "一堆旧零件。"
msgstr "A pile of old parts."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "锅被煮了。"
msgstr "The pot got cooked."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "这要花些时间。"
msgstr "This will take some time."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "快好了。"
msgstr "Almost done."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "可以吃了。"
msgstr "Ready to eat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "把这口旧锅上的灰掸掉吧。"
msgstr "Dust the old pot off, shall we."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "要怎么把里面的知识取出来。"
msgstr "How does one extract the knowledge inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "站在它旁边，看别人聊无关紧要的事。"
msgstr "Stand beside it, and watch others chat about unimportant things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "要是有办法让它重新运作就好了。"
msgstr "If only there were a way to get it running again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "这些出色的月亮像让我想吟诗。"
msgstr "These splendid moon statues make me want to recite verse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "他们像是故意把它做得难解。"
msgstr "They seem to have made it deliberately impenetrable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "奇怪，电是通的，但这个没亮。"
msgstr "Strange. The power is on, but this isn't lit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "彻底死了。"
msgstr "Completely dead."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "有这么复杂的机器，为什么还要用地图。"
msgstr "With such a complex machine, why bother with maps."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "它似乎已经找到了所有值得找的东西。"
msgstr "It seems to have found everything worth finding."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "用秘密的知识做出了一台装置。为什么这感觉很熟悉。"
msgstr "A device built from secret knowledge. Why does that feel familiar."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "这么多知识，可惜我读不懂。"
msgstr "So much knowledge, a pity I can't read it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "这些刻痕和遗迹里其他的不一样。"
msgstr "These carvings differ from the others in the ruins."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "这么多知识，可惜我读不懂。"
msgstr "So much knowledge, a pity I can't read it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "这些刻痕和遗迹里其他的不一样。"
msgstr "These carvings differ from the others in the ruins."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "这么多知识，可惜我读不懂。"
msgstr "So much knowledge, a pity I can't read it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "它看着很诱人。"
msgstr "It looks enticing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "不管它做过什么，现在都不做了。"
msgstr "Whatever it used to do, it does so no longer."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "你要去哪。有趣的地方吗。"
msgstr "Where are you off to. Somewhere interesting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "插孔是空的。"
msgstr "The sockets are empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "那些宝石似乎在给它供能。用完全讲道理的方式。"
msgstr "Those gems seem to power it. In an entirely reasonable way."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORDRAGONFLY"
msgid "热的锁甲。"
msgstr "Hot scale mail."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORDREADSTONE"
msgid "轻，结实，而且好看。"
msgstr "Light, sturdy, and good-looking."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORGRASS"
msgid "希望里面没有虫。"
msgstr "Hope there are no bugs inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORMARBLE"
msgid "看起来很重。"
msgstr "Looks heavy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORRUINS"
msgid "意外地轻。"
msgstr "Surprisingly light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORSKELETON"
msgid "骨头做的。没什么可说的。"
msgstr "Made of bone. Nothing more to say."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORSLURPER"
msgid "湿的。但管饱。"
msgstr "Wet. But filling."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORSNURTLESHELL"
msgid "穿上以后会黏在背上。"
msgstr "It'll stick to your back once worn."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORWAGPUNK"
msgid "既可怕，又满是齿轮。"
msgstr "Both dreadful and full of gears."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMORWOOD"
msgid "一件完全合理的衣服。"
msgstr "A perfectly reasonable outfit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_BRAMBLE"
msgid "最好的进攻是好的防守。"
msgstr "The best offense is a good defense."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_CARROTLURE"
msgid "我喜欢织得紧的东西。"
msgstr "I like things woven tight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_LUNARPLANT"
msgid "这件甲已经没有可改的余地。"
msgstr "This armor has no room for improvement left."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "那会给你扎上一根刺。"
msgstr "That'll give you a thorn."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_SANITY"
msgid "穿上以后，既安心又不安。"
msgstr "Wearing it is both reassuring and unnerving."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "可惜，前面裂开了一道。"
msgstr "A pity, there's a slit down the front."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "我背上一堆问题。"
msgstr "I'm carrying a pile of problems on my back."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "\"不要玩火。\""
msgstr "\"Don't play with fire.\""

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "上面写着\"往那边\"。"
msgstr "It says \"that way\"."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "牌子上现在是空的。"
msgstr "The sign is empty right now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "\"不要玩火。\""
msgstr "\"Don't play with fire.\""

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "上面写着\"往那边\"。"
msgstr "It says \"that way\"."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "牌子上现在是空的。"
msgstr "The sign is empty right now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.GENERIC"
msgid "火烧完以后剩下的东西。"
msgstr "What's left after fire finishes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "那块眼骨在传送中被烧掉了。"
msgstr "That eye bone burned up in transit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "那朵花在传送中被烧掉了。"
msgstr "That flower burned up in transit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS"
msgid "一种菜。"
msgstr "A vegetable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUSSOUP"
msgid "味道和闻起来一样。"
msgstr "Tastes the way it smells."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS_COOKED"
msgid "按理说这对我有好处。"
msgstr "By rights this should be good for me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "看来我们要吃芦笋吃一阵了。"
msgstr "Looks like we'll be eating asparagus for a while."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ASPARAGUS_SEEDS"
msgid "一些种子。"
msgstr "Some seeds."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "它在积蓄力量。"
msgstr "It's building up power."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "它需要时间恢复。我也一样。"
msgstr "It needs time to recover. So do I."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "那道门正在失稳。"
msgstr "That gate is losing stability."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.OFF"
msgid "关键的部分还完好。"
msgstr "The key parts are still intact."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_GATE.ON"
msgid "恢复运作了。"
msgstr "Operational again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_KEY"
msgid "有力量从里面渗出来。"
msgstr "Power seeps out of it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "它需要什么来供能。"
msgstr "It needs something to power it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "一种确实让人不安的光。"
msgstr "A genuinely unsettling light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "这些符号我一个都不认得。"
msgstr "I can't read a single one of these symbols."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "上面是一个古老的文明。人们又饿又怕。"
msgstr "Above is an ancient civilization. People were hungry and afraid."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "这块石板磨得看不清了。"
msgstr "This slab has been worn illegible."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "某种黑暗覆盖了城市和城里的人。"
msgstr "Some darkness covered the city and its people."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "人们在脱皮。下面的样子不一样。"
msgstr "The people are shedding skin. What's underneath looks different."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "上面是一座巨大而先进的城市。"
msgstr "Above is a vast, advanced city."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ATRIUM_STATUE"
msgid "它看起来不完全是真的。"
msgstr "It doesn't look entirely real."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.AXE"
msgid "可靠的斧头。"
msgstr "A reliable axe."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "小号的。没什么威胁。"
msgstr "Small size. No threat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "好梦，臭家伙。"
msgstr "Sweet dreams, stinky."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BACKPACK"
msgid "那里面能装很多东西。"
msgstr "A lot can fit in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BACONEGGS"
msgid "完美的早餐。"
msgstr "A perfect breakfast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALATRO_MACHINE"
msgid "来一局也可以。"
msgstr "One round wouldn't hurt."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOON"
msgid "它们凭什么浮着。"
msgstr "By what right do they float."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONHAT"
msgid "静电会毁掉我的头发。"
msgstr "Static would ruin my hair."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONPARTY"
msgid "小的那些是怎么塞进去的。"
msgstr "How did the small ones get stuffed in."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "现在只是普通气球了。"
msgstr "Just an ordinary balloon now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "中间有洞，更符合空气动力学。这是物理。"
msgstr "A hole in the middle, more aerodynamic. It's physics."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONS_EMPTY"
msgid "小丑用的货币。"
msgstr "The clown's currency."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BALLOONVEST"
msgid "颜色不招来怪物，声音也会。"
msgstr "Color doesn't just attract monsters. Sound does too."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANANABUSH"
msgid "那丛灌木很疯。"
msgstr "That bush is insane."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANANAJUICE"
msgid "它让我有点像个恶人。"
msgstr "It makes me feel a bit like a villain."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANANAPOP"
msgid "不，别冻到脑子。我还要用它。"
msgstr "No, don't freeze your brain. I still need it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANDAGE"
msgid "看着够干净。"
msgstr "Looks clean enough."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "这条绷带确实靠翅膀。"
msgstr "This bandage really does lean on wings."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLE"
msgid "在我看来它们不像指节。"
msgstr "They don't look like knuckles to me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLEPITA"
msgid "看不见藤壶的时候，它更好吃。"
msgstr "It's tastier when you can't see the barnacles."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "我饿到愿意考虑这个了。"
msgstr "I'm hungry enough to consider this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLESUSHI"
msgid "我的筷子好像又不见了。"
msgstr "My chopsticks seem to have vanished again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLE_COOKED"
msgid "听说这算名菜。"
msgstr "I hear this counts as a delicacy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BARNACLINGUINE"
msgid "把面递过来。"
msgstr "Pass the noodles over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BASALT"
msgid "太硬。砸不开。"
msgstr "Too hard. Can't smash it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BAT"
msgid "蝙蝠。很吓人。"
msgstr "Bats. Frightening."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATBAT"
msgid "拿两把大概能飞起来。"
msgstr "Two of these might get you airborne."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATCAVE"
msgid "不想把它们叫醒。"
msgstr "Don't want to wake them."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATHBOMB"
msgid "教科书上的化学。"
msgstr "Textbook chemistry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATNOSE"
msgid "谁知道这是谁的鼻子。"
msgstr "Whose nose this was, who knows."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATNOSEHAT"
msgid "不用手就能喝奶。"
msgstr "Drink milk without using your hands."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATNOSE_COOKED"
msgid "熟了以后闻着还是像鼻子。"
msgstr "Cooked, it still smells like a nose."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_CONTAINER"
msgid "它能存这么多曲子。"
msgstr "It can store this many songs."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_DURABILITY"
msgid "看戏让我坐不住。"
msgstr "Spectating makes me fidget."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "我曾在看戏前把背心烧了。那叫讽刺。"
msgstr "I once burned my vest before a show. That's called irony."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "看戏让我坐不住。"
msgstr "Spectating makes me fidget."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "很遗憾，我没有作诗的执照。"
msgstr "Sadly, I have no license for verse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "一首很有生气的曲子。"
msgstr "A most lively tune."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "很遗憾，我没有作诗的执照。"
msgstr "Sadly, I have no license for verse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "看戏让我坐不住。"
msgstr "Spectating makes me fidget."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "看戏让我坐不住。"
msgstr "Spectating makes me fidget."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "看戏让我坐不住。"
msgstr "Spectating makes me fidget."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "看戏让我坐不住。"
msgstr "Spectating makes me fidget."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATWING"
msgid "我讨厌那种东西。死了也一样。"
msgstr "I hate those things. Dead or not."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BATWING_COOKED"
msgid "至少它不会再飞回来。"
msgstr "At least it won't fly back."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARDHAIR"
msgid "别人的才恶心。"
msgstr "Only disgusting when it's someone else's."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGER"
msgid "像熊一样的獾。"
msgstr "A badger shaped like a bear."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "好险。"
msgstr "That was close."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "这味道让人受不了。"
msgstr "This smell is unbearable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "这件事一定有讲得通的解释。"
msgstr "There must be a sensible explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERFUR_SACK"
msgid "上面还有毛。让人发冷。"
msgstr "There's still fur on it. Chilling."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGERVEST"
msgid "欢迎来到冬眠季。"
msgstr "Welcome to hibernation season."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEARGER_FUR"
msgid "一整片厚毛。"
msgstr "One whole slab of thick fur."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEAST_BLUEPRINT"
msgid "这一个我感觉运气不错。"
msgstr "I have a good feeling about this one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEDROLL_FURRY"
msgid "又暖又舒服。"
msgstr "Warm and comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEDROLL_STRAW"
msgid "看着舒服。但有霉味。"
msgstr "Looks comfortable. But smells moldy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEE.GENERIC"
msgid "蜂，或者不蜂。"
msgstr "Bee, or not bee."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEE.HELD"
msgid "小心。"
msgstr "Careful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.BURNT"
msgid "它怎么烧起来的。"
msgstr "How did it catch fire."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.FULLHONEY"
msgid "满是蜜。"
msgstr "Full of honey."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.GENERIC"
msgid "蜂。"
msgstr "Bees."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.NOHONEY"
msgid "空的。"
msgstr "Empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.READY"
msgid "满是蜜。"
msgstr "Full of honey."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "要再等一会儿。"
msgstr "Wait a while longer."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "它怎么烧起来的。"
msgstr "How did it catch fire."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "里面全是蜜。"
msgstr "Full of honey inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "里面一定能找到一点甜。"
msgstr "Something sweet can surely be found in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "空的。"
msgstr "Empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "里面全是蜜。"
msgstr "Full of honey inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "要再等一会儿。"
msgstr "Wait a while longer."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.DEAD"
msgid "它很顽强。"
msgstr "It was tenacious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "契约终止。有点可惜。"
msgstr "Contract terminated. A bit of a pity."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "这一头没那么臭。"
msgstr "This one smells less."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.FOLLOWER"
msgid "它安安静静地跟着。"
msgstr "It follows quietly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.GENERIC"
msgid "是皮弗娄牛。"
msgstr "A beefalo."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.MYPARTNER"
msgid "契约成立，终身有效。"
msgstr "Contract formed. Valid for life."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.NAKED"
msgid "它看着很难过。"
msgstr "It looks sad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.ORNERY"
msgid "它气得很深。"
msgstr "Its anger runs deep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.PUDGY"
msgid "嗯。里面装了太多食物。"
msgstr "Hm. Too much food stored inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.RIDER"
msgid "这一头看起来能骑。"
msgstr "This one looks rideable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO.SLEEPING"
msgid "这些家伙睡得很沉。"
msgstr "These fellows sleep deep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOFEED"
msgid "我不吃，多谢。"
msgstr "I won't be eating this, thanks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOHAT"
msgid "戴上头发会塌。"
msgstr "Wearing it flattens the hair."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOTREAT"
msgid "对我来说太粗了。"
msgstr "Too coarse for my tastes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALOWOOL"
msgid "闻着像皮弗娄牛的眼泪。"
msgstr "Smells like beefalo tears."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "我给我的牛做了最时兴的造型……然后付了代价。"
msgstr "I gave my beefalo the trendiest styling... and paid the price."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "这里没有牛可以打理。"
msgstr "No beefalo here to groom."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "来把这头牛弄漂亮。"
msgstr "Let's get this beefalo looking sharp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "该把它安在什么地方。"
msgstr "Where should this be installed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEF_BELL"
msgid "它能让牛变得友好。这一定有很讲道理的解释。"
msgstr "It makes beefalo friendly. There must be a perfectly reasonable explanation."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEGUARD"
msgid "它在护着女王。"
msgstr "It's guarding the queen."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEHAT"
msgid "能护住皮肤。但会压坏发型。"
msgstr "Protects the skin. But ruins the hairstyle."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEHIVE"
msgid "里面很热闹。"
msgstr "It's lively in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEMINE"
msgid "摇一摇会响。"
msgstr "Shake it and it rattles."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEMINE_MAXWELL"
msgid "瓶装的蚊子怒气。"
msgstr "Bottled mosquito rage."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEEN"
msgid "把那根针拿远一点。"
msgstr "Keep that stinger away from me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "太黏。走不上去。"
msgstr "Too sticky. Can't walk up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "刚才有这个吗。"
msgstr "Was that there before?"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "它是怎么长这么大的。"
msgstr "How did it grow this big."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEESWAX"
msgid "蜂蜡是很可靠的防腐材料。"
msgstr "Beeswax is a reliable preservative."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEESWAX_SPRAY"
msgid "我闻到的是防腐剂吗。"
msgstr "Is that preservative I smell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BEETLETAUR"
msgid "从这里就能闻到他。"
msgstr "I can smell him from here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BELL"
msgid "叮铃铃。"
