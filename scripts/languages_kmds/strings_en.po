msgstr "Busy."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "死了。"
msgstr "Dead."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "他口袋满了，塞不进去。"
msgstr "Their pockets are full. Won't fit."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "睡着了。"
msgstr "Asleep."

