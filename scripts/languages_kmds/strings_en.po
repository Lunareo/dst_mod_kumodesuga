msgid "你不会回嘴。这样很好。"
msgstr "You never talk back. ...How nice."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "照顾生命，比夺走生命安心得多。"
msgstr "Nurturing a life is calmer than taking one."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_THORNS"
msgid "痛。小事。"
msgstr "Pain. ...A small matter."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_THURIBLE_OUT"
msgid "香炉烧完了。"
msgstr "The thurible has burned out."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_ABANDONED"
msgid "自己找吧。……没办法。"
msgstr "Find it myself. ...No helping it."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_DEAD"
msgid "对不起。回家的路，我替你记着。"
msgstr "I am sorry. ...I remember the way home."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "它在叫我。走。"
msgstr "It is calling. ...Let's go."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "被别人先找到了。"
msgstr "Someone else found it first."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "有发现。"
msgstr "A discovery."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
