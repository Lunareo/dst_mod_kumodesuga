msgid "月亮做的怪物。碍眼。"
msgstr "Destroying science has a price."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "像你。但不一样。"
msgstr "Like you. But different."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "他要的应该是这个。"
msgstr "What he wants. ...Surely this."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "这次确实倒下了。"
msgstr "This time, certainly down."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "好像把它激怒了。"
msgstr "It seems I have enraged it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "你的意思我懂了。"
msgstr "I understand what you mean."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "完全被激怒了！"
msgstr "Fully enraged!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "谁去碰它一下，确认一下。"
msgstr "Someone poke it. For confirmation."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "死了？奇怪的能量还残留着。"
msgstr "Dead? Strange energy lingers."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "陷阱。会让人发困。别碰。"
msgstr "Test results. It makes me sleepy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "毁得不够彻底。再来一次。"
msgstr "Destroying science. Isn't that enough?!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.AMULET"
msgid "戴着安心。"
msgstr "Wearing it eases the mind."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCHOR"
msgid "防止船漂走。"
msgstr "It keeps the boat from drifting."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCHOR_ITEM"
msgid "能做锚。"
msgstr "An anchor can be made."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "刚采下来还热着。"
msgstr "Just picked, and still warm."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "在抽动。少吃点好。"
msgstr "It trembles. Less trembling, please."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "至少不抽动了。"
msgstr "At least it stopped twitching."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "既是植物又是石头。有趣。"
msgstr "Plant and mineral both. Fascinating."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "被开采完了。"
msgstr "Mined out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "树。得谨慎处理。"
msgstr "The tree. Handle with care."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "只剩树桩了。"
msgstr "A tree stump."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "在成长！大概？"
msgstr "It's growing! Probably?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "地方合适。但时机没到。"
msgstr "Suitable, but not yet the season."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "养分好像不足。"
msgstr "It seems short on nutrients."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "得种在合适的地方。"
msgstr "It needs planting in a suitable place."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENTTREE_SEED"
msgid "古树的种子。看不出名堂。"
msgstr "No accidents. Only insufficient data."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_ALTAR"
msgid "古代的祭坛。神秘。"
msgstr "An ancient, mystic altar."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "坏掉了。"
msgstr "Broken."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_HUSK"
msgid "这里发生过坏事。"
msgstr "Something bad happened here."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANCIENT_STATUE"
msgid "在动。……和这个世界不同的节奏。"
msgstr "It moves. To a rhythm unlike this world's."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANIMAL_TRACK"
msgid "食物的足迹。"
msgstr "Tracks left by food. I mean, an animal."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTCHOVIES"
msgid "能放回去吗？"
msgstr "May I put them back?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLION.GENERIC"
msgid "想要什么，说吧。我跟你交换。"
msgstr "What do you want. Speak. I shall trade with you."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLION.UNHAPPY"
msgid "生气了。地要陷了，危险。"
msgstr "It's angry. Sinkholes, dangerous."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLION.VERYHAPPY"
msgid "关系良好。暂时安全。"
msgstr "Good relations. Safe."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLIONHAT"
msgid "隔热帽。厉害。"
msgstr "A heat shield hat. Impressive."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ANTLIONTRINKET"
msgid "小玩具。有人会想要。"
msgstr "A trinket. Someone would want it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARAMASA
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARAMASA"
msgid "仿制品……不过八连击的手感，还算能接受。"
msgstr "A replica... though eight hits does feel acceptable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "多脚的虫子。挡不住我。"
msgstr "A centipede. It won't stop me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "一堆旧零件。"
msgstr "A heap of old parts."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "锅被烧了。"
msgstr "The pot was burned."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "还要时间。"
msgstr "It takes time."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "快好了！"
msgstr "Nearly ready!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "能吃了！"
msgstr "Mm! Ready to eat!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "旧锅。该打扫了。"
msgstr "An old pot. Dust it off."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "知识。怎么取出来？"
msgstr "Knowledge. How does one extract it?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "站在旁边就想搭话。"
msgstr "I'd love to stand beside it, chatting about nothing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "有办法让它再转就好了。"
msgstr "If only there were a way to start it again."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "月之像。壮丽。有点心动。"
msgstr "A moon statue. Majestic. My heart stirs."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "故意写得难懂。"
msgstr "Deliberately impenetrable, it seems."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "奇怪。有电，但不动。"
msgstr "Strange. Power flows, but nothing lights."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "完全死了。"
msgstr "Completely dead."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "地图不用，复杂机器倒是用。谜。"
msgstr "No maps, just a complex machine. A mystery."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "该找的都找完了。"
msgstr "Everything worth finding, already found."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "哦！秘密知识的应用。有既视感。"
msgstr "Oh! Secret knowledge, applied. Deja vu."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "知识很多。可惜读不懂。"
msgstr "So much knowledge. A pity I can't read it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "这记号跟遗迹里别的不一样。"
msgstr "The carvings differ from the others in the ruins."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "知识很多。可惜读不懂。"
msgstr "So much knowledge. A pity I can't read it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "这记号跟遗迹里别的不一样。"
msgstr "The carvings differ from the others in the ruins."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "知识很多。可惜读不懂。"
msgstr "So much knowledge. A pity I can't read it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "有种被招待的感觉。"
msgstr "A sense of reception."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "以前是干什么的。现在不动了。"
msgstr "Whatever it did, it does so no longer."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "去哪儿？有意思的地方？"
msgstr "Where are you off to? Somewhere fun?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "槽是空的。"
msgstr "The slot is empty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "宝石供能。古代的机关。"
msgstr "Gem-powered. An ancient mechanism."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORDRAGONFLY"
msgid "耐热的甲。"
msgstr "Hot armor."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORDREADSTONE"
msgid "轻巧又坚固。好看。"
msgstr "Light, sturdy, and pretty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORGRASS"
msgid "草做的甲。里面别有虫。"
msgstr "Grass armor. Bugs not included, I hope."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORMARBLE"
msgid "看起来很重。"
msgstr "Heavy, by the look of it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORRUINS"
msgid "很轻。不可思议。"
msgstr "Light. Unbelievable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORSKELETON"
msgid "骨头做的铠甲。冷……不过我喜欢骨头。"
msgstr "Bone armor. Cold."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORSLURPER"
msgid "湿答答的套装。据说有营养。"
msgstr "A wet suit. Nutritious."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORSNURTLESHELL"
msgid "背上会黏。"
msgstr "It will stick to my back."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORWAGPUNK"
msgid "恐怖的机械。"
msgstr "A terrifying machine."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMORWOOD"
msgid "木甲。普通。"
msgstr "Wood armor. Ordinary."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_BRAMBLE"
msgid "最好的防御就是攻击。"
msgstr "The finest defense is attack."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_CARROTLURE"
msgid "一束胡萝卜。捆得很紧。好。"
msgstr "A carrot bundle. Tight and firm. Good."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_LUNARPLANT"
msgid "这防具挑不出毛病。"
msgstr "This armor has no room left to improve."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "有刺痛感。对敌人也一样。"
msgstr "A stinging thorn. An enemy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_SANITY"
msgid "安全，却让人不安。"
msgstr "Safe, and yet unsettling."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "唉。前面裂了！"
msgstr "Alas. A tear down the front!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "这铠甲。哪儿不对。"
msgstr "A mountain of questions."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "「别玩火柴」。"
msgstr "\"Do not play with matches.\""

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "写着「那边」。"
msgstr "It reads, \"Over there.\""

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "空白的牌子。"
msgstr "A blank sign."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "「别玩火柴」。"
msgstr "\"Do not play with matches.\""

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "写着「那边」。"
msgstr "It reads, \"Over there.\""

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "空白的牌子。"
msgstr "A blank sign."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ASH.GENERIC"
msgid "火留下的遗产。"
msgstr "Fire's legacy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "骨头被传送烧掉了。……可惜了。"
