msgstr "Exceptionally tasty. But they don't keep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "趁没坏之前吃掉。"
msgstr "Eat them before they spoil."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH.BARREN"
