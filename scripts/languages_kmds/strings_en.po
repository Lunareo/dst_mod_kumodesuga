#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
