msgstr "The switch seems broken."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "灯的开关？"
msgstr "A light switch?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VEGGIEOMLET"
msgid "蛋卷。凡人的早饭。"
msgstr "Breakfast. The most scientific meal."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "烂了。可惜。"
msgstr "Rotted. A waste."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VEGSTINGER"
msgid "把芹菜当吸管用？"
msgstr "Use the celery as a straw?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "有点像祖母的衣服。"
msgstr "It resembles grandmother's dress."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH"
msgid "影子们。同一块布。"
msgstr "These shadows. Cut from one cloth."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTHHAT"
msgid "有暗的神秘感。"
msgstr "A dark air of mystery."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "保证会飞回来？"
msgstr "A return guarantee, is there?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_KIT"
msgid "影子的缝纫图。我看得懂。"
msgstr "Sewing with shadows. My knowledge is patchy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "收割太容易了。可怕。"
msgstr "Harvesting made too easy. Terrifying."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "雨会毁我的头发。最讨厌。"
msgstr "My hair, dissolved by acid. I hate it most."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.VOLTGOATJELLY"
msgid "会电嘴的果冻。……刺激。"
msgstr "An electrifying delicacy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAFFLES"
msgid "还要糖浆吗。真难选。"
msgstr "More syrup, or not. I'm torn."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT"
msgid "这铁块。挺唬人。"
msgstr "Charming!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "现在还盖着。"
msgstr "Presently under cover."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "大机器人。小包装。"
msgstr "A big robot. Small package."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "拆成零件了。"
msgstr "In a dismantled state!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "腿掉了。走不动了吧。"
msgstr "It held out for a while!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "被附身了？活该。"
msgstr "Have you tried restarting it?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "有点意思。"
msgstr "Interesting."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_BEACON"
msgid "信标。用来围堵。"
msgstr "A blockade, assisted."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "修不了。零件能回收。"
msgstr "Beyond repair. The parts can be salvaged."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "速度很猛的机器人。"
msgstr "A swift robot."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "该给它转一下。"
msgstr "It should be test-spun."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_PARTS"
msgid "零件。散了一地。"
msgstr "Parts. Rolling forward."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "修好，或者拆成零件。"
msgstr "Repair it. Or salvage the parts."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "会转就算赢了？"
msgstr "If it spins, it wins!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "嗡嗡。一直响。烦。"
msgstr "Buzz, buzz. Unceasing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "该给它转一下。"
msgstr "It should be test-spun."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNKBITS_KIT"
msgid "用机械修机械。凡人真会绕。"
msgstr "A machine repairing machines! Science without limits."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNKHAT"
msgid "脑里的齿轮在转。"
msgstr "Gears in the brain, turning."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_BITS"
msgid "机械的碎片。能拼出怪东西。"
msgstr "Superscientific goods can be made."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "要么是墙，要么什么都没有！"
msgstr "A wall. ...Or none!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "这地板。是什么？"
msgstr "This floor. What is it?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_LEVER"
msgid "切换的好时机。"
msgstr "A fine moment to switch."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "工作台。凡人的玩意儿。"
msgstr "Work, begin!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "奇怪。这手套不是投影。"
msgstr "Strange. This glove isn't a projection."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "这写字板是实物。"
msgstr "This writing tablet. Real."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "垃圾山。也许有发现。"
msgstr "A scrap heap. Perhaps something to find."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "着魔了！发光了！脑子要炸了！"
msgstr "Enchanting! Radiant! Brain-expanding!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_NPC"
msgid "戴眼镜的怪人。吵。"
msgstr "A fellow man of science. I should help him."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "还在忙。真闲不下来。"
msgstr "Science knows no rest."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "要去哪里呢。"
msgstr "Where is he off to."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "这个。就是要找的工具！"
msgstr "This. The tool I seek!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "我知道。只是说明太复杂。"
msgstr "I know it! Only... the explanation is too complicated."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "凡人的工具。看着就麻烦。"
msgstr "An obviously scientific tool."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "直觉告诉我，这就是正解。"
msgstr "Intuition. This is the right tool."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "用途完全理解了！大概。"
msgstr "I understand its use completely! Probably."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAKABA
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAKABA"
msgid "那家伙……跟她说话总觉得会输，讨厌。"
msgstr "That one... talking to her, I always feel I'd lose. I hate it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK"
msgid "跳板。想下水的自己走。"
msgstr "Can't this just be a lifeboat?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "做救生艇不是更好？"
msgstr "Would it not make a better lifeboat?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK_GRASS"
msgid "跳板。想下水的自己走。"
msgstr "Can't this just be a lifeboat?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKINGPLANK_YOTD"
msgid "装饰。心情没变。"
msgstr "Dressing it up changes nothing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALKING_STICK"
msgid "上等的杖。"
msgstr "A first-class cane."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_DREADSTONE"
msgid "安心……？"
msgstr "Reassuring...?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "坏事挡不住吧？"
msgstr "No harm will come of it?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_HAY.BURNT"
msgid "不行了。"
msgstr "No longer any good."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_HAY.GENERIC"
msgid "这样也行吧。"
msgstr "Mm. It will do."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_HAY_ITEM"
msgid "像是个坏主意。"
msgstr "It looks like a poor idea."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_MOONROCK"
msgid "宇宙般光滑！"
msgstr "Cosmic slickness!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "很轻。但很硬。"
msgstr "Light. But hard."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_RUINS"
msgid "古代墙壁的断片。"
msgstr "A fragment of ancient wall."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_RUINS_2"
msgid "古代墙的断片。"
msgstr "A fragment of ancient wall."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_RUINS_ITEM"
msgid "凝固的历史。"
msgstr "A solid chunk of history."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_SCRAP"
msgid "废料做的。"
msgstr "Made of scrap."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_SCRAP_ITEM"
msgid "一捆废料。"
msgstr "It looks like a bundle of scrap."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_STONE"
msgid "好墙。"
msgstr "A good wall."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_STONE_2"
msgid "好墙。"
msgstr "A good wall."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_STONE_ITEM"
msgid "有安心感。"
msgstr "A sense of security."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_WOOD.BURNT"
msgid "焦了！"
msgstr "Charred!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_WOOD.GENERIC"
msgid "尖！"
msgstr "Sharp!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALL_WOOD_ITEM"
msgid "带尖刺的围栏。"
msgstr "A sharp fence."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS"
msgid "海象。天生的捕食者。"
msgstr "A walrus, a natural predator."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUSHAT"
msgid "海象毛做的。"
msgstr "Clad in walrus fur."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "有露营的痕迹。"
msgstr "Traces of a camp remain."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "里面看着挺暖。"
msgstr "It looks warm within."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALRUS_TUSK"
msgid "总会有用的。"
msgstr "A use will arise, surely."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.ATTACKER"
msgid "先锋可不是这样的，%s。"
msgstr "Pioneers don't behave like that. %s."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.FIRESTARTER"
msgid "%s，那不是篝火。"
msgstr "%s, that is no campfire."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.GENERIC"
msgid "少年斥候。帽子太大了。"
msgstr "A boy scout. A big hat."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.GHOST"
msgid "心脏。玩闹之后再说。"
msgstr "A heart. Play afterwards."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.MURDERER"
msgid "%s，故事的素材没了？"
msgstr "%s, out of story material?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTER.REVIVER"
msgid "%s，可靠。这次信你。"
msgstr "%s is reliable. Trusted."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WALTERHAT"
msgid "户外我不擅长。"
msgstr "The outdoors. Not my forte."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.ATTACKER"
msgid "时间和场合都不对，%s。"
msgstr "Wrong time, wrong place. %s."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.FIRESTARTER"
msgid "「时间线」？借口罢了。"
msgstr "'Timelines'? An excuse."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.GENERIC"
msgid "时钟女士。总是很忙。"
msgstr "The clock woman. Busy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.GHOST"
msgid "心脏。快一点。"
msgstr "A heart. Hurry."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.MURDERER"
msgid "第二次机会，没有。"
msgstr "There is no second chance."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDA.REVIVER"
msgid "%s，多亏你。历史没变。"
msgstr "%s, thanks to you, history is unchanged."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "长相奇怪的牛。"
msgstr "A strangely-faced beefalo."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "交易之后。能做朋友吗？"
msgstr "One trade, and we'd count as acquainted?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARDROBE.BURNING"
msgid "烧起来了，快！"
msgstr "It burns, fast!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARDROBE.BURNT"
msgid "过时了。"
msgstr "Out of fashion."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARDROBE.GENERIC"
msgid "又暗又禁忌。适合藏秘密……"
msgstr "Forbidden dark secrets, hidden..."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARG"
msgid "大狗。不好惹。"
msgstr "A big dog. Not to be trifled with."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGCORPSE.BURNING"
msgid "这样最好。"
msgstr "This is for the best."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGCORPSE.GENERIC"
msgid "为什么还是不安。"
msgstr "Why is it still not at peace."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGCORPSE.REVIVING"
msgid "怎么又动了。真难缠。"
msgstr "What is happening. Science can't explain it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGLET"
msgid "有种今天会很麻烦的预感。"
msgstr "I sense a day like this coming."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.BURNING"
msgid "做起来挺愉快。"
msgstr "A well-made thing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.BURNT"
msgid "烧完了。"
msgstr "Burnt to the end."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.EMPTY"
msgid "得放火炬进去。"
msgstr "It wants a torch."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARGSHRINE.GENERIC"
msgid "做起来挺愉快。"
msgstr "A well-made thing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.ATTACKER"
msgid "灾难般的食谱。"
msgstr "A recipe for disaster."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.FIRESTARTER"
msgid "全都烧起来了。厨房完了。"
msgstr "Every flame. The kitchen is finished."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.GENERIC"
msgid "厨师。料理很期待——我会好好用你的。"
msgstr "A chef. I look forward to his cooking.... I'll make use of you."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.GHOST"
msgid "幽灵辣椒吃多了吧。"
msgstr "Too many ghost peppers?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.MURDERER"
msgid "想把我做成半熟？没门。"
msgstr "A half-baked plan. No chance."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WARLY.REVIVER"
msgid "%s，连救人都像在烹调。"
msgstr "%s, always planning his cooking."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAR_BLUEPRINT"
msgid "勇猛的设计。"
msgstr "A valiant design."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WASPHIVE"
msgid "蜂正在生气。"
msgstr "The wasps are in a fury."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERBALLOON"
msgid "水球。不错。"
msgstr "A water balloon. Not bad."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERINGCAN.EMPTY"
msgid "附近有池子就好了。"
msgstr "A pond nearby would do."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERINGCAN.GENERIC"
msgid "浇水用。"
msgstr "For watering."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON"
msgid "又粘又甜。"
msgstr "Sticky, sweet."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELONHAT"
msgid "汁顺着脸流。夏季限定。"
msgstr "Juice running down the face. Summer only."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELONICLE"
msgid "西瓜做的冰。"
msgstr "Watermelon ice."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON_COOKED"
msgid "汁是温的。"
msgstr "Warm juice."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON_OVERSIZED"
msgid "大西瓜。汁很多。"
msgstr "A big watermelon. Full of juice."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERMELON_SEEDS"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT"
msgid "藤壶不采。友好继续。"
msgstr "Don't touch their barnacles, and the friendship holds."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT_BABY"
msgid "这还只是苗。"
msgstr "This one is still a sprout."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT_BOMB"
msgid "正在被攻击！"
msgstr "Under attack!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPLANT_PLANTER"
msgid "长在海里的岩石上。看着挺好。"
msgstr "On the sea rocks. Growing nicely."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERPUMP"
msgid "灭火。高效。"
msgstr "Firefighting. Highly efficient."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERTREE_PILLAR"
msgid "树，巨大！"
msgstr "A tree. Enormous!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATERTREE_ROOT"
msgid "树根。粗得过分。"
msgstr "A root. Nothing to do with mathematics."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s，那拳头我躲得开……大概。"
msgstr "%s, dodge that fist. Try to."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "%s，好热。"
msgstr "%s, hot, isn't it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.GENERIC"
msgid "女武神。歌剧吵死了。"
msgstr "A valkyrie. The opera is deafening."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.GHOST"
msgid "去英灵殿还早呢，%s。"
msgstr "Valhalla can wait. %s."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.MURDERER"
msgid "狂战士。敌人。"
msgstr "A berserker. An enemy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s，连灵魂都能支配？厉害。"
msgstr "%s commands souls. Impressive."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHRHAT"
msgid "豪华的帽子。"
msgstr "A luxurious hat."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "薇格弗丽。有指挥经验？还是直觉。"
msgstr "Wigfrid. Leadership experience? Or pure instinct."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WATHGRITHR_SHIELD"
msgid "守护我！！"
msgstr "Protect me!!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXED_PLANT"
msgid "打了蜡的植物。永远不会枯。"
msgstr "It has frozen in fear."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXPAPER"
msgid "蜡纸。"
msgstr "Wax paper."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.ATTACKER"
msgid "绅士的皮，掉了。"
msgstr "A gentleman, graduated."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "%s，想被烤焦吗。"
msgstr "%s, would you like to be roasted?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.GENERIC"
msgid "自称绅士？哪里像。"
msgstr "Calls himself a gentleman? Where?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.GHOST"
msgid "那种眼神……去把心脏找回来。"
msgstr "That look.... A heart, go find one."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.MURDERER"
msgid "魔术师。我的敌人。"
msgstr "A magician. An enemy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELL.REVIVER"
msgid "力量总算用对方向了。"
msgstr "Strength, used in the right direction."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "真奇怪。"
msgstr "Strange."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELLJOURNAL.NEEDSFUEL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WAXWELLJOURNAL.NEEDSFUEL"
msgid "only_used_by_waxwell"
msgstr "only_used_by_waxwell"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.ATTACKER"
msgid "小孩子。这次饶你。"
msgstr "A child. I'll let it pass, this time."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.FIRESTARTER"
msgid "玩火的规矩，得开个会。"
msgstr "Fire safety. We should hold a meeting."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.GENERIC"
msgid "小孩跟蜘蛛合体了。稀奇。"
msgstr "A child. Merged with a spider. Rare."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.GHOST"
msgid "快去找心脏。眼泪用蛛网可擦不掉。"
msgstr "A heart, quickly. Spiderwebs cannot wipe away tears."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.MURDERER"
msgid "就算是小孩，也是敌人。"
msgstr "A child too. An enemy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER.REVIVER"
msgid "大家玩得挺好，%s。"
msgstr "Everyone plays well together. %s."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBERSKULL"
msgid "孩子的骷髅……该好好下葬。"
msgstr "A child. Deserves a proper burial."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "这些小家伙今天算友军。……不过是主人的亲戚，加分。"
msgstr "A spider squad. Allied today. Odd.... Master's relatives earn points."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEED_IVY"
msgid "喂。这不是蔬菜。"
msgstr "Hey. You're not a vegetable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.ATTACKER"
msgid "%s，手上没拿利器吧。……吧？"
msgstr "%s isn't carrying anything sharp... right?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.FIRESTARTER"
msgid "%s，火。我知道了。"
msgstr "%s, the fire. I know."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.GENERIC"
msgid "阴沉沉的小鬼。我不喜欢阴沉的家伙……才怪。"
msgstr "A gloomy little thing. I dislike gloomy.... As if."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.GHOST"
msgid "两个幽灵？不对。快去找心脏。"
msgstr "Twice? No. A heart, quickly."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.MURDERER"
msgid "杀人犯。"
msgstr "Murderer."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY.REVIVER"
msgid "%s，把幽灵当家人啊。"
msgstr "%s treats her ghost as family."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "坟墓。……看着居然安心。"
msgstr "Inexplicably reassured."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEREITEM_BEAVER"
msgid "北方的东西。那儿的规矩不一样。"
msgstr "The north. Science by different rules."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEREITEM_GOOSE"
msgid "起一身鸡皮。"
msgstr "The goosebumps stood up."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WEREITEM_MOOSE"
msgid "被诅咒的普通驼鹿。"
msgstr "An ordinarily cursed moose."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.ATTACKER"
msgid "一句话都不说，却很危险。"
msgstr "Silent. But dangerous."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.FIRESTARTER"
msgid "不用说。我知道。"
msgstr "No need to speak. I know."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.GENERIC"
msgid "哑剧演员。一句话都不说。无趣。"
msgstr "A mime. Quiet.... The least annoying of them."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.GHOST"
msgid "心脏。手势我可看不懂。"
msgstr "A heart. Gestures won't convey it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.MURDERER"
msgid "用手势杀人？敌人就是敌人。"
msgstr "Murder by gesture. An enemy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WES.REVIVER"
msgid "看不见的箱子外面。发想不错。"
msgstr "Thinking outside the invisible box. Clever."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WETGOOP"
msgid "没味道。"
msgstr "Tasteless."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WETPAPER"
msgid "快点干啊。求你了。"
msgstr "Dry quickly. Please."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WETPOUCH"
msgid "袋子快散了。"
msgstr "The pouch is nearly falling apart."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WHIP"
msgid "响一声就能镇住场。……这可是我的得意领域。"
msgstr "A cracking sound to keep order.... My specialty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s，书扔过来之前先跑。"
msgstr "%s, run before the book comes flying."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "总有理由的吧，%s。"
msgstr "There's a reason, isn't there. %s."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "图书管理员。博学……不过还差我一截。"
msgstr "The librarian. Learned. Almost as much as Merazophis."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "快去找心脏。%s，别乱飘。"
msgstr "A heart, go quickly. %s, stop drifting about."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "连老妇人都成了敌人？真让人叹气。"
msgstr "The old woman. An enemy. A sigh."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "%s，这次像样。稍微表扬你。"
msgstr "%s, decent this time. I'll praise you a little."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.WILLOW.ATTACKER"
