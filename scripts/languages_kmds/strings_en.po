msgstr "Fire-fighting. ...Efficient."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERTREE_PILLAR"
msgid "好大一棵树！"
msgstr "A tree. Enormous!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATERTREE_ROOT"
msgid "根，跟算数没关系。"
msgstr "Roots. ...Unrelated to mathematics."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s……那一拳，躲得开吗。"
msgstr "%s... Dodge the fists. ...If I can."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "%s……好热。"
msgstr "%s... Hot."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.GENERIC"
msgid "女武神。歌声有点吵。"
msgstr "A valkyrie. ...Her opera is loud."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.GHOST"
msgid "去英灵殿还太早。%s。"
msgstr "Valhalla can wait. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.MURDERER"
msgid "狂战士。那就是敌人。"
msgstr "A berserker. ...An enemy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s……连灵魂都听她的。厉害。"
msgstr "%s... Commands souls. ...Impressive."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHRHAT"
msgid "很豪华的头盔。"
msgstr "A luxurious hat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "那位女武神……带过兵吗？……还是全凭直觉。"
msgstr "Wigfrid. ...Command experience? ...Or instinct."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WATHGRITHR_SHIELD"
msgid "护住我！！"
msgstr "Guard me!!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXED_PLANT"
msgid "定住了。"
msgstr "It has frozen in fear."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXPAPER"
msgid "蜡纸。"
msgstr "Wax paper."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.ATTACKER"
msgid "这不像绅士该做的事。"
msgstr "Time to graduate from being a gentleman."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "%s……想把人烤焦吗。"
msgstr "%s... Do you mean to be roasted."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.GENERIC"
msgid "自称绅士的人。我不置评。"
msgstr "A gentleman? ...So he styles himself."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.GHOST"
msgid "那种眼神……先去找心脏吧。"
msgstr "Those eyes... A heart. Fetch one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.MURDERER"
msgid "魔术师。那就是敌人。"
msgstr "A magician. ...An enemy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELL.REVIVER"
msgid "那份力量，用对了地方。"
msgstr "Power aimed in the right direction."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "很怪。"
msgstr "Strange."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELLJOURNAL.NEEDSFUEL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAXWELLJOURNAL.NEEDSFUEL"
msgid "only_used_by_waxwell"
msgstr "only_used_by_waxwell"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.ATTACKER"
msgid "是孩子。这次就算了。"
msgstr "A child. ...Spare him this time."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.FIRESTARTER"
msgid "用火的规矩，得好好谈一谈。"
msgstr "The rules of fire... will need a meeting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.GENERIC"
msgid "孩子。和蜘蛛合为一体。罕见。"
msgstr "A child. ...Fused with a spider. ...Rare."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.GHOST"
msgid "心脏。蛛网抹不干眼泪。"
msgstr "A heart. ...Spider silk dries no tears."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.MURDERER"
msgid "就算是孩子，也是敌人。"
msgstr "Even a child... an enemy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER.REVIVER"
msgid "大家都玩得来。%s。"
msgstr "Everyone plays well together. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBERSKULL"
msgid "孩子的遗骸。该正式下葬。"
msgstr "A child. ...He deserves a proper burial."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "一队蜘蛛。今天是友军。心里复杂。"
msgstr "A spider squad. ...Allies, today. ...A delicate matter."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEED_IVY"
msgid "喂，你不是菜。"
msgstr "Hey. ...You are no vegetable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.ATTACKER"
msgid "%s……手上没有利器吧。……应该没有。"
msgstr "%s... Surely unarmed. ...Surely."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.FIRESTARTER"
msgid "%s……火。我知道了。"
msgstr "%s... Fire. ...Understood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.GENERIC"
msgid "总带着悲伤的孩子。让人放不下。"
msgstr "Always so sorrowful... Is she the same age as her elder sister."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.GHOST"
msgid "两个幽灵？不。先找心脏。"
msgstr "Seeing double? No. ...A heart. Quickly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.MURDERER"
msgid "杀人犯。"
msgstr "A murderer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY.REVIVER"
msgid "%s……对她来说，幽灵也是家人。"
msgstr "%s... Ghosts are family to her."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "莫名安心。"
msgstr "Inexplicably reassured."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEREITEM_BEAVER"
msgid "北边，另有一套规矩。"
msgstr "Science has different rules up north."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEREITEM_GOOSE"
msgid "起了一身鸡皮。"
msgstr "The goosebumps stood up."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WEREITEM_MOOSE"
msgid "被咒过的鹿。"
msgstr "An ordinarily cursed moose."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.ATTACKER"
msgid "一言不发。但很危险。"
msgstr "Silent. ...But dangerous."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.FIRESTARTER"
msgid "不用说。我知道。"
msgstr "No need to speak. ...I know."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.GENERIC"
msgid "哑剧师。安静，很好。"
msgstr "A mime. ...Quiet. ...Good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.GHOST"
msgid "心脏。手势传不到那边。"
msgstr "A heart. ...Gestures will not do."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.MURDERER"
msgid "用手势杀人。那就是敌人。"
msgstr "Kills with gestures alone. ...An enemy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WES.REVIVER"
msgid "看不见的箱子外面。他有他的想法。"
msgstr "Out of the invisible box. ...He has ideas."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WETGOOP"
msgid "没有味道。"
msgstr "Tasteless."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WETPAPER"
msgid "快干了。希望如此。"
msgstr "Nearly dry. ...I hope."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WETPOUCH"
msgid "包快散了。"
msgstr "The pouch is nearly falling apart."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WHIP"
msgid "响一声就能吓住。"
msgstr "Its crack intimidates."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s……书扔过来之前，先退开。"
msgstr "%s... Before the books start flying. ...Run."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "总有她的理由吧。"
msgstr "There is a reason, surely. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "图书管理员。博学之人。"
msgstr "A librarian. ...Learned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "这不科学。先找心脏。%s。"
msgstr "Not science. ...A heart. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "连这位老太太也成了敌人。可叹。"
msgstr "An old woman. ...An enemy. ...I sigh."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "%s……那份学识，值得尊敬。"
msgstr "%s... Theory worthy of respect."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.ATTACKER"
msgid "%s……打火机握紧了。不妙。"
msgstr "%s... Gripping that lighter. ...Not good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.FIRESTARTER"
msgid "又放火了。"
msgstr "Setting fires again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.GENERIC"
msgid "火柴少女。"
msgstr "The girl with the matches."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.GHOST"
msgid "心脏。她急得要烧起来了。%s。"
msgstr "A heart. ...Quickly, before the burning. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.MURDERER"
msgid "杀人放火。不能放着。"
msgstr "Murder, and arson."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW.REVIVER"
msgid "幽灵的朋友。%s。"
msgstr "A friend to ghosts. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW_EMBER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILLOW_EMBER"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.ATTACKER"
msgid "科学救不了你。"
msgstr "Science will not save you."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.FIRESTARTER"
msgid "烧东西可不行。%s。"
msgstr "You cannot go about burning things. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.GENERIC"
msgid "胡子绅士。一张科学家的脸。"
msgstr "A bearded gentleman. ...The face of a scientist."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.GHOST"
msgid "得快点找心脏。"
msgstr "A heart. ...Quickly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.MURDERER"
msgid "敌人。科学也帮不了他。"
msgstr "An enemy. ...Science will not help here either."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WILSON.REVIVER"
msgid "把理论付诸实践了。了不起。%s。"
msgstr "Theory put into practice. ...Admirable. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINCH.GENERIC"
msgid "急的时候有用。"
msgstr "Useful in a pinch."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "捞到了什么？"
msgstr "What was caught?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "重活交给它。"
msgstr "Leave the heavy work to it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.ATTACKER"
msgid "%s……这是安全隐患。"
msgstr "%s... A safety hazard."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.FIRESTARTER"
msgid "工厂失火了。"
msgstr "A factory fire."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.GENERIC"
msgid "工程师。有她在，方便得多。"
msgstr "An engineer. ...Handy to have nearby."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.GHOST"
msgid "扳手和图纸，都停下了。"
msgstr "The wrench plan has collapsed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.MURDERER"
msgid "到此为止吧。%s。"
msgstr "It ends here. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA.REVIVER"
msgid "%s……可靠。感谢。"
msgstr "%s... Dependable. ...My thanks."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "着火了！"
msgstr "Aflame!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "救不回来了。"
msgstr "Beyond saving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "喂！这已经不是学问了！"
msgstr "Hey! ...This is not science!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "快关掉。"
msgstr "Shut it down, quickly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "学问赢了法术。"
msgstr "Science prevails over magic."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
msgid "快炸了！"
msgstr "It will explode, quickly!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "着火了！"
msgstr "Aflame!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "救不回来了。"
msgstr "Beyond saving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "像是学问。原理是什么。"
msgstr "It resembles science. ...The principle?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "电力低了。"
msgstr "Power is low."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "忙的时候我能修。"
msgstr "I could fix it, when free."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "着火了！"
msgstr "Aflame!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "救不回来了。"
msgstr "Beyond saving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "自动的防御装置。"
msgstr "An automated defense."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "要电。"
msgstr "It wants power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.SLEEP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_CATAPULT.SLEEP"
msgid "自动的防御装置。"
msgstr "An automated defense."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_HOLOTELEBRELLA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_HOLOTELEBRELLA"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_HOLOTELEPAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_HOLOTELEPAD"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_MACHINEPARTS_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_MACHINEPARTS_1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_MACHINEPARTS_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_MACHINEPARTS_2"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_RECIPESCANNER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_RECIPESCANNER"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_REMOTE.CHARGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_REMOTE.CHARGED"
msgid "按钮好像没接线。"
msgstr "It seems the button forgot its wiring."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_REMOTE.CHARGING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_REMOTE.CHARGING"
msgid "按钮好像没接线。"
msgstr "It seems the button forgot its wiring."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WINONA_REMOTE.GENERIC"
msgid "按钮好像没接线。"
