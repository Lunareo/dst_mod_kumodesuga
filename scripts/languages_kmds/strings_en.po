msgstr "Sodium salty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "要些时候。"
msgstr "Drying takes time."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
