msgstr "It's on the small side."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_4"
