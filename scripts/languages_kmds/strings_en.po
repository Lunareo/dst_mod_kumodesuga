msgstr "Better than dark."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.HIGH"
msgid "烧得过头啦～"
msgstr "Too much fire."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.LOW"
msgid "火小了哟～"
msgstr "Fire is low."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.NORMAL"
msgid "这样正好～"
msgstr "Just right."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIRE.OUT"
msgid "结束咯～"
msgstr "The end."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "快灭了哟～加点柴～"
msgstr "Dying down, add fuel."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "总比黑漆漆的好～"
msgstr "Better than dark."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.HIGH"
msgid "有围栏真是让人放心呢～"
msgstr "Good thing there's a fence."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.LOW"
msgid "火小了哟～"
msgstr "Fire is low."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "这样正好～"
msgstr "Just right."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLDFIREPIT.OUT"
msgid "还能再点起来的～"
msgstr "It can be relit."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COLLAPSEDCHEST"
msgid "物理法则被弯掉了呀～"
msgstr "The laws of physics, bent."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.E"
msgid "东边～"
msgstr "East."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.GENERIC"
msgid "现在朝着哪边呢～"
