msgstr "Wormwood urged me to eat it, I declined."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.CONSTRUCTION_PLANS"
msgid "设计图～有图纸就不用动脑子，最省事啦～"
msgstr "Construction plans, useful, useful~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COOKBOOK"
