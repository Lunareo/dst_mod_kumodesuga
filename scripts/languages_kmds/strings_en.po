#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "雨该停了。"
msgstr "Rain, stop."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "说晒干不太准确。"
msgstr "Drying, loosely speaking."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK.GENERIC"
msgid "把肉晒在这儿。"
msgstr "Meat, drying."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "架子烧干了。"
msgstr "The rack itself dried out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "肉干时间！"
msgstr "Jerky time!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "这不叫肉干。叫风干。"
msgstr "In academic terms... \"air-dried\"."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "肉要干还得等。"
msgstr "Jerkying takes time."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "下雨会更久。"
msgstr "The rain makes it longer."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "雨啊雨。请走开。"
msgstr "Rain, rain. Go away."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "「干燥」不够精确。"
msgstr "Drying, imprecisely."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "该挂肉了。"
msgstr "Time to hang the meat."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "我努力干过了。"
msgstr "It dried with effort."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "架子干透了。"
msgstr "The rack itself dried out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "肉干时间！"
msgstr "Jerky time!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "这不叫肉干。叫风干。"
msgstr "In academic terms... \"air-dried\"."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "盐。咸得很。"
msgstr "Sodium salty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "干燥需要时间。"
msgstr "Drying takes time."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "雨天。要更久。"
msgstr "Rainy days. It takes longer."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "雨啊雨。请走开。"
msgstr "Rain, rain. Go away."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "算干燥吗？勉强。"
msgstr "Drying, imprecisely."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "适合干燥的季节。"
msgstr "Drying season."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEATYSALAD"
msgid "沙拉。意外地饱。"
msgstr "A salad. Surprisingly filling."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEAT_DRIED"
msgid "肉干。刚好。"
msgstr "Jerky, just right."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MEGAFLARE"
msgid "点火……让所有人都知道。所有人。"
msgstr "Light it... everything knows. Everything."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM"
msgid "鱼腥味！臭！"
msgstr "Fish-stench!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMARMORHAT"
msgid "鱼人用的。不合我。"
msgstr "For merms. It doesn't fit me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "鱼人用的。不合我。"
msgstr "For merms. It doesn't fit me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMCORPSE.BURNING"
msgid "恶臭。最差。"
msgstr "The stench, at its worst."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMCORPSE.GENERIC"
msgid "鱼人死了。"
msgstr "A merm, dead."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMCORPSE.REVIVING"
msgid "死鱼人苏醒了！"
msgstr "A dead merm, stirring!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMGUARD"
msgid "监视的感觉很强。"
msgstr "A strong sense of surveillance."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMGUARD_LUNAR"
msgid "鱼人进化的下一阶段。"
msgstr "The merm's next stage of evolution."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMGUARD_SHADOW"
msgid "只剩从前的影子。"
msgstr "Only the shadow of what it was."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHAT"
msgid "终于。这脸能见人了。"
msgstr "Finally. I can show my face in public."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHEAD.BURNT"
msgid "烧了反而更臭。"
msgstr "Burnt, and fouler."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHEAD.GENERIC"
msgid "今天最臭的东西。"
msgstr "Today's foulest."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE.BURNT"
msgid "住处没了。"
msgstr "The dwelling is gone."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE.GENERIC"
msgid "谁住在这里？"
msgstr "Who lives here?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "好臭！"
msgstr "Mm, the stench!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "意外地可爱。"
msgstr "Surprisingly cute."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMKING"
msgid "陛下！"
msgstr "Your Majesty!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE.BURNT"
msgid "王座。本来就一股鱼臭。"
msgstr "A throne. It smelled of fish from the start."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE.GENERIC"
msgid "沼王的王座。"
msgstr "A throne for the marsh king."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "用途永远不明了吧。"
msgstr "Its use will forever remain a mystery."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "她在计划什么？"
msgstr "What is she planning?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "没有王的近卫。"
msgstr "The royal guard, without a king."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "有王了。看着挺高兴。"
msgstr "They have a king. They look delighted."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_ARMORY"
msgid "上面写着「鱼人专用」。"
msgstr "It says \"merms only\"."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "上面写着「鱼人专用」。"
msgstr "It says \"merms only\"."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_LUNAR"
msgid "鱼人进化的下一阶段。"
msgstr "The merm's next stage of evolution."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_PRINCE"
msgid "先来先得的制度。"
msgstr "First come, first served."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_SHADOW"
msgid "只剩从前的影子。"
msgstr "Only the shadow of what it was."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOL"
msgid "万能。但笨拙。"
msgstr "It does everything. Badly."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOLSHED"
msgid "鱼人的工具棚。里面别指望有好东西。"
msgstr "Inside. Nothing scientific to expect."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "鱼人的工具棚。里面别指望有好东西。"
msgstr "Inside. Nothing scientific to expect."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "这工具。一股鱼臭。"
msgstr "This tool. A fishy odor."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MESSAGEBOTTLE"
msgid "给我的信？"
msgstr "A letter, for me?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "空瓶。里面是虚无。"
msgstr "An empty bottle. Void within."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "烧了。省事。"
msgstr "No more aching muscles, ever."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "锻炼肌肉的东西。我不需要。"
msgstr "Just looking strains my muscles."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MILKYWHITES"
msgid "呕。"
msgstr "Revolting."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINERHAT"
msgid "手能空出来的灯。"
msgstr "A lamp that frees the hands."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINIBOATLANTERN"
msgid "灯在水上浮着。"
msgstr "A floating lamp."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINIFAN"
msgid "风从后面出来。给我扇。"
msgstr "The wind comes from behind. Fan me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINIFLARE"
msgid "点火……让大家知道我在这儿。"
msgstr "Light it... everyone knows I am here."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINISIGN.GENERIC"
msgid "画得再好一点会更好。"
msgstr "It could be drawn better."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINISIGN.UNDRAWN"
msgid "得画点什么上去。"
msgstr "Something should be drawn on it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINISIGN_ITEM"
msgid "先立起来吧。"
msgstr "Set it upright first."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINOTAUR"
msgid "一脸不高兴。……跟我一样。"
msgstr "A displeased face."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINOTAURCHEST"
msgid "里面是惊喜？还是恐怖。"
msgstr "A surprise inside? Or horrors."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MINOTAURHORN"
msgid "没被顶飞，算我运气好。"
msgstr "Not gored. Lucky."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MITEGLAND.COLD"
msgid "变冷了。"
msgstr "It has grown cold."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MITEGLAND.GENERIC"
msgid "螨。不是只会喷气。"
msgstr "Mites. They don't merely spit gas."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MITEGLAND_COOKED"
msgid "煮过了。真要吃？"
msgstr "Boiled. Do I truly want to eat it?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLE.ABOVEGROUND"
msgid "鼹鼠。好想敲一下。"
msgstr "A mole. I want to tap it. I do."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLE.HELD"
msgid "没地方挖了。忍一下。"
msgstr "Nowhere left to dig. Endure it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLE.UNDERGROUND"
msgid "地下有东西。在找矿物吧。"
msgstr "Something underground. It digs for minerals."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEBAT"
msgid "会飞的鼠。吸血鬼。……同行见同行。"
msgstr "A mole bat. A vampire.... It takes one to know one."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEBATHILL"
msgid "巢里藏了什么？"
msgstr "Inside the den. What's hidden?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEHAT"
msgid "臭。但视野很好。"
msgstr "Smelly. But the vision is superb."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MOLEHILL"
msgid "洞。有点像家。"
msgstr "A hole. It feels like home."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEY"
msgid "好奇心过剩的家伙。"
msgstr "A curious fellow."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYBARREL"
msgid "刚才动了？"
msgstr "Did it move?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYHUT.BURNT"
msgid "烧了。我说过火很危险。"
msgstr "Called it!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYHUT.GENERIC"
msgid "树上的家。火很危险。"
msgstr "A tree house. A fire hazard."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "进不去。只会往外吐东西。"
msgstr "Nothing gets in. Things only come out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "机械。有既视感。"
msgstr "A machine. Deja vu."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYPILLAR"
msgid "柱子。这岛的支柱。"
msgstr "A pillar. The island's pillar."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYQUEEN"
msgid "猴子女王。这里的老大。"
msgstr "The monkey queen. The boss here."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEYTAIL"
msgid "猴子的尾巴。……谁要吃这个。"
msgstr "Edible? An experiment is required."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "像船长。帅。"
msgstr "Like a captain. Dashing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONKEY_SMALLHAT"
msgid "至少头发不会湿。"
msgstr "At least my hair stays dry."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.MONSTERLASAGNA"
msgid "对料理的冒犯。"
