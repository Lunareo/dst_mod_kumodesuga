msgstr "For emergencies."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATPATCH_KELP"
