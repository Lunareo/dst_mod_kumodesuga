#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "烧得很旺。"
msgstr "Burning fiercely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "看着病得不轻。"
msgstr "Looks very sick."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
