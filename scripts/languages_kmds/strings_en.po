msgstr "Little remains."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATFRAGMENT05"
msgid "没剩下多少残骸。"
msgstr "Little remains."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATPATCH"
msgid "为灾难做准备。"
msgstr "Disaster preparedness."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATPATCH_KELP"
msgid "暂时将就。"
msgstr "A stopgap, for now."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "检查点！"
msgstr "A checkpoint!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "清单上又多一项。"
msgstr "One item, added to the checklist."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "被盯上了！"
msgstr "I am being marked!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK"
msgid "浮标。又是浮标。"
msgstr "A buoy. And another buoy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "浮标。又是浮标。"
msgstr "A buoy. And another buoy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "浮标。又是浮标。"
msgstr "A buoy. And another buoy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "浮标。又是浮标。"
msgstr "A buoy. And another buoy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "声援。我也热起来了。"
msgstr "Its cheering warms me up."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_START"
msgid "总得有个起点。"
msgstr "Every course has a start."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "起点在哪儿？"
msgstr "A start, where?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "「货物」。船员的用语。就是「东西」。"
msgstr "\"Cargo\". Sailor's word for \"stuff\"."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "看来是旧式的做法。"
msgstr "The old ways, it seems."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "船。王冠的荣耀。"
msgstr "My boat. The crown's glory."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "预定给船装护舷。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_KELP"
msgid "不能全防住。有点用的程度。"
msgstr "It can't protect everything. Somewhat useful."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "预定给船装护舷。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "贝壳做的防御。"
msgstr "A defense of shells."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "预定给船装护舷。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "撞龙船。会被角顶。"
msgstr "Mess with a dragon boat, meet the horns."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "预定给船装护舷。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "炮能发射了！"
msgstr "The cannon, ready to fire!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "该装弹药了。"
msgstr "Ammunition should be loaded."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "没弹药。快装上。"
msgstr "I didn't forget. I'm letting the anticipation build."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_CANNON_KIT"
msgid "还不算炮。即将。"
msgstr "Not a cannon yet. It will be."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_GRASS_ITEM"
msgid "姑且算是船。"
msgstr "A boat, provisionally."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ITEM"
msgid "船。想试试出海。"
msgstr "A boat. I'd like to try the sea."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_LEAK"
msgid "沉之前补上。"
msgstr "Patch it before it sinks."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "动了！当然在我预料内。"
msgstr "It works! Naturally, I expected it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "会互相吸。原理不重要。"
msgstr "Attracted to physics. The word escapes me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "磁力！"
msgstr "Magnetism!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "附近有强磁铁。会被吸走。"
msgstr "Nearby magnets will be drawn in."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_MAGNET_KIT"
msgid "好点子。当然是我想的。"
msgstr "A genius idea. I may brag."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ROTATOR"
msgid "方向正确。也许该往左。"
msgstr "The right direction. Or possibly left."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "该试着转一下。"
msgstr "It should be test-spun."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "牛毛。臭味还在。"
msgstr "Beefalo fur. The smell lingers."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_KELP"
msgid "太湿了。"
msgstr "Damp beyond reason."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_PETALS"
msgid "比牛毛的香。"
msgstr "Fragrant, unlike the beefalo wool pillow."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "谁会睡这个？"
msgstr "Who sleeps on this?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOMB_LUNARPLANT"
msgid "植物做的炸弹。扔出去很痛快。"
msgstr "Botany and chemistry, in concert."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "沃姆伍德。好像觉醒了月之力。"
msgstr "Wormwood. Awakening to the moon's power, it seems."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BONESHARD"
msgid "骨头碎片。……酥脆的？别诱惑我。"
msgstr "A bone shard.... Crunchy?... You dare tempt me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BONESOUP"
msgid "骨头汤。……脆的部分归我。"
msgstr "Bone soup.... The crunchy parts are mine."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BONESTEW"
msgid "骨头汤。有营养。"
msgstr "Bone soup. Nutritious."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOKSTATION.BURNT"
msgid "图书馆闭馆了。"
msgstr "The library is closed."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOKSTATION.GENERIC"
msgid "书架。知识收下了——我可是很好学的。"
msgstr "A bookshelf. Knowledge, I'll take it. I am quite studious."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_BEES"
msgid "蜂的书。嗡嗡，吵。"
msgstr "A book of bees. Buzz, buzz. Loud."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_BIRDS"
msgid "鸟的书。叽叽喳喳，吵。"
msgstr "A book of birds. Chirp, chirp. Loud."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_BRIMSTONE"
msgid "开头无聊，结尾不错。"
msgstr "Dull opening. Good ending."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_ELEMENTAL"
msgid "文字看不懂。"
msgstr "The script is unreadable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_FIRE"
msgid "火的书。没什么迫切感。"
msgstr "A book of fire. No urgency to it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_FISH"
msgid "钓鱼书。鱼可不上钩。"
msgstr "A fishing book. The fish aren't biting."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_FOSSIL"
msgid "能把怪物拘住一小会儿。"
msgstr "It binds monsters, briefly."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_GARDENING"
msgid "园艺书。土比书重要。"
msgstr "A gardening book. The soil matters more."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_HORTICULTURE"
msgid "园艺书。翻过了。"
msgstr "A gardening book. Already read it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "看草生长。跟之前一样。"
msgstr "Watching grass grow. The same."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_LIGHT"
msgid "光的书。写的人真亮眼。"
msgstr "A book of light. Its author shines."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "亮。非常亮。"
msgstr "Bright. Very."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_MOON"
msgid "月亮的书。一时的流行。"
msgstr "A book of the moon. A passing fad."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_RAIN"
msgid "雨的书。念一念就下雨？省了我的魔法。"
msgstr "A rain book. Chant it and it rains? Saves my own magic."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "那位老太太倒是很守规矩。"
msgstr "A rule-abiding old woman."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_SILVICULTURE"
msgid "造林的书。嗯，还行。"
msgstr "A forestry book. Mm."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_SLEEP"
msgid "五百页的电报码。催眠效果一流。"
msgstr "Five hundred pages of telegraph code. A sedative."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_TEMPERATURE"
msgid "温度的书。不冷不热。"
msgstr "A book of temperature. Lukewarm, like its content."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_TENTACLES"
msgid "触手的书。谁读谁上钩。"
msgstr "A book of tentacles. Read it and you're hooked."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOK_WEB"
msgid "蛛网教材。织法太业余了。"
msgstr "Spiderweb textbook. Amateur weaving."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOMERANG"
msgid "空气力学的产物。"
msgstr "Aerodynamics."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BOOTLEG"
msgid "某个海盗少了一只战利品。"
msgstr "Some pirate. One boot short of his loot."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BROKEN_FORGEDITEM"
msgid "坏了。看样子能修。"
msgstr "Broken. Repairable, it seems."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "够热。能熔接。"
msgstr "Hot enough, and it can be welded back."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BRUSH"
msgid "牛喜欢这个。"
msgstr "The beefalo like this."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUGNET"
msgid "捕虫网。"
msgstr "A bug net."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "嗯，昆布。"
msgstr "Mm, kelp."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "采完了。"
msgstr "All harvested."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BULLKELP_ROOT"
msgid "深水里也能种。"
msgstr "It can be planted in deep water."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNDLE"
msgid "补给都在里面。"
msgstr "Supplies within."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNDLEWRAP"
msgid "打包好了，好搬。"
msgstr "Bundled for carrying."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNNYMAN"
msgid "兔人。当心胡萝卜。"
msgstr "A bunnyman. Mind the carrots."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUNNYSTEW"
msgid "运气用尽了。"
msgstr "My luck has run out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "全焦了。"
msgstr "All charcoal."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUSHHAT"
msgid "扎人。"
msgstr "Prickly."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTER"
msgid "黄油。居然是真的。"
msgstr "Butter. Genuinely."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "蝴蝶在飞。"
msgstr "A butterfly, flying."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLY.HELD"
msgid "抓到了。"
msgstr "Caught it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "蝴蝶松饼。甜。"
msgstr "A butterfly muffin. Sweet."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUTTERFLYWINGS"
msgid "翅膀。很轻。"
msgstr "Wings. Light."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUZZARD"
msgid "秃鹫。在盘旋。"
msgstr "A buzzard. Circling."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "烧成火鸟了。"
msgstr "A firebird, complete."

