msgstr "I smell something burning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "我看见漂浮物。"
msgstr "I see flotsam."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANWHIRLPORTAL"
