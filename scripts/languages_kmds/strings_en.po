msgstr "Both plant and mineral. Very interesting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_GEM.STUMP"
