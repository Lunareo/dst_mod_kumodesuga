msgstr "I'll take a spin and see."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "它抓到东西了。"
msgstr "It caught something."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
