#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
