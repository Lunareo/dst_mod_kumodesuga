msgstr "Releasing power."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "要动力才行哟～"
msgstr "It wants power."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "让人不安的光呢～"
msgstr "An unsettling light."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ATRIUM_OVERGROWTH"
