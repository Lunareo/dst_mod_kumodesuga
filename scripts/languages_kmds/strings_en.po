msgid "编得很紧。我自己编的。"
msgstr "Woven tight. By my own hand."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_BRAMBLE"
msgid "踩上去会很疼。……呵呵。"
msgstr "Whoever steps on it suffers.... Hehe."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "冷的状态。效果不强。"
msgstr "In its cold state. Barely effective."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "口袋快烧穿了。"
msgstr "My pocket. It's about to burn through."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "不想踩上去。"
msgstr "I would rather not step on it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "已经冷了。但仍危险。"
msgstr "Cooled now. Still dangerous."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "咬上来了！"
msgstr "It has come to bite!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "可爱的海星。"
msgstr "Mm, a cute starfish."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_TEETH"
msgid "讨厌的陷阱。"
msgstr "A distasteful trap."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "得躲着踩。"
msgstr "It must be stepped around."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST.BURNT"
msgid "箱子没了。"
msgstr "The chest is gone."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST.GENERIC"
msgid "玩具箱。"
msgstr "A toy box."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "容量变大了。"
msgstr "Capacity increased."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREASURECHEST_TRAP"
msgid "便利？"
msgstr "Convenient?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREECLUMP"
msgid "挡路的墙。"
msgstr "A wall in my way."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREEGROWTHSOLUTION"
msgid "给树喝的东西。喝了就长大。"
msgstr "Mm. A drink for trees."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK.BURNING"
msgid "藤在烧。过热了。"
msgstr "The vines burn. Overheating."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "失去支撑了。"
msgstr "Support, lost."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK.GENERIC"
msgid "被藤缠着。"
msgstr "The vines entwine."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK_SAPLING"
msgid "附在岩石上的苗。起步很苦。"
msgstr "A sprout clinging to rock. A rocky start."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TREE_ROCK_SEED"
msgid "石头树的种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRIDENT"
msgid "正好大显身手。"
msgstr "A chance to show my mettle."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINITY_IMPACT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINITY_IMPACT"
msgid "三种属性换着打……哼，倒是挺花哨的。"
msgstr "Three elements taking turns... hmph, flashy, I suppose."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_1"
msgid "熔了。薇洛玩过？"
msgstr "Melted. Did Willow play with it?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_10"
msgid "假牙。……牙可是每天都要刷的。"
msgstr "Dentures.... Teeth must be brushed daily."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_11"
msgid "机器人在低语。漂亮的谎话。"
msgstr "A whispering robot. Pretty lies."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_12"
msgid "干掉的触手。谁会收藏这种东西。"
msgstr "A dried tentacle. Who collects such things."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_13"
msgid "像宗教用品。女侏儒的。"
msgstr "A religious object, it seems. A gnome."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_14"
msgid "漏水的茶杯。茶都不够喝。"
msgstr "A leaky teacup. Never enough tea."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_15"
msgid "麦斯威尔又乱放东西。"
msgstr "Maxwell left it out again."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_16"
msgid "麦斯威尔又乱放东西。"
msgstr "Maxwell left it out again."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_17"
msgid "叉子和勺子合体。真恐怖。"
msgstr "A fork-spoon amalgam. Horrifying."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_18"
msgid "里面藏了什么？"
msgstr "What is hidden inside?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_19"
msgid "转得不太顺。"
msgstr "It will not turn well."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_2"
msgid "假笛子。呜。"
msgstr "A fake kazoo. Aww."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_20"
msgid "薇格弗丽德拿这个打过人？！"
msgstr "Wigfrid won this in battle?!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_21"
msgid "搅蛋器弯了。"
msgstr "The egg beater is bent."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_22"
msgid "一截线。用途我能想出好几个。"
msgstr "A length of yarn. I can think of a few uses."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_23"
msgid "鞋拔。我自己能穿好。"
msgstr "A shoehorn. I can put on my own shoes."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_24"
msgid "猫罐头。维克波顿养猫？"
msgstr "A lucky cat jar. Does Wickerbottom keep cats?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_25"
msgid "空气都臭了。"
msgstr "The air smells foul."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_26"
msgid "又是食器又是杯子。挺合理。"
msgstr "Dish and cup in one. Sensible."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_27"
msgid "伸开就能刺到远处。"
msgstr "It stretches far enough to prick."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_28"
msgid "权谋的棋子。"
msgstr "A pawn of intrigue."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_29"
msgid "权谋的棋子。"
msgstr "A pawn of intrigue."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_3"
msgid "结解不开。永远都解不开。"
msgstr "A knot that never comes undone."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_30"
msgid "又乱放在外面。"
msgstr "Left out again."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_31"
msgid "又乱放在外面。"
msgstr "Left out again."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_32"
msgid "球。……陪我玩的人呢？"
msgstr "A ball. If only there were someone to play with."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_33"
msgid "蜘蛛戒指。嗯，可爱。……主人的亲戚款。"
msgstr "A spider ring. Mm. Cute.... Master's relatives' style."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_34"
msgid "猿手。想许个愿试试。"
msgstr "A monkey paw. Shall I wish on it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_35"
msgid "空药瓶。"
msgstr "An empty medicine bottle."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_36"
msgid "还想再要糖果？……牙我可是每天都刷的。"
msgstr "Candy first, complaints later.... I will brush my teeth."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_37"
msgid "超自然……我信这个。"
msgstr "The supernatural... for those who believe. That's all it is."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_38"
msgid "从别的世界来的东西。可疑。"
msgstr "From another world. A world of swindles."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_39"
msgid "另一只在哪？"
msgstr "Another where?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_4"
msgid "像宗教用品。侏儒的。"
msgstr "A religious object, it seems. A gnome."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_40"
msgid "拿着它就像在做交易。"
msgstr "It has the air of a trade."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_41"
msgid "摸着是温的。"
msgstr "Warm to the touch."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_42"
msgid "满是童年的记忆。"
msgstr "Full of childhood memories."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_43"
msgid "会跳。……别得意。"
msgstr "I am no good at jumping."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_44"
msgid "像植物标本。"
msgstr "It resembles a plant specimen."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_45"
msgid "能收到别的世界的电波。"
msgstr "Receiving signals from another world."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_46"
msgid "空气动力学的道具？凡人真闲。"
msgstr "A device for aerodynamics? Mortals have too much time."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_5"
msgid "太小了坐不下。想逃生是没戏的。"
msgstr "Too small to ride away on. Escape impossible."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_6"
msgid "电线寿终了。"
msgstr "The wire has met its end."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_7"
msgid "玩的时间没有了。"
msgstr "Time to play has run out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_8"
msgid "塞子。洗澡用的吧。"
msgstr "A bung. Enough for the tub."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRINKET_9"
msgid "纽扣。不对。"
msgstr "Buttons. Wrong ones."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "火候……满分。"
msgstr "Fire degree... full marks."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "自夸的资格烧没了。"
msgstr "The right to boast, burnt away."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "今天的渔获有几公斤？"
msgstr "How many kilos is today's catch?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "重量：{weight}\n钓手：{owner}"
msgstr "Weight: {weight}\nCaught by: {owner}"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "重量：{weight}\n钓手：{owner}\n……好大一只！"
msgstr "Weight: {weight}\nCaught by: {owner}\n...A big one!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "就不谦虚了……\n重量：{weight}\n钓手：{owner}"
msgstr "Not that I'm humble....\nWeight: {weight}\nCaught by: {owner}"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "重量：{weight}\n钓手：{owner}\n……那家伙没逃成！"
msgstr "Weight: {weight}\nCaught by: {owner}\n...The one that didn't get away!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "在烤什么？"
msgstr "Mm. What's roasting?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "这可不是最佳烹调。"
msgstr "Not the ideal way to cook it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "能测收获的重量。"
msgstr "Harvest weight. Measurable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "重量：{weight}\n收获日：{day}\n……不坏。"
msgstr "Weight: {weight}\nHarvested on day {day}\n...Not bad."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "重量：{weight}\n收获日：{day}\n……能长这么大？"
msgstr "Weight: {weight}\nHarvested on day {day}\n...So they CAN grow this big?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "太平凡。重量都不显示。"
msgstr "So ordinary the scale won't even display it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNKVEST_SUMMER"
msgid "野外休闲装。"
msgstr "Casual wear for the field."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNKVEST_WINTER"
msgid "过冬的生存装备。"
msgstr "Winter survival gear."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNK_COOKED"
msgid "鼻音更重了。"
msgstr "The nasal notes grew heavier."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNK_SUMMER"
msgid "又轻又凉的鼻子。"
msgstr "A light, cool trunk."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TRUNK_WINTER"
msgid "厚毛的鼻子。"
msgstr "A thick, furry trunk."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TUMBLEWEED"
msgid "风滚草。里面藏着宝贝。"
msgstr "A tumbleweed. Treasures hidden inside."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TURFCRAFTINGSTATION"
msgid "做地皮的台子。新开拓。"
msgstr "A turf station. Breaking new ground."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TURF_ARCHIVE"
msgid "又是一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.TURF_BADLANDS"
msgid "又是一种地面。"
