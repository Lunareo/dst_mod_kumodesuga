#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "运气不错！"
msgstr "A lucky find!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUCY"
msgid "很漂亮的斧。我也想有一把。"
msgstr "A lovely axe. ...Envious."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUMPY_SAPLING"
msgid "这是怎么长出来的。"
msgstr "How does it reproduce."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARFROG"
msgid "别盯着看。"
msgstr "Do not stare."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARPLANTHAT"
msgid "比平时更亮。"
msgstr "Brighter than usual."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARPLANT_HUSK"
msgid "硬得出奇。能用！"
msgstr "Abnormally hard. ...Usable!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARPLANT_KIT"
msgid "缝衣的活也兼上了。"
msgstr "Tailoring, as a side job."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "光的结晶。"
msgstr "A crystal of light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARRIFT_PORTAL"
msgid "里面尽是门道，拿不到！"
msgstr "Science fills it within. ...But it cannot be grasped!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARTHRALL_PLANT"
msgid "不知远近。"
msgstr "It lacks a sense of distance."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "带刺的性子。"
msgstr "A prickly temperament."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_FORGE"
msgid "做精巧的东西，正合适。"
msgstr "A fitting place. ...For making clever things."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_FORGE_KIT"
msgid "几样凑一起就成！"
msgstr "Simple elements, combined!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_GRAZER"
msgid "像是从裂口出来的！"
msgstr "It seems to have come from the rift!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUNAR_SEED"
msgid "王冠的一部分。"
msgstr "A part of the crown."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUREPLANT"
msgid "在诱人过去。"
msgstr "It draws one in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUREPLANTBULB"
msgid "肉是从这农场来的。"
msgstr "A meat farm, self-made."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LUTEFISK"
msgid "鱼的一种。"
msgstr "A kind of fish."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MADSCIENCE_LAB"
msgid "拿理智换一点。做实验。"
msgstr "A small toll on sanity. ...For the experiment."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAGICIAN_CHEST"
msgid "心里越来越不安。为何。"
msgstr "Unease, growing. ...Why."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS"
msgid "鸟形的怪物，确实是。"
msgstr "A bird monster. ...Certainly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS_BEAK"
msgid "有鱼腥味。"
msgstr "Fish-stench."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS_FEATHER"
msgid "从有名的鸟身上拔的。"
msgstr "Plucked from a famous bird."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "羽毛织的帆布。"
msgstr "A sailcloth of feathers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MALE_PUPPET"
msgid "他被困住了！"
msgstr "He is trapped!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE"
msgid "曼德拉草根。性质很怪。"
msgstr "A mandrake. ...Strange properties."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKESOUP"
msgid "它不会再醒了。"
msgstr "It will not wake again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE_ACTIVE"
msgid "住手！"
msgstr "Stop that!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE_COOKED"
msgid "不奇怪了。"
msgstr "No longer strange."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MANDRAKE_PLANTED"
msgid "传闻里那种奇怪的植物。"
msgstr "The plant of strange rumors."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MANRABBIT_TAIL"
msgid "拿着安心一些。"
msgstr "Holding it, slightly reassuring."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAPSCROLL"
msgid "空白的地图。没用。"
msgstr "A blank map. ...Useless."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLE"
msgid "很豪华！"
msgstr "Luxurious!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLEBEAN"
msgid "用家里的牛换来的。"
msgstr "Got it from the home beefalo."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "像雕出来的。"
msgstr "It looks carved."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLEPILLAR"
msgid "能用。"
msgstr "It can be used."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLESHRUB"
msgid "合理。"
msgstr "It makes sense."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARBLETREE"
msgid "斧头对它没用。"
msgstr "An axe will not do."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.BURNING"
msgid "烧起来了，快！"
msgstr "It burns, fast!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.BURNT"
msgid "刺少了一些。"
msgstr "One thorn fewer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "刺很多。"
msgstr "Many thorns."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_BUSH.PICKED"
msgid "疼。"
msgstr "Painful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_PLANT"
msgid "植物。"
msgstr "A plant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.BURNING"
msgid "带刺的火！"
msgstr "Thorny fire!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.BURNT"
msgid "焦了，还是有刺。"
msgstr "Charred, and still thorny."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "不扎人了！"
msgstr "No more thorns!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MARSH_TREE.GENERIC"
msgid "刺很尖！"
msgstr "Sharp thorns!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASHEDPOTATOES"
msgid "做菜也是学问。该试试。"
msgstr "Cooking is chemistry. ...Worth trying."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_ANCIENT_ARCHITECTHAT"
msgid "看不出相似的地方。"
msgstr "No points of resemblance to be seen."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_ANCIENT_HANDMAIDHAT"
msgid "她，别烦她。"
msgstr "Her. ...Do not disturb."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_ANCIENT_MASONHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_ANCIENT_MASONHAT"
msgid "比别的都重。"
msgstr "Heavier than the rest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "铁匠的面具。"
msgstr "A blacksmith mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_DOLLBROKENHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_DOLLBROKENHAT"
msgid "裂了的人偶面具。"
msgstr "A cracked doll mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_DOLLHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_DOLLHAT"
msgid "人偶的面具。"
msgstr "A doll mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_DOLLREPAIREDHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_DOLLREPAIREDHAT"
msgid "曾经是人偶的面具。"
msgstr "Once, a doll mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_FOOLHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_FOOLHAT"
msgid "愚者的面具。"
msgstr "A fool's mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_HALFWITHAT"
msgid "有点钝。"
msgstr "Somewhat dull."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_KINGHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_KINGHAT"
msgid "国王的面具。"
msgstr "A king mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_MIRRORHAT"
msgid "面具，像镜子。"
msgstr "A mask. ...Mirror-like."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_PRINCESSHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_PRINCESSHAT"
msgid "喂，公主！"
msgstr "Hey, princess!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_QUEENHAT"
msgid "女王的面具。"
msgstr "A queen mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_SAGEHAT"
msgid "看着精明。"
msgstr "A sharp style."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_TOADYHAT"
msgid "该顺着他？"
msgstr "It should be humored?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASK_TREEHAT"
msgid "树的面具。"
msgstr "A tree mask."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST"
msgid "桅杆！"
msgstr "A mast!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "是个好主意。"
msgstr "A fine idea. ...I have one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "好点子，有了。"
msgstr "A fine idea. ...I have one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "哦，看我，眼都亮了。"
msgstr "Oh. ...Look at me. ...My eyes gleam."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "海上陆上，电都归它管。"
msgstr "Sea and land. ...The dominion of electricity."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_ITEM"
msgid "能做个桅杆。"
msgstr "A mast can be made."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_MALBATROSS"
msgid "张开翅膀走！"
msgstr "Sailing on spread wings!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "比看着轻。"
msgstr "Lighter than it looks."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_YOTD"
msgid "带花纹的帆。"
msgstr "A scaled sail."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAST_YOTD_ITEM"
msgid "能立起桅杆。"
msgstr "A mast can be built."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELL"
msgid "我不喜欢那家伙。"
msgstr "I dislike that man."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLHEAD"
msgid "连毛孔都看得见。"
msgstr "The pores are visible."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLLIGHT"
msgid "为什么会亮。……不明。"
msgstr "How does it glow. ...A mystery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLLOCK"
msgid "像个钥匙孔。"
msgstr "It resembles a keyhole."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MAXWELLPHONOGRAPH"
