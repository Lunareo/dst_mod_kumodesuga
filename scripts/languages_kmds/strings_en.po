#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.BURNT"
msgid "架子烧了。"
msgstr "The rack itself dried out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DONE"
