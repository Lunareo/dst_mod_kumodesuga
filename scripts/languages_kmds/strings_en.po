msgstr "It could pop out any moment."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "好大一颗蛋。"
msgstr "What a big egg."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "巢是空的。"
msgstr "The nest is empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TALLEGGS"
msgid "早餐技术上的突破。"
msgstr "A technical breakthrough in breakfast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TAMALES"
msgid "再吃下去，我会开始变粗。"
msgstr "Keep eating and I'll start widening."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.GENERIC"
msgid "不算很高的鸟。"
msgstr "Not that tall a bird."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.HUNGRY"
msgid "你需要食物，而且要快。"
msgstr "You need food, and quickly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.SLEEPING"
msgid "它在闭眼休息"
msgstr "It's resting with its eyes closed"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TEENBIRD.STARVING"
msgid "它眼里有危险的东西。"
msgstr "There's something dangerous in its eyes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEBASE.GEMS"
msgid "还要更多紫宝石。"
msgstr "Needs more purple gems."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEBASE.VALID"
msgid "可以启动了。"
msgstr "Ready to activate."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "靠这个能穿过时间和空间。"
msgstr "With this, one can pass through time and space."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "这似乎是通往另一个世界的枢纽。"
msgstr "This seems to be a hub to another world."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "还缺一样东西。"
msgstr "Still missing one thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "这个发明快完成了。"
msgstr "This invention is nearly complete."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_BOX"
msgid "反转极性？有意思的功能。可惜不是我写的。"
msgstr "Reverse the polarity? Fun feature. A shame I didn't write it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELEPORTATO_CRANK"
