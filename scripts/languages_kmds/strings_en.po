msgstr "Fire's legacy."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "骨头被传送门烧掉了呀～"
msgstr "The bone, teleported to ash."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "花被传送门烧掉了呢～真可惜～"
