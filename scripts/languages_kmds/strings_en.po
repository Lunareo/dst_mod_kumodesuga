msgstr "Starving."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.LAVAE_TOOTH"
msgid "卵齿～小小一颗，挺锋利～"
msgstr "An egg tooth."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.LAVASPIT.COOL"
