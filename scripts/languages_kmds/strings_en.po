#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SPORE_TALL.HELD"
msgid "把一点光收在口袋里。"
msgstr "A bit of light, pocketed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SQUID"
msgid "我有种感觉，它们会有用。"
msgstr "I have a feeling these will be useful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFFCOLDLIGHT"
msgid "冷。"
msgstr "Cold."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFFLIGHT"
msgid "那个很危险。"
msgstr "That one is dangerous."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFF_LUNARPLANT"
msgid "植物的力量。"
msgstr "The power of plants."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAFF_TORNADO"
msgid "旋转的灾难。"
msgstr "A spinning disaster."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.STAGEHAND.AWAKE"
