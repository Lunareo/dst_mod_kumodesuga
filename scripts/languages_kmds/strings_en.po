msgstr "What a big carrot."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARROT_PLANTED"
msgid "大地在造孩子。"
msgstr "The earth is making children."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARROT_SEEDS"
msgid "一颗种子。"
msgstr "A seed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "到此为止。"
msgstr "This ends here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "只剩灰了。"
msgstr "Only ash left."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "现在能把找到的东西画给别人看了。"
msgstr "Now I can draw what I found for others to see."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOON"
msgid "爱玩的小东西。"
msgstr "A playful little thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOONDEN.EMPTY"
msgid "主人的命用完了。"
msgstr "Its owner ran out of lives."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOONDEN.GENERIC"
msgid "树桩里的窝。"
msgstr "A den in the stump."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATCOONHAT"
msgid "带耳朵的帽子。"
msgstr "A hat with ears."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CATTOY_MOUSE"
msgid "带轮子的老鼠。接下来还会做出什么。"
msgstr "A mouse on wheels. What will they make next."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "这一块我大概搬得动。"
msgstr "I could probably move this one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "碰不到。"
msgstr "Can't reach it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA"
msgid "软了。"
msgstr "Soft."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA_BURNT"
msgid "不是我的错。"
msgstr "Not my fault."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA_COOKED"
msgid "还行。"
msgstr "Not bad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_BANANA_TREE"
msgid "它的光合作用很可疑。"
msgstr "Its photosynthesis is suspicious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE"
msgid "那块石头大概能推开。"
msgstr "That rock could probably be pushed open."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "要等有人出来才能进去。"
msgstr "Have to wait for someone to come out before going in."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "大地拒绝了我。"
msgstr "The earth refused me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "下面应该有不少可看的东西。"
msgstr "There should be plenty to see down there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "下面藏着什么。"
msgstr "What's hidden down there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_EXIT.FULL"
msgid "上面太挤了。"
msgstr "Too crowded up there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "那就留在下面吧。"
msgstr "Then let's stay down here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_EXIT.OPEN"
msgid "探索到此为止。"
msgstr "Exploration ends here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_FERN"
msgid "是蕨。"
msgstr "A fern."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_FERN_WITHERED"
msgid "一株枯了的蕨。"
msgstr "A withered fern."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "没气了。"
msgstr "Out of air."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "那会是什么。"
msgstr "What could that be."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "小心，它可能会醒。"
msgstr "Careful, it might wake."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "它气得冒烟。"
msgstr "It's steaming mad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "这让人疲惫。"
msgstr "This is exhausting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "我不确定它往哪边通。"
msgstr "I'm not sure which way it leads."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "温度确实上来了。"
msgstr "The temperature is definitely rising."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "瘴气呢。"
msgstr "Where's the miasma."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CEILING_ROPE"
msgid "一根攀爬用的绳子。"
msgstr "A rope for climbing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CEVICHE"
msgid "能换个大点的碗吗。这个有点小。"
msgstr "Could I get a bigger bowl. This one is a bit small."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARCOAL"
msgid "小，黑，有烧木头的味道。"
msgstr "Small, black, smells of burnt wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_HAND"
msgid "它想要一件可怕的东西。"
msgstr "It wants something dreadful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_HECKLER"
msgid "他们只是来搅事的。"
msgstr "They're only here to heckle."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_LECTURN"
msgid "有人在演戏吗。"
msgstr "Is someone performing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_NPC"
msgid "等等，那是……"
msgstr "Wait, that's..."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHARLIE_STAGE_POST"
msgid "这是布置好的。太像舞台了。"
msgstr "This was staged. Far too theatrical."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSJUNK1"
msgid "一堆碎掉的棋子。"
msgstr "A pile of shattered chess pieces."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSJUNK2"
msgid "又一堆碎掉的棋子。"
msgstr "Another pile of shattered chess pieces."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSJUNK3"
msgid "还有更多碎棋子。"
msgstr "Even more shattered pieces."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "和看上去一样重。"
msgstr "As heavy as it looks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ANTLION"
msgid "停住的蚁狮。"
msgstr "An antlion, stopped."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEARGER"
msgid "近看要大得多。"
msgstr "Much bigger up close."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "不知为何，比真的还暴躁。"
msgstr "Somehow grumpier than the real thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "这座雕像很有肉感。"
msgstr "This statue is quite fleshy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "很有雕像的样子。"
msgstr "Very befitting of a statue."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "石头做的主教。"
msgstr "A bishop made of stone."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "棋子自己在动。"
msgstr "The piece is moving on its own."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "好看。不是吗。"
msgstr "Pretty. Isn't it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CARRAT"
msgid "冠军出来了。"
msgstr "A champion emerges."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CATCOON"
msgid "大概很适合磨爪子。"
msgstr "Probably great for sharpening claws."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "那家伙是我最不担心的一件事。"
msgstr "That fellow is the least of my worries."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "而且我还没被吃掉。"
msgstr "And I haven't been eaten yet."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_CRABKING"
msgid "脾气还是不如麦斯威尔差。"
msgstr "Still not as bad-tempered as Maxwell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "现在他不知道跑哪去了。"
msgstr "Now he's run off somewhere."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "这个该扔进废料堆。"
msgstr "This one belongs in the scrap heap."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "它的眼睛好像会跟着人。"
msgstr "Its eyes seem to follow people."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "这座雕像有点碍眼。"
msgstr "This statue is an eyesore."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "是虫。也说得通。"
msgstr "A worm. That checks out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "这让我想起一些事。不好的事。"
msgstr "This reminds me of things. Bad things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "它在用石头的眼神看我。"
msgstr "It's staring at me with stone eyes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_FORMAL"
msgid "我看不出哪里\"像个王\"。"
msgstr "I can't see what's \"kingly\" about it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "我更喜欢它现在这样。"
msgstr "I prefer it this way."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "光看着，肚子就叫了。"
msgstr "My stomach growls just looking at it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KITCOON"
msgid "这些找起来容易多了。"
msgstr "These are much easier to find."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KLAUS"
msgid "能不能援引\"不摆节日装饰\"那一条。"
msgstr "Can I invoke the \"no holiday decorations\" clause."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "当然是马。"
msgstr "A knight, of course."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "棋子自己在动。"
msgstr "The piece is moving on its own."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "不想杀我的时候，它还算不错。"
msgstr "Decent enough, when it isn't trying to kill me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "想抱一下。石头会磨人。"
msgstr "Want to hug it. Stone chafes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "现在换你僵在那里了。"
msgstr "Now it's your turn to freeze in place."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MOON"
msgid "最近很有灵感。"
msgstr "Full of inspiration lately."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "做得太像了。"
msgstr "Too well made."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_MUSE"
msgid "嗯。有点眼熟。"
msgstr "Hm. Looks a bit familiar."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_PAWN"
msgid "我懂它的处境。"
msgstr "I understand its plight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_PIPE"
msgid "那种东西我不感兴趣。"
msgstr "That kind of thing doesn't interest me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "比看上去还重。"
msgstr "Heavier than it looks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "棋子自己在动。"
msgstr "The piece is moving on its own."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "它身上有点鱼的意思。"
msgstr "There's something fishy about it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_STALKER"
msgid "骸骨本来就该这么不动。"
msgstr "This is how a skeleton should stay still."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "当凳子并不好用。"
msgstr "Poor as a stool."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "那一夜的对视，很不舒服。"
msgstr "That night's stare-off was uncomfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "这一位个头不够。"
msgstr "This one isn't big enough."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "心情很好。"
msgstr "In a great mood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "设计不错。做工可疑。"
msgstr "Good design. Questionable workmanship."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "只差那口可怕的气味。"
msgstr "Only missing the dreadful smell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "现在想起来还会发抖。"
msgstr "I shiver just remembering it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_YOTD"
msgid "光看着它，我的心就跳快了。"
msgstr "My heart races just looking at it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_YOTH"
msgid "那是难缠的一夜。"
msgstr "That was a rough night."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESSPIECE_YOTS"
msgid "我一般不接近挖金子的人。"
msgstr "I generally don't go near gold diggers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTER"
msgid "切斯特·冯·切斯特菲尔德阁下。"
msgstr "Lord Chester von Chesterfield, Esquire."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "它在看我。"
msgstr "It's looking at me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "它睡了。"
msgstr "It's asleep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "物理法则意外地有弹性。"
msgstr "The laws of physics are surprisingly flexible."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "装得不错。差点上当。"
msgstr "Well disguised. Nearly got me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHIPS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHIPS"
msgid "薯片。观战的时候需要它。"
msgstr "Chips. Spectating requires them."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CHUM"
msgid "这是给鱼的饭。"
msgstr "This is dinner for the fish."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYHOUND.GENERIC"
msgid "它被放出来了。"
msgstr "It's been let out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYHOUND.STATUE"
msgid "做得很像真的。"
msgstr "Made a bit too lifelike."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYWARG.GENERIC"
msgid "陶土做的恐怖东西。"
msgstr "A horrifying thing made of clay."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CLAYWARG.STATUE"
msgid "它刚才动了吗。"
msgstr "Did that just move."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.EMBERS"
msgid "火要灭了。得加燃料。"
msgstr "The fire is dying. Needs fuel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.GENERIC"
msgid "比黑暗好。"
msgstr "Better than darkness."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.HIGH"
msgid "火有点失控。"
msgstr "The fire is getting out of hand."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.LOW"
msgid "火小下去了。"
msgstr "The fire has shrunk."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.NORMAL"
msgid "舒服。"
msgstr "Comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIRE.OUT"
msgid "结束了。"
msgstr "It's over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "该往火里添点东西，不然会灭。"
msgstr "Add something to the fire, or it dies."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "比黑暗好。"
msgstr "Better than darkness."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "还好它被围住了。"
msgstr "Good thing it's contained."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.LOW"
msgid "火小下去了。"
msgstr "The fire has shrunk."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "舒服。"
msgstr "Comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLDFIREPIT.OUT"
msgid "至少还能再点起来。"
msgstr "At least it can be relit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COLLAPSEDCHEST"
msgid "物理法则被弯折，然后断了。"
msgstr "The laws of physics were bent, then snapped."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.E"
msgid "东。"
msgstr "East."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.GENERIC"
msgid "我朝着哪边。"
msgstr "Which way am I facing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.N"
msgid "北。"
msgstr "North."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.NE"
msgid "东北。"
msgstr "Northeast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.NW"
msgid "西北。"
msgstr "Northwest."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.S"
msgid "南。"
msgstr "South."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.SE"
msgid "东南。"
msgstr "Southeast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.SW"
msgid "西南。"
msgstr "Southwest."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPASS.W"
msgid "西。"
msgstr "West."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOST"
msgid "植物的食物。除此以外没什么用。"
msgstr "Food for plants. Otherwise useless."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "刚好。"
msgstr "Just right."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "我以为它不会更臭了。"
msgstr "I didn't think it could smell worse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "嗯……太干。"
msgstr "Hm... too dry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "这味道我几乎受不住。"
msgstr "This smell I can barely stand."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTINGBIN.WET"
msgid "那个看着太湿。"
msgstr "That looks too wet."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COMPOSTWRAP"
msgid "沃姆伍德请我咬一口，我很有礼貌地拒绝了。"
msgstr "Wormwood offered me a bite. I politely declined."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CONSTRUCTION_PLANS"
msgid "用来搭东西的材料。"
msgstr "Materials for building things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKBOOK"
msgid "我一向对知识很饿。"
msgstr "I'm always hungry for knowledge."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDMANDRAKE"
msgid "叫得挺响。"
msgstr "Quite the scream."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDMEAT"
msgid "烤得刚好。"
msgstr "Roasted just right."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDMONSTERMEAT"
msgid "比生的稍微好一点。"
msgstr "Slightly better than raw."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKEDSMALLMEAT"
msgid "现在不用担心长虫了。"
msgstr "No more worrying about worms now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKIECUTTER"
msgid "我不喜欢它看我的船的方式。"
msgstr "I don't like the way it looks at my boat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKIECUTTERHAT"
msgid "至少我的头发能保持干燥。"
msgstr "At least my hair stays dry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKIECUTTERSHELL"
msgid "它从前的外壳。"
msgstr "Its old shell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "这笔迹我认不出来。"
msgstr "I can't read this handwriting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.BURNT"
msgid "锅被煮了。"
msgstr "The pot got cooked."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "这要花些时间。"
msgstr "This will take some time."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "快好了。"
msgstr "Almost done."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.DONE"
msgid "可以吃了。"
msgstr "Ready to eat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOKPOT.EMPTY"
msgid "光看着就饿了。"
msgstr "Hungry just looking at it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COOLANT"
msgid "它冒着可能的气泡。"
msgstr "It's bubbling with potential."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COONTAIL"
msgid "它好像还在摆。"
msgstr "It seems to still be wagging."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN"
msgid "糖分很高。"
msgstr "Very sugary."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN_COOKED"
msgid "熟了，糖分还是很高。"
msgstr "Cooked, still very sugary."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN_OVERSIZED"
msgid "你这穗真大。"
msgstr "That's quite an ear you have."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CORN_SEEDS"
msgid "一颗种子。"
msgstr "A seed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "一套铁匠的服装。"
msgstr "A blacksmith's costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_DOLL_BODY"
msgid "一套人偶的服装。"
msgstr "A doll's costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_FOOL_BODY"
msgid "一套愚者的服装。"
msgstr "A fool's costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_KING_BODY"
msgid "一套国王的服装。"
msgstr "A king's costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "一套服装。"
msgstr "A costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "别理那些唱反调的人。"
msgstr "Ignore the naysayers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "一套女王的服装。"
msgstr "A queen's costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COSTUME_TREE_BODY"
msgid "一套树的服装。"
msgstr "A tree's costume."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "它需要燃料。"
msgstr "It needs fuel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "很让人安定的光。"
msgstr "A very soothing light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "它需要燃料。"
msgstr "It needs fuel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "很能启发人的形象。"
msgstr "A most inspiring image."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "它需要燃料。"
msgstr "It needs fuel."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "能一直盯着它。反正时间多的是。"
msgstr "I could stare at it forever. Time is hardly in short supply."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COTL_TRINKET"
msgid "一项加冕般的成就。"
msgstr "A coronation-caliber achievement."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.COZY_BUNNYMAN"
msgid "它们看着很舒服。"
msgstr "They look very comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING.GENERIC"
msgid "那个对我来说脾气太大了。"
msgstr "That one has too much temper for me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING.INERT"
msgid "那座城堡需要一点装饰。"
msgstr "That castle needs a little decoration."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_CANNONTOWER"
msgid "我就知道这些蟹里有炮。"
msgstr "I knew there were cannons among these crabs."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_CLAW"
msgid "那是该警觉的爪子。"
msgstr "That's a claw worth staying alert for."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_ICEWALL"
msgid "这是我和那只蟹之间的事。"
msgstr "This is between me and that crab."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_MOB"
msgid "脾气很大吗。"
msgstr "Is that a big temper."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "这个会是不小的挑战。"
msgstr "This one will be quite a challenge."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTERLAB"
msgid "里面有东西吗。"
msgstr "Is something in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_BULBIN"
msgid "做坏事可以。别做得无聊。"
msgstr "Misbehaving is fine. Just don't be boring."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_DRAGONLING"
msgid "留下。看起来会很有趣。"
msgstr "Keeping it. Looks like it'll be interesting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_EETS"
msgid "看，人类。"
msgstr "Look, human."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "多一双眼睛总是好的。呃……一只。"
msgstr "An extra pair of eyes is always good. Er... one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_GLOMLING"
msgid "符合空气动力学的生物。"
msgstr "An aerodynamic creature."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_KITTEN"
msgid "你会是很好的助手。"
msgstr "You'll make a fine assistant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_LAMB"
msgid "比它妈妈干净多了。"
msgstr "Much cleaner than its mother."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "留着她，是因为她擅长算数。"
msgstr "I keep her because she's good at math."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_PERDLING"
msgid "带羽毛的随从。"
msgstr "A feathered attendant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRITTER_PUPPY"
msgid "作为小怪物，算可爱。"
msgstr "Cute, for a little monster."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CROW.GENERIC"
msgid "瘆人。"
msgstr "Eerie."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CROW.HELD"
msgid "它在里面不太高兴。"
msgstr "It isn't pleased in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CRUMBS"
msgid "用碎屑藏身，很拙劣。"
msgstr "Hiding in crumbs is sloppy work."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "它看着无害。"
msgstr "It looks harmless."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTGRASS"
msgid "割好的草。可以拿去做东西。"
msgstr "Cut grass. Good for making things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTLESS"
msgid "它切得不利，但扎起来很行。"
msgstr "It cuts poorly, but stabs just fine."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTLICHEN"
msgid "有营养。但放不久。"
msgstr "Nutritious. But won't keep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTREEDS"
msgid "割好的芦苇。可以拿去做东西。"
msgstr "Cut reeds. Good for making things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.CUTSTONE"
msgid "光滑得诱人。"
msgstr "Smooth to the point of temptation."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER.GENERIC"
msgid "把他放出来大概不是我最好的主意。"
msgstr "Letting him out probably wasn't my best idea."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "我几乎有点同情他。"
msgstr "I feel almost sorry for him."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER2.BURIED"
msgid "他被压在那堆废料下面。"
msgstr "He's pinned under that pile of scrap."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER2.GENERIC"
msgid "别惹他生气。"
msgstr "Don't make him angry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "他好像生气了。"
msgstr "He seems angry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "一根硬得不合理的石柱。"
msgstr "A pillar unreasonably hard."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "大理石里有东西在闪。"
msgstr "Something glints within the marble."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEADLYFEAST"
msgid "最烈的一道菜。"
msgstr "The strongest dish of all."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEAD_SEA_BONES"
msgid "这是它们上岸的下场。"
msgstr "This is what happens when they come ashore."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "浪费木头。"
msgstr "A waste of wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "火的事，与我无关。"
msgstr "The fire isn't my business."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "接着，自然。"
msgstr "Carry on, nature."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "大多数时候都长着叶子。"
msgstr "Leafy most of the time."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "它对我摘桦果的事不太高兴。"
msgstr "It's not happy about me picking its birchnuts."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECK_OF_CARDS"
msgid "我们用的是整副牌吗。"
msgstr "Are we playing with the full deck."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_CENTERPIECE"
msgid "很有品味。"
msgstr "Very tasteful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "一只没有花的花瓶。"
msgstr "A vase without flowers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "有一点光，不错。"
msgstr "A bit of light. Nice."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "一瓶插得不错的花。"
msgstr "A nicely arranged vase of flowers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "我记得让麦斯威尔换灯泡了。"
msgstr "I remember telling Maxwell to change the bulb."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "看着不太新鲜。"
msgstr "Doesn't look fresh."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_LAMP"
msgid "一盏迎人的灯。"
msgstr "A welcoming lamp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "很美。"
msgstr "Beautiful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "该在这里面画点东西。"
msgstr "Something should be drawn in here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "看着不错。"
msgstr "Looks good."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER.ANTLER"
msgid "很了不起的角。"
msgstr "A magnificent antler."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER.GENERIC"
msgid "它在看我吗。……不，没有。"
msgstr "Is it looking at me.... No, it isn't."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPS"
msgid "巨大。"
msgstr "Enormous."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "不能太大意。"
msgstr "Can't let my guard down."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "结束了……对吧。"
msgstr "It's over... right."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "我不想相信眼前看到的东西。"
msgstr "I refuse to believe what I'm seeing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "这样的冰冷目光如何。"
msgstr "How's that for a frosty gaze."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "有人丢了一只眼睛吗。"
msgstr "Did someone lose an eye."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "各位退开，我受过训练。"
msgstr "Everyone stand back. I'm trained for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "很恶心。"
msgstr "Very gross."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER_ANTLER"
msgid "那个本来会掉下来吗。"
msgstr "Was that going to fall off anyway."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEER_GEMMED"
msgid "它被那头野兽控制着。"
msgstr "That beast has control of it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "那大概是一丛草。"
msgstr "That was probably a tuft of grass."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DESERTHAT"
msgid "不错的护眼装备。"
msgstr "Fine eye-protection gear."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DESICCANT"
msgid "干了又干。"
msgstr "Dry, and drier."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DESICCANTBOOSTED"
msgid "它让我彻底干着。"
msgstr "It keeps me completely dry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEVTOOL"
msgid "有培根的味道。"
msgstr "Smells like bacon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DEVTOOL_NODEV"
msgid "我拿不动它。"
msgstr "I can't lift it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIRTPILE"
msgid "一堆土……真的只是土吗。"
msgstr "A pile of dirt... is it really just dirt."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.COLD"
msgid "信号很弱。"
msgstr "Signal is weak."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.GENERIC"
msgid "某种寻向的装置。"
msgstr "Some kind of direction-finding device."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.HOT"
msgid "这东西疯了。"
msgstr "This thing has gone mad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.WARM"
msgid "方向没错。"
msgstr "The direction is right."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGROD.WARMER"
msgid "应该很近了。"
msgstr "Should be very close now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "它是做什么用的。"
msgstr "What is it for."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODBASE.READY"
msgid "看起来需要一把很大的钥匙。"
msgstr "Looks like it needs a very large key."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "机器能动了。"
msgstr "The machine can move now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DIVININGRODSTART"
msgid "那根杖看着有用。"
msgstr "That staff looks useful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DOCK_KIT"
msgid "搭一座船坞所需的一切。"
msgstr "Everything needed to build a dock."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "我就觉得船坞少了点什么。"
msgstr "I knew the dock was missing something."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DOLL_BLUEPRINT"
msgid "我的牛会可爱得像颗纽扣。"
msgstr "My beefalo will be cute as a button."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONBOAT_KIT"
msgid "别再拖了，把它搭起来。"
msgstr "No more delaying. Assemble it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONBOAT_PACK"
msgid "造船变得很容易。"
msgstr "Boatbuilding has gotten easy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONBODYHAT"
msgid "对这中间的一段，我没什么意见。"
msgstr "I have no objection to this middle segment."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONCHILISALAD"
msgid "希望我受得住那个辣度。"
msgstr "Hope I can survive that heat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLY"
msgid "会飞的龙。"
msgstr "A flying dragon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "除了保险箱之外最好的选择。"
msgstr "The best option short of a safe."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "容量已经超出秤的刻度了。"
msgstr "Its capacity exceeds the scale's markings."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "热很多，光很少。"
msgstr "Much hotter, very little light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "它本来不该长这样。"
msgstr "It was never meant to look like this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "烫。"
msgstr "Scorching."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "它在对我眨眼吗。"
msgstr "Is it winking at me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT"
msgid "奇怪的水果。"
msgstr "A strange fruit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "还是很奇怪。"
msgstr "Still strange."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "我几乎以为它会长出翅膀。"
msgstr "I almost expected it to grow wings."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "一颗种子。"
msgstr "A seed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONHEADHAT"
msgid "那么谁来当头。"
msgstr "Then who gets to be the head."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONPIE"
msgid "火龙果很管饱。"
msgstr "Dragonfruit is quite filling."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGONTAILHAT"
msgid "总得有人负责后面。"
msgstr "Someone has to handle the rear."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRAGON_SCALES"
msgid "还是温的。"
msgstr "Still warm."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DREADSTONE"
msgid "它反射的似乎是影子，不是光。"
msgstr "It seems to reflect shadows, not light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DREADSTONEHAT"
msgid "用来保住我聪明的脑子。"
msgstr "For keeping my clever brain intact."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DREADSTONE_STACK"
msgid "它是从那些深渊底下上来的。"
msgstr "It came up from beneath those abysses."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_LOG"
msgid "它能浮在水上。"
msgstr "It floats."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "那块浮木在烧。"
msgstr "That driftwood is burning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "看着没什么用了。"
msgstr "Doesn't look much use now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "下面也许还有值得挖的东西。"
msgstr "Maybe something worth digging is underneath."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "一棵冲上岸的死树。"
msgstr "A dead tree washed ashore."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRUMSTICK"
msgid "可以大口吃了。"
msgstr "Time for a big bite."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DRUMSTICK_COOKED"
msgid "更适合大口吃了。"
msgstr "Even better for big bites."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_BANANABUSH"
msgid "那丛灌木很疯。"
msgstr "That bush is insane."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_BERRYBUSH"
msgid "现在能带到任何地方。"
msgstr "Now it can be taken anywhere."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "可以移到营地附近种。"
msgstr "Can be planted near camp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_GRASS"
msgid "现在到哪都能种。"
msgstr "Now plantable anywhere."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_MARSH_BUSH"
msgid "这个需要种下去。"
msgstr "This needs planting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_MONKEYTAIL"
msgid "不知道它们能不能吃。也许该做个试验。"
msgstr "Wonder if they're edible. Perhaps an experiment is in order."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_SAPLING"
msgid "这个需要种下去。"
msgstr "This needs planting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUG_TRAP_STARFISH"
msgid "现在骗不了人了。"
msgstr "It can't fool anyone now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL"
msgid "我一般让脑子去干重活。"
msgstr "I generally let my brain do the heavy lifting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "没有比那更凉的东西了。"
msgstr "Nothing is cooler than that."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_GEM"
msgid "我要用力量征服这个重量——我的背。"
msgstr "I shall conquer this weight with strength — my back's strength."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_GOLDEN"
msgid "它的重量值那么多金子。"
msgstr "Its weight is worth all that gold."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_HEAT"
msgid "适合用来热身。"
msgstr "Good for warming up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_MARBLE"
msgid "我把脑子练成了身上最强的肌肉。"
msgstr "I trained my brain into the strongest muscle I have."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUMBBELL_REDGEM"
msgid "这个会让人真正感到发热。"
msgstr "This makes one genuinely feel the heat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN"
msgid "很臭。"
msgstr "Very smelly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN_COOKED"
msgid "现在更臭了。"
msgstr "Even smellier now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN_OVERSIZED"
msgid "它一定会更臭。"
msgstr "It's bound to smell even worse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DURIAN_SEEDS"
msgid "一颗种子。"
msgstr "A seed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUSTMERINGUE"
msgid "谁会吃这个。"
msgstr "Who would eat this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUSTMOTH"
msgid "很爱整洁的小东西。"
msgstr "A very tidy little thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.DUSTMOTHDEN"
msgid "它们在里面很安稳。"
msgstr "They're quite at home in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EARMUFFSHAT"
msgid "里外都暖。"
msgstr "Warm inside and out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EEL"
msgid "这个能做一顿好菜。"
msgstr "This would make a good dish."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EEL_COOKED"
msgid "味道不错。"
msgstr "Tastes good."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT"
msgid "看起来不像蛋。"
msgstr "Doesn't look like an egg."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT_COOKED"
msgid "更不像蛋了。"
msgstr "Even less like an egg."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "我还是看不出它哪里像蛋。"
msgstr "I still can't see what's eggy about it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EGGPLANT_SEEDS"
msgid "一颗种子。"
msgstr "A seed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ELIXIR_CONTAINER"
msgid "那更像是入殓师的包，不是篮子。"
msgstr "That's more an undertaker's kit than a basket."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EMBERLIGHT"
msgid "没有燃料的火吗。无所谓。"
msgstr "A fire without fuel. Whatever."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.BURNT"
msgid "烧焦的桌子上一只烧焦的花瓶。"
msgstr "A scorched vase on a scorched table."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.EMPTY"
msgid "该往里面放点东西。"
msgstr "Something should go in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "有一点光，不错。"
msgstr "A bit of light. Nice."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.GENERIC"
msgid "桌上花瓶里的一朵花。"
msgstr "A flower in the table's vase."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "新的灯泡有人记得拿吗。"
msgstr "Did anyone remember to grab a new bulb."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ENDTABLE.WILTED"
msgid "看着不太新鲜。"
msgstr "Doesn't look fresh."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.BURNING"
msgid "浪费木头。"
msgstr "A waste of wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.BURNT"
msgid "火的事，与我无关。"
msgstr "The fire isn't my business."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.CHOPPED"
msgid "接着，自然。"
msgstr "Carry on, nature."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN.GENERIC"
msgid "满是松针。"
msgstr "Full of pine needles."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "浪费木头。"
msgstr "A waste of wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "火的事，与我无关。"
msgstr "The fire isn't my business."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "接着，自然。"
msgstr "Carry on, nature."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "这棵可怜的树没有松果。"
msgstr "The poor tree has no pinecones."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEBRELLAHAT"
msgid "它会替戴的人看着周围。"
msgstr "It watches the surroundings for its wearer."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEMASKHAT"
msgid "可以说我对式样很有眼光。"
msgstr "One could say I have an eye for style."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEOFTERROR"
msgid "打眼睛。"
msgstr "Hit the eye."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEOFTERROR_MINI"
msgid "我开始在意自己了。"
msgstr "I'm starting to grow attached."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "我想它要孵了。"
msgstr "I think it's about to hatch."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYEPLANT"
msgid "我在被看着。"
msgstr "I'm being watched."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYETURRET"
msgid "希望它不会对着我转过来。"
msgstr "Hope it doesn't swivel toward me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.EYETURRET_ITEM"
msgid "它在睡。"
msgstr "It's asleep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.BURNT"
msgid "一堆灰里长不出东西。"
msgstr "Nothing grows out of a pile of ash."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.GENERIC"
msgid "该种点作物。"
msgstr "Time to plant some crops."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.GROWING"
msgid "长吧。"
msgstr "Grow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "它需要施肥。"
msgstr "It needs fertilizing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_HOE"
msgid "得让地面对种子更友好。"
msgstr "The ground needs to be friendlier to seeds."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.BURNING"
msgid "那对植物不会有好处。"
msgstr "That won't do the plant any good."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.FULL"
msgid "该收成果了。"
msgstr "Time to harvest."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "靠规则，我种出了怪物般的作物。"
msgstr "By the rules, I've grown a monstrous crop."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "我就知道最后会把冒充的挑出来。"
msgstr "I knew I'd eventually pick out the impostors."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.GENERIC"
msgid "那是一株植物。"
msgstr "That is a plant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.GROWING"
msgid "长吧，我美丽的造物。"
msgstr "Grow, my beautiful creation."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "可惜。有机会的时候没摘。"
msgstr "A pity. Should've picked it when there was a chance."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "运气很差。"
msgstr "Terrible luck."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLANT.SEED"
msgid "现在，等着。"
msgstr "Now, we wait."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLOW"
msgid "一件很方便的东西。"
msgstr "A very handy thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_PLOW_ITEM"
msgid "用之前该先给我的园子找个好地方。"
msgstr "Should find a good spot for my garden before using it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "它把我的园子弄得一团糟。"
msgstr "It made a mess of my garden."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHERFAN"
msgid "用羽绒把温度压下来。"
msgstr "Pressing the temperature down with down feathers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHERHAT"
msgid "成为鸟。"
msgstr "Become the bird."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHERPENCIL"
msgid "羽毛能提升书写的品质。"
msgstr "Feathers elevate the quality of writing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_CANARY"
msgid "一根金丝雀的羽毛。"
msgstr "A canary's feather."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_CROW"
msgid "一根黑鸟的羽毛。"
msgstr "A black bird's feather."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_ROBIN"
msgid "一根红鸟的羽毛。"
msgstr "A red bird's feather."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "一根雪鸟的羽毛。"
msgstr "A snow bird's feather."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FEM_PUPPET"
msgid "她被困住了。"
msgstr "She's trapped."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE"
msgid "只是木栅栏。"
msgstr "Just a wooden fence."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "它单独一根没有作用。"
msgstr "Alone, it does nothing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "它找到了连接。"
msgstr "It found a connection."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "它不是树，但必须被种下去。"
msgstr "It isn't a tree, but it must be planted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_GATE"
msgid "它会开。有时候也会关。"
msgstr "It opens. Sometimes it closes too."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_GATE_ITEM"
msgid "做一道结实门所需的一切。"
msgstr "Everything needed for a sturdy gate."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ITEM"
msgid "做一道结实栅栏所需的一切。"
msgstr "Everything needed for a sturdy fence."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_JUNK"
msgid "说它丑吧，我不会介意。"
msgstr "Calling it ugly wouldn't bother me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FENCE_ROTATOR"
msgid "立起来，重新钉好。"
msgstr "Stand it up, nail it back in."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FERTILIZER"
msgid "那确实是一桶粪。"
msgstr "That is indeed a bucket of manure."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FESTIVEFISH"
msgid "应季的海产，我不介意尝一点。"
msgstr "Seasonal seafood. I don't mind a taste."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "正是庆祝的场合。"
msgstr "Just the occasion for celebrating."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIG"
msgid "我就叫它\"牛顿的无花果\"。"
msgstr "I'll call it the \"Newton's fig\"."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIGATONI"
msgid "不错。"
msgstr "Not bad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIGKABAB"
msgid "无花果配一根棍子。"
msgstr "Fig on a stick."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIG_COOKED"
msgid "它被烤过了。"
msgstr "It got roasted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIREBALLSTAFF"
msgid "它能从上面叫来陨石。"
msgstr "It can call meteors down from above."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.FIRECRACKERS"
msgid "里面装着会炸的东西。"
msgstr "Something explosive is packed inside."

