msgid "快孵出来了。"
msgstr "Hatching soon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "好大的蛋！"
msgstr "A big egg!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "空的。"
msgstr "Empty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TALLEGGS"
msgid "早饭上有了长进！"
msgstr "A breakfast technological breakthrough!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TAMALES"
msgid "再多吃就要圆了。"
msgstr "Any more, and I will grow round."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.GENERIC"
msgid "还不算高的鸟。"
msgstr "A not-so-tall bird."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.HUNGRY"
msgid "急着要吃的？"
msgstr "Urgently wanting food?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.SLEEPING"
msgid "睡着了"
msgstr "Bedded down"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TEENBIRD.STARVING"
msgid "那眼神很危险。"
msgstr "Dangerous eyes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEBASE.GEMS"
msgid "紫宝石不够。"
msgstr "Not enough purple gems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEBASE.VALID"
msgid "准备好了。"
msgstr "Ready."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "能越过时空。……用吧。"
msgstr "The power to cross time and space. ...Use it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "像是通往别的世界的接点。"
msgstr "It looks like a junction to another world."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "还缺点什么。"
msgstr "Something is still missing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "快完成了！"
msgstr "Nearly complete!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_BOX"
msgid "能管住宇宙的两极。"
msgstr "Cosmic polarity control."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_CRANK"
msgid "经得住激烈的实验。"
msgstr "It withstands violent experiments."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_POTATO"
msgid "金属的马铃薯。可怕的力量。"
msgstr "A metal potato. ...Frighteningly powerful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELEPORTATO_RING"
msgid "把次元的力聚在环上。"
msgstr "A ring of concentrated dimensional power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TELESTAFF"
msgid "能让世界现形。"
msgstr "The world, laid bare."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENT.BURNT"
msgid "睡的地方没了。"
msgstr "No place left to sleep."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENT.GENERIC"
msgid "不睡会变怪。我有经验。"
msgstr "Skip sleep, and turn strange. ...I have the experience."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE"
msgid "看着很危险。"
msgstr "A dangerous look."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLESPIKE"
msgid "又尖又滑。"
msgstr "Sharp, and slippery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLESPOTS"
msgid "听说是生殖器。"
msgstr "Reproductive organs, so I hear."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_GARDEN"
msgid "又是滑柱子。"
msgstr "Another slippery pillar."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_PILLAR"
msgid "滑的柱子。"
msgstr "A slippery pillar."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "小小的滑腕。"
msgstr "A small, slippery arm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "臭。不过值得下去看看。"
msgstr "Foul. But worth exploring."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "得等它凉下来。"
msgstr "It needs to cool."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.CRIMSON"
msgid "不好的预感。"
msgstr "An unwelcome premonition."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.ENABLED"
msgid "彩虹的那一边？"
msgstr "Beyond the rainbow?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.GENERIC"
msgid "看着，头都方了？"
msgstr "Staring at it. ...Will my head turn square?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "偷看的眼，已经赶走了。"
msgstr "The peeping eye. ...Already driven out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "这是什么，想到天亮了。"
msgstr "What is it. ...I will think on it until dawn."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "再不会扰人了。"
msgstr "It will bother no one again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "会偷看的箱子……应该没害处吧。"
msgstr "A peek inside the box. ...No harm in it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "有点不合场面。"
msgstr "A sense of wrongness about the place."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.THULECITE"
msgid "哪里来的东西。是个谜。"
msgstr "From where. ...A mystery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.THULECITEBUGNET"
msgid "近来的新话？"
msgstr "The latest trend?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.THULECITE_PIECES"
msgid "远古石的碎片。"
msgstr "Thulecite fragments."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.THURIBLE"
msgid "药水一样的味道。"
msgstr "A chemical smell."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.ABANDONED"
msgid "它自己能找到。"
msgstr "It can find them itself."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.GENERIC"
msgid "看着很熟练。"
msgstr "It looks practiced."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.LOST_TRACK"
msgid "被别人先找到了。"
msgstr "Someone else was found first."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.NEARBY"
msgid "附近像是有东西。"
msgstr "Something is nearby, it seems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "像是没什么可找的了。"
msgstr "Nothing left to find, it seems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.SUCCESS"
msgid "哦，找到了！"
msgstr "Oh, it found it!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "太远……味道传不到吧。"
msgstr "Too far. ...The scent will not carry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.TRACKING"
msgid "跟着它走。"
msgstr "It should be followed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "在给别人带路。"
msgstr "Guiding someone else, presently."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TILLWEED"
msgid "从地里出去。"
msgstr "Out of the garden."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TILLWEEDSALVE"
msgid "药膏，也算一点补救。"
msgstr "An ointment. ...Salvation."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TILLWEED_DRIED"
msgid "晒得正好。"
msgstr "Dried, and well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL.GENERIC"
msgid "不好亲近。"
msgstr "Not the friendly sort."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL.RAGE"
msgid "发怒了。那种感觉，我懂。"
msgstr "It rages. ...I know that feeling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "只是个洞。"
msgstr "Just a hole."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "等着被砍。"
msgstr "Waiting to be chopped."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "有东西要冒出来。"
msgstr "Something is sprouting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO"
msgid "红的。很漂亮的颜色。"
msgstr "Red. ...The color of science."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO_COOKED"
msgid "控好火，就是学问。"
msgstr "The science of heat control."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO_OVERSIZED"
msgid "番茄，超出规矩了。"
msgstr "A tomato. ...Out of spec."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOMATO_SEEDS"
msgid "一把奇妙的种子。"
msgstr "A handful of curious seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOPHAT"
msgid "很好的帽子。"
msgstr "A fine hat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOPHAT_MAGICIAN"
msgid "这帽子，很有派头。"
msgstr "A hat. ...Overflowing with style."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TORCH"
msgid "把夜挡在外面。"
msgstr "It holds back the night."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOURTIERE"
msgid "和肉派的相遇。"
msgstr "A meat pie, met at last."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "准备出发。"
msgstr "Ready to depart."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "金字塔。沙在动。"
msgstr "A pyramid. ...The sand is moving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "正常人都是走路的。"
msgstr "Sane people walk."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "小型的传送。又是沙。"
msgstr "A small teleportation. ...Sand."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAILMIX"
msgid "健康的零食。"
msgstr "A wholesome snack."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAILS"
msgid "手臂很有力。"
msgstr "Strong of arm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRANSISTOR"
msgid "电在里面响。"
msgstr "An electric hum."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP"
msgid "编得很紧。我自己编的。"
msgstr "Tightly woven. ...I could weave my own."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_BRAMBLE"
msgid "踩上去会很疼。"
msgstr "It hurts whoever steps in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "冷着，效力薄。"
msgstr "Cold state. ...The effect is thin."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "口袋，快烧穿了。"
msgstr "My pocket. ...Nearly burnt through."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "不想踩上去。"
msgstr "I would rather not step on it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "已经凉了，仍旧危险。"
msgstr "It has cooled. ...Still dangerous."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "咬上来了！"
msgstr "It has come to bite!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "唔，可爱的海星。"
msgstr "Mm, a cute starfish."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_TEETH"
msgid "讨厌的陷阱。"
msgstr "A distasteful trap."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "得躲开，别踩上。"
msgstr "It must be stepped around."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST.BURNT"
msgid "箱子没了。"
msgstr "The chest is gone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST.GENERIC"
msgid "装玩具的箱子。"
msgstr "A toy box."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "容量变大了。"
msgstr "Capacity increased."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREASURECHEST_TRAP"
msgid "太方便了吧。"
msgstr "Convenient?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREECLUMP"
msgid "拦路的一堆树。"
msgstr "A wall in my way."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREEGROWTHSOLUTION"
msgid "唔，给树喝的。"
msgstr "Mm. ...A tree drink."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK.BURNING"
msgid "藤在烧，太热了。"
msgstr "The vines burn. ...Overheating."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "没了支撑。"
msgstr "Support, lost."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK.GENERIC"
msgid "缠着藤。"
msgstr "The vines entwine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK_SAPLING"
msgid "长在石上的苗。起步就苦。"
msgstr "A sprout clinging to rock. ...A hard start."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TREE_ROCK_SEED"
msgid "种子。"
msgstr "Seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRIDENT"
msgid "正好显显手上的功夫。"
msgstr "A chance to show my mettle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINITY_IMPACT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINITY_IMPACT"
msgid "火、冰、雷三相轮转。一击之中藏着三重杀意。"
msgstr "Fire, ice and thunder in rotation. Three killing intents within one strike."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_1"
msgid "熔了。威洛玩过？"
msgstr "Melted. ...Has Willow been playing?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_10"
msgid "假牙。韦斯爱用。"
msgstr "False teeth. ...Wes favors them."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_11"
msgid "机器人在低语。漂亮的谎。"
msgstr "A robot's whisper. ...A beautiful lie."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_12"
msgid "干了的触手。做实验的材料。"
msgstr "A dried tentacle. ...Fit for experiments."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_13"
msgid "像是宗教用的东西。女侏儒的。"
msgstr "A religious object, it seems. ...A female gnome."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_14"
msgid "漏的茶杯。茶不够喝。"
msgstr "A leaking teacup. ...Never enough tea."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_15"
msgid "麦斯威尔又乱放东西。"
msgstr "Maxwell left it out again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_16"
msgid "麦斯威尔又乱放东西。"
msgstr "Maxwell left it out again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_17"
msgid "叉子和勺子合体。可怕。"
msgstr "Fork and spoon, fused. ...Terrifying."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_18"
msgid "里面藏了什么。"
msgstr "What is hidden inside?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_19"
msgid "转得不太顺。"
msgstr "It will not turn well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_2"
msgid "假的笛子。呜。"
msgstr "A fake flute. ...Toot."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_20"
msgid "薇格弗丽德拿它打过架？"
msgstr "Wigfrid won this in battle?!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_21"
msgid "搅蛋器弯了。"
msgstr "The egg beater is bent."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_22"
msgid "线。理论上有好几种用法。"
msgstr "String. ...I have several theories."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_23"
msgid "鞋拔子。我自己能穿。"
msgstr "A shoehorn. ...I can dress myself."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_24"
msgid "猫罐子。维克波顿养猫？"
msgstr "A cat can. ...Wickerbottom's cat?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_25"
msgid "空的，气味很臭。"
msgstr "The air smells foul."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_26"
msgid "既是碗又是杯。合理。"
msgstr "Dish and cup in one. ...Sensible."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_27"
msgid "伸开就能刺到远处。"
msgstr "It stretches far enough to prick."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_28"
msgid "算计人用的棋子。"
msgstr "A pawn of intrigue."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_29"
msgid "算计人用的棋子。"
msgstr "A pawn of intrigue."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_3"
msgid "结解不开。永远解不开。"
msgstr "A knot that cannot be undone. ...Ever."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_30"
msgid "又乱放在外面。"
msgstr "Left out again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_31"
msgid "又乱放在外面。"
msgstr "Left out again."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_32"
msgid "球。要有人一起玩才行。"
msgstr "A ball. ...I have someone to play with."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_33"
msgid "蜘蛛的戒指。……嗯。可爱。"
msgstr "A spider ring. ...Mm. ...Cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_34"
msgid "猿猴的手。许个愿试试。"
msgstr "A monkey's paw. ...Tempted to make a wish."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_35"
msgid "空的药瓶。"
msgstr "An empty medicine bottle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_36"
msgid "糖果吃完了还想要。"
msgstr "I will ask after the candy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_37"
msgid "超自然，我信的。……大概。"
msgstr "Supernatural... I am a believer. ...And this is it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_38"
msgid "从别的世界来的。骗人的世界。"
msgstr "From another world. ...A swindler's world."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_39"
msgid "另一个在哪。"
msgstr "Another where?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_4"
msgid "像是宗教用的东西。侏儒的。"
msgstr "A religious object, it seems. ...A gnome."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_40"
msgid "拿着就想谈买卖。"
msgstr "It has the air of a trade."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_41"
msgid "摸着是温的。"
msgstr "Warm to the touch."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_42"
msgid "装满了小时候的记忆。"
msgstr "Full of childhood memories."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_43"
msgid "跳得起来，也不必得意。"
msgstr "I am no good at jumping."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_44"
msgid "像植物的标本。"
msgstr "It resembles a plant specimen."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_45"
msgid "能收到别的世界的电波。"
msgstr "It receives radio waves from another world."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_46"
msgid "空气力学的实验用具？"
msgstr "An aerodynamic testing device?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_5"
msgid "太小，坐不下。逃不出去。"
msgstr "Too small to sit in. ...Escape is hopeless."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_6"
msgid "电线到寿了。"
msgstr "The wire has met its end."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_7"
msgid "玩的时间没了。"
msgstr "Time to play has run out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_8"
msgid "塞子。洗浴够用。"
msgstr "A plug. ...Sufficient for a bath."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRINKET_9"
msgid "扣子。不对。"
msgstr "A button. ...No, it is not."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "火候，过了。"
msgstr "Fire degree... full marks."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "能自夸的凭据烧没了。"
msgstr "The right to boast, burnt away."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "今天的渔获有几公斤？"
msgstr "How many kilos is today's catch?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "重量：{weight}\n钓手：{owner}"
msgstr "Weight: {weight}\nAngler: {owner}"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "重量：{weight}\n钓手：{owner}\n。好大一条！"
msgstr "Weight: {weight}\nAngler: {owner}\n...A big one!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "就不谦虚了，\n重量：{weight}\n钓手：{owner}"
msgstr "No more humility...\nWeight: {weight}\nAngler: {owner}"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "重量：{weight}\n钓手：{owner}\n。那一条没跑成！"
msgstr "Weight: {weight}\nAngler: {owner}\n...That one did not get away!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "唔，在烤什么？"
msgstr "Mm. ...What is roasting?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "这可不是好的做法。"
msgstr "Best served cooked. ...It is not."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "收获的重量，能称出来。"
msgstr "The harvest's weight. ...It can be measured."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "重量：{weight}\n收获日：{day}\n。不错。"
msgstr "Weight: {weight}\nHarvest day: {day}\n...Not bad."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "重量：{weight}\n收获日：{day}\n。能长这么大？"
msgstr "Weight: {weight}\nHarvest day: {day}\n...It can grow this big?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "太平常，重量都不必写。"
msgstr "Too ordinary. ...The weight does not even show."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNKVEST_SUMMER"
msgid "在野外穿着轻便。"
msgstr "Casual wear for the field."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNKVEST_WINTER"
msgid "过冬的装备。"
msgstr "Winter survival gear."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNK_COOKED"
msgid "鼻音更重了。"
msgstr "The nasal notes grew heavier."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNK_SUMMER"
msgid "轻，也凉。是鼻子。"
msgstr "A light, cool trunk."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TRUNK_WINTER"
msgid "厚毛的鼻子。"
msgstr "A thick, furry trunk."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TUMBLEWEED"
msgid "风滚草。里面藏着东西。"
msgstr "A tumbleweed. ...Treasure hides within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURFCRAFTINGSTATION"
msgid "做地皮的台子。又开了一门。"
msgstr "A turf crafting station. ...New frontiers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_ARCHIVE"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_BADLANDS"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_BEARD_RUG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_BEARD_RUG"
msgid "胡子做的地毯。谁的。"
msgstr "A beard rug. ...Whose."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CARPETFLOOR"
msgid "扎脚。"
msgstr "Prickly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CARPETFLOOR2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CARPETFLOOR2"
msgid "意外地软。"
msgstr "Surprisingly soft."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CAVE"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_CHECKERFLOOR"
msgid "格子。漂亮。"
msgstr "Checkered. ...Fine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_COTL_BRICK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_COTL_BRICK"
msgid "砖，做地面正好。"
msgstr "Brick. ...The foundation of floors."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_COTL_GOLD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_COTL_GOLD"
msgid "别踩，很贵。"
msgstr "Do not step. ...Expensive."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DECIDUOUS"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DESERTDIRT"
msgid "沙漠的土。"
msgstr "Desert turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DIRT"
msgid "一块土。"
msgstr "A patch of dirt."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_DRAGONFLY"
msgid "耐火的证明。龙蝇的地盘。"
msgstr "Proof of fire resistance. ...Dragonfly territory."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FOREST"
msgid "森林的土。"
msgstr "Forest turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "绿色菌丝的地面。"
msgstr "Green fungal ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS_MOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS_MOON"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_FUNGUS_RED"
msgid "红色菌丝的地面。"
msgstr "Red fungal ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_GRASS"
msgid "草地的土。"
msgstr "Grassland turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MARSH"
msgid "沼泽的土。"
msgstr "Marsh turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_METEOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_METEOR"
msgid "月亮的土。"
msgstr "Lunar turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MONKEY_GROUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MONKEY_GROUND"
msgid "猴子的沙地。"
msgstr "The monkeys' sandy ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MOSAIC_BLUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MOSAIC_BLUE"
msgid "蓝色的拼花地。"
msgstr "Mosaic, blue."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MOSAIC_GREY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MOSAIC_GREY"
msgid "灰色的拼花地。"
msgstr "Mosaic, grey."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MOSAIC_RED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MOSAIC_RED"
msgid "红色的拼花地。"
msgstr "Mosaic, red."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_MUD"
msgid "泥地面。"
msgstr "Muddy ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_PEBBLEBEACH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_PEBBLEBEACH"
msgid "沙滩的土。"
msgstr "Beach turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_ROAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_ROAD"
msgid "匆匆铺成的石路。"
msgstr "Hastily laid stone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_ROCKY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_ROCKY"
msgid "岩石地的土。"
msgstr "Rocky turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSBRICK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSBRICK"
msgid "遗迹的砖。"
msgstr "Ruins brick."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSBRICK_GLOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSBRICK_GLOW"
msgid "遗迹的砖。会发光。"
msgstr "Ruins brick. ...Glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTILES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTILES"
msgid "遗迹的瓷砖。"
msgstr "Ruins tiles."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTILES_GLOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTILES_GLOW"
msgid "遗迹的瓷砖。会发光。"
msgstr "Ruins tiles. ...Glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTRIM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTRIM"
msgid "遗迹的缘石。"
msgstr "Ruins trim."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTRIM_GLOW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_RUINSTRIM_GLOW"
msgid "遗迹的缘石。会发光。"
msgstr "Ruins trim. ...Glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SANDY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SANDY"
msgid "沙地面。"
msgstr "Sandy ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SAVANNA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SAVANNA"
msgid "草原的土。"
msgstr "Savanna turf."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SHELLBEACH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SHELLBEACH"
msgid "贝壳沙滩。"
msgstr "A shell beach."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_SINKHOLE"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_UNDERROCK"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_VAULT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_VAULT"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_VENT"
msgid "又一种地面。"
msgstr "Another kind of ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURF_WOODFLOOR"
msgid "木地板。"
msgstr "Wood flooring."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURKEYDINNER"
msgid "唔，唔。"
msgstr "Mm, mm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURNIP"
msgid "生的根菜。"
msgstr "A raw turnip."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURNIP_COOKED"
msgid "火候决定一切。"
msgstr "The heat decides everything."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURNIP_SEEDS"
msgid "一把奇妙的种子。"
msgstr "A handful of curious seeds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TURTILLUS"
msgid "壳上带尖！"
msgstr "A sharp shell!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.BURNING"
msgid "在浪费木头。"
msgstr "Such a waste of wood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.BURNT"
msgid "本来是能拦住的……"
msgstr "This could have been prevented..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "对不住这片林子。"
msgstr "My apologies, nature."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "病了。平时就很细。"
msgstr "Sick. ...Worse than usual."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "枝条很多的树。"
msgstr "A twiggy tree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGY_NUT"
msgid "枝树想从这里长出来。"
msgstr "A twiggy tree wants out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "不必帮忙。"
msgstr "It needs no help."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGGY_OLD"
msgid "很弱的树。"
msgstr "A frail tree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWIGS"
msgid "一束细枝。"
msgstr "A bundle of twigs."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWINOFTERROR1"
msgid "算是友好……也许。……不，也许不是。"
msgstr "Friendly. ...Perhaps. ...No. Not perhaps."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.TWINOFTERROR2"
msgid "算是友好……也许。……不，也许不是。"
msgstr "Friendly. ...Perhaps. ...No. Not perhaps."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.UMBRELLA"
msgid "头发湿了会乱。讨厌。"
msgstr "My hair swells with damp. ...Unpleasant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.UNAGI"
msgid "鳗鱼饭。奢侈了。"
msgstr "Eel over rice. ...A luxury."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.UNIMPLEMENTED"
msgid "还没做完！碰不得。"
msgstr "Unfinished! It may be dangerous."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "灯灭了。"
msgstr "Lights out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "没有比它好的。"
msgstr "Beyond compare."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "指向这间屋子。"
msgstr "It guides to this room."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "在这里不管用。"
msgstr "It does not work here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "时机最差，偏偏掉下来。"
msgstr "The worst timing. ...It dropped down."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "像个灯泡，刚好。"
msgstr "Like a light bulb. ...A perfect fit."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "来路不明的拉杆。能坏到哪去？"
msgstr "A mysterious lever. ...How bad could it be?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_DECON_DOOR"
msgid "关人进去？挡人在外？"
msgstr "Locked in? ...Or kept out?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_DECON_MISTER"
msgid "说不清……"
msgstr "Mysterious..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY"
msgid "回家的钥匙，终于？"
msgstr "The key home. ...At last?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "脑子里，闪过一道光。"
msgstr "Within my head. ...A flash of insight."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_EXIT"
msgid "这里系不上绳。"
msgstr "The rope cannot be tied here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "整把的钥匙。"
msgstr "The master key."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "空了。"
msgstr "Empty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "系上绳，就能爬回去。"
msgstr "Tie a rope. ...And one can climb back."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_ORB"
msgid "这颗玉……大概有用处。"
msgstr "This orb. ...It likely has a purpose."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_ORB_REFINED"
msgid "让人动心。"
msgstr "It stirs me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "起头，处得不好。"
msgstr "At the start. ...We got off badly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "还缺什么？"
msgstr "What is still missing?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "得找个好地方。"
msgstr "It needs a good location."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "谁也过不去！"
msgstr "No one may pass!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "塔。"
msgstr "A tower."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "还差个火花。"
msgstr "It needs a spark of inspiration."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "那走动的塔，要紧的部件。"
msgstr "That walking tower. ...A vital part."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "古时的手艺！"
msgstr "Ancient technology!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_RUNE"
msgid "读不懂。"
msgstr "Unreadable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_STATUE.LORE1"
msgid "像是不好的结局。"
msgstr "It looks like a dark ending."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_STATUE.LORE2"
msgid "虫，不太舒服。"
msgstr "Worms. ...Unpleasant."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_STATUE.LORE3"
msgid "很尖。我有一点意见。"
msgstr "A pointed opinion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "坏了。"
msgstr "Broken."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "这部件，让人动心。"
msgstr "This part. ...It stirs me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "缺动力。"
msgstr "It wants power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TELEPORTER_UNDERCONSTRUCTION"
msgid "「此处路牌，待日后再改。」"
msgstr "\"This signpost awaits a future update.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "开关像是坏了。"
msgstr "The switch seems broken."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "灯的开关？"
msgstr "A light switch?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VEGGIEOMLET"
msgid "早饭，讲究的一顿。"
msgstr "Breakfast. ...The most scientific meal of the day."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "烂了，可惜。"
msgstr "Rotted. A waste."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VEGSTINGER"
msgid "拿菜当吸管？"
msgstr "Use the celery as a straw?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "像老人家的衣裳。"
msgstr "It resembles grandmother's dress."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH"
msgid "那些影，本是同一块布。"
msgstr "The shadows. ...All one cloth."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTHHAT"
msgid "暗得有些神秘。"
msgstr "A dark air of mystery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "保证飞得回来？"
msgstr "A return guarantee, is there?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_KIT"
msgid "缝影的法子，只知一半。"
msgstr "Shadow tailoring. ...Fragments of knowledge."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "割得太顺手了。我也想有一把。"
msgstr "Reaping, far too easy. ...Somewhat envious."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "头发被酸雨浇坏。最难受。"
msgstr "Hair dissolved by acid. ...Most detested."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.VOLTGOATJELLY"
msgid "带电的美味。"
msgstr "An electrifying delicacy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAFFLES"
msgid "还要糖浆吗。……犯难。"
msgstr "More syrup, please. ...A dilemma."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT"
msgid "很带劲！"
msgstr "Charming!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "还盖着。"
msgstr "Presently under cover."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "大机件，小包裹。"
msgstr "A great robot. ...In a small package."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "拆散着放。"
msgstr "In a dismantled state!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "撑了一阵！"
msgstr "It held out for a while!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "试过重开吗？"
msgstr "Have you tried restarting it?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "有意思。"
msgstr "Interesting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_BEACON"
msgid "帮着封住路。"
msgstr "A blockade, assisted."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "修不了，零件还能取。"
msgstr "Beyond repair. ...The parts can be reclaimed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "飞得很快的机件。"
msgstr "A swift robot."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "该试着转一转。"
msgstr "It should be test-spun."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_PARTS"
msgid "零件，正面朝上。"
msgstr "Parts. ...Turning clockwise."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "修一修，或者拆了取件。"
msgstr "Repair it. ...Or strip it for parts."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "转起来就赢！"
msgstr "If it spins, it wins!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "嗡嗡，一直响。"
msgstr "Buzz, buzz. ...It continues."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "该试着转一转。"
msgstr "It should be test-spun."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNKBITS_KIT"
msgid "用机件修机件！没有尽头。"
msgstr "A machine that repairs machines! ...Science has no limits."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNKHAT"
msgid "脑子里的齿轮，转起来了。"
msgstr "Gears in the brain. ...Turning."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_BITS"
msgid "能做出出奇的东西。"
msgstr "Superscientific goods can be made."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "要么有墙，要么没有！"
msgstr "A wall. ...Or none!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "这地板，是什么。"
msgstr "This flooring. ...What is it?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_LEVER"
msgid "该扳的时候要看准。"
msgstr "A fine moment to switch."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "开工！"
msgstr "Work, begin!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "奇怪，这手套不是影。"
msgstr "Strange. ...These gloves are no projection."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "这写字板，是实的。"
msgstr "This writing board. ...The real thing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "一堆废铁……也许有得挑。"
msgstr "A mountain of refuse. ...There may be finds."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "是光！是照的！脑子要涨开了！"
msgstr "Fascinating! ...Illuminating! ...Mind-expanding!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_NPC"
msgid "同路的人，该帮一把。"
msgstr "A fellow man of science. ...He should be helped."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "他一刻也不歇。"
msgstr "Science knows no rest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "去哪里了呢。"
msgstr "Where is he off to."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "这个，就是要找的东西！"
msgstr "This. ...The tool I was to find!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "知道！只是，说来太长。"
msgstr "I know! ...It is only. ...The explanation is too complex."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "明摆着是个器具。"
msgstr "An obviously scientific tool."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "凭感觉……应该就是这个。"
msgstr "Instinct. ...This is the right tool."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "用处我全明白！……大概。"
msgstr "Its use, fully understood! ...Probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WAKABA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WAKABA"
msgid "那位大人，深不可测。不可失礼。"
msgstr "That one... unfathomable. Mind your manners."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK"
msgid "救生的木板，不跳就好了？"
msgstr "A lifeboat... so long as no one jumps?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "不如做条救生的小舟？"
msgstr "Would it not make a better lifeboat?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK_GRASS"
msgid "救生的木板，不跳就好了？"
msgstr "A lifeboat... so long as no one jumps?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKINGPLANK_YOTD"
msgid "装点一下，心思没变。"
msgstr "An ornament. ...My mood, unchanged."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALKING_STICK"
msgid "上等的杖。"
msgstr "A first-class cane."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_DREADSTONE"
msgid "算安心吗……？"
msgstr "Reassuring...?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "出不了坏事吧？"
msgstr "No harm will come of it?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_HAY.BURNT"
msgid "不行了。"
msgstr "No longer any good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_HAY.GENERIC"
msgid "唔。……这样也行吧。"
msgstr "Mm. ...It will do, I suppose."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_HAY_ITEM"
msgid "像是个坏主意。"
msgstr "It looks like a poor idea."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_MOONROCK"
msgid "宇宙来的，很滑！"
msgstr "Cosmic slickness!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "轻。不过很硬。"
msgstr "Light. But hard."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_RUINS"
msgid "古代墙的断片。"
msgstr "A fragment of ancient wall."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_RUINS_2"
msgid "古墙的一块。"
msgstr "A fragment of ancient wall."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_RUINS_ITEM"
msgid "凝住的历史。"
msgstr "A solid chunk of history."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_SCRAP"
msgid "废料做的。"
msgstr "Made of scrap."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_SCRAP_ITEM"
msgid "废料捆成一束。"
msgstr "It looks like a bundle of scrap."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_STONE"
msgid "好墙。"
msgstr "A good wall."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_STONE_2"
msgid "好墙。"
msgstr "A good wall."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_STONE_ITEM"
msgid "让人安心。"
msgstr "A sense of security."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_WOOD.BURNT"
msgid "焦了！"
msgstr "Charred!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_WOOD.GENERIC"
msgid "很尖！"
msgstr "Sharp!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALL_WOOD_ITEM"
msgid "带尖的栅栏。"
msgstr "A sharp fence."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS"
msgid "海象是天生的猎手。"
msgstr "A walrus, a natural predator."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUSHAT"
msgid "一身海象的毛。"
msgstr "Clad in walrus fur."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "有露营的痕迹。"
msgstr "Traces of a camp remain."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "里面像是很暖。"
msgstr "It looks warm within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALRUS_TUSK"
msgid "总有用得上的时候。"
msgstr "A use will arise, surely."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALTER.ATTACKER"
msgid "先锋不该是这样。"
msgstr "This is not what scouting means. %s."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALTER.FIRESTARTER"
msgid "%s……这不是篝火。"
msgstr "%s... That is no bonfire."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.WALTER.GENERIC"
msgid "少年斥候。帽子太大了。"
