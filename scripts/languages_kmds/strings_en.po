msgstr "A ring that can gather dimensional energy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TELESTAFF"
msgid "那个能把世界揭开。"
msgstr "That one could peel the world open."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENT.BURNT"
msgid "没有能睡的地方了。"
msgstr "Nowhere left to sleep."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENT.GENERIC"
msgid "不睡的话，我会变得很疯。"
msgstr "Without sleep, I will go quite insane."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE"
msgid "那个看着危险。"
msgstr "That looks dangerous."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLESPIKE"
msgid "又尖又滑。"
msgstr "Sharp and slippery."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLESPOTS"
msgid "这应该是它的生殖器官。"
msgstr "These should be its reproductive organs."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_GARDEN"
msgid "又一根滑腻的柱子。"
msgstr "Another slimy pillar."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_PILLAR"
msgid "一根滑腻的柱子。"
msgstr "A slimy pillar."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "滑腻的小手。"
msgstr "Slimy little hands."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "很臭。但值得探。"
msgstr "Very smelly. But worth exploring."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "它需要冷一下。"
msgstr "It needs to cool off."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.CRIMSON"
msgid "这个让我有不好的感觉。"
msgstr "This gives me a bad feeling."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.ENABLED"
msgid "我在彩虹的另一边吗。"
msgstr "Am I on the other side of the rainbow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.GENERIC"
msgid "看着它，我的头有点发麻……或者说发方。"
msgstr "Looking at it makes my head tingle... or rather, go square."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "现在不会再有窥探的眼睛来烦我了。"
msgstr "No more prying eyes to bother me now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "那会是什么。也许睡一觉再想。"
msgstr "What could that be. Maybe sleep on it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "它不会再烦到任何人了。"
msgstr "It won't bother anyone anymore."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "往箱子里看一眼能有什么害处。"
msgstr "What harm could one peek into the box do."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "那个有点不合这里。"
msgstr "That one doesn't quite belong here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.THULECITE"
msgid "这东西是哪来的。"
msgstr "Where did this thing come from."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.THULECITEBUGNET"
msgid "有人听到最新的消息吗。"
msgstr "Anyone heard the latest news."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.THULECITE_PIECES"
msgid "铥矿的碎块。"
msgstr "Chunks of thulecite."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.THURIBLE"
msgid "一股药味。"
msgstr "A medicinal smell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.ABANDONED"
msgid "我自己也能找到它们。"
msgstr "I can find them myself."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.GENERIC"
msgid "他看起来很懂自己在做什么。"
msgstr "He looks like he knows what he's doing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.LOST_TRACK"
msgid "别人先找到了。"
msgstr "Someone found it first."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.NEARBY"
msgid "附近好像有东西。"
msgstr "Something seems to be nearby."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "看起来没有剩下可找的了。"
msgstr "Looks like nothing's left to find."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.SUCCESS"
msgid "他找到一只了。"
msgstr "He found one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "它们大概太远，他闻不到。"
msgstr "They're probably too far for him to smell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.TRACKING"
msgid "该跟着他走。"
msgstr "Time to follow him."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "他在替别人带路。"
msgstr "He's leading for someone else."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TILLWEED"
msgid "从我的园子里出去。"
msgstr "Out of my garden."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TILLWEEDSALVE"
msgid "我的救命药。"
msgstr "My lifesaving medicine."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TILLWEED_DRIED"
msgid "晒得不错。"
msgstr "Dried nicely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL.GENERIC"
msgid "那种东西，我不会去亲。"
msgstr "I won't be kissing that thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL.RAGE"
msgid "它跳得很生气。"
msgstr "It's hopping in a fury."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "地上一个洞。"
msgstr "A hole in the ground."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "那朵毒菌摆明了在求人砍它。"
msgstr "That toadstool is clearly begging to be chopped."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "有东西顶出来了。"
msgstr "Something pushed its way out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO"
msgid "它红，是因为里面全是学问。"
msgstr "It's red because it's full of learning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO_COOKED"
msgid "懂化学的话，做菜很容易。"
msgstr "Cooking is easy if you understand chemistry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO_OVERSIZED"
msgid "一颗尺寸惊人的番茄。"
msgstr "A tomato of astonishing dimensions."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOMATO_SEEDS"
msgid "一把奇怪的种子。"
msgstr "A handful of strange seeds."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOPHAT"
msgid "不错的帽子。"
msgstr "A fine hat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOPHAT_MAGICIAN"
msgid "那顶帽子渗着风格。"
msgstr "That hat exudes style."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TORCH"
msgid "用来推开夜色的东西。"
msgstr "A thing for pushing back the night."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOURTIERE"
msgid "很高兴吃到你。"
msgstr "Pleased to eat you."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "可以出发了。"
msgstr "Ready to depart."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "这座金字塔控制着沙子。"
msgstr "This pyramid commands the sand."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "正常人会选择走路。"
msgstr "A normal person would walk."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "小型的传送装置。"
msgstr "A compact teleporter."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAILMIX"
msgid "健康的天然零食。"
msgstr "A healthy natural snack."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAILS"
msgid "他的手臂很有力。"
msgstr "His arms are powerful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRANSISTOR"
msgid "它带着电在响。"
msgstr "It hums with electricity."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP"
msgid "我编得很紧。"
msgstr "I wove this tightly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_BRAMBLE"
msgid "谁踩上去都会被扎透。"
msgstr "Whoever steps on it gets skewered."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "冷的时候它们没什么用。"
msgstr "Cold, they're useless."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "它们在我口袋里烧出一个洞。"
msgstr "They're burning a hole in my pocket."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "我不想从那上面走过去。"
msgstr "I don't want to walk over that."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "它凉下来了，但还能造成伤害。"
msgstr "It's cooled a bit, but can still do damage."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "它想咬我。"
msgstr "It wants to bite me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "小号的陷阱。"
msgstr "A small trap."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_TEETH"
msgid "这是个难受的意外。"
msgstr "An unpleasant surprise."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "不要踩上去。"
msgstr "Don't step on it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST.BURNT"
msgid "那个箱子被截断了。"
msgstr "That chest got truncated."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST.GENERIC"
msgid "一个会变戏法的箱子。"
msgstr "A chest that performs tricks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "容量明显变大了。"
msgstr "Its capacity has grown noticeably."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREASURECHEST_TRAP"
msgid "真方便。"
msgstr "How convenient."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREECLUMP"
msgid "像是有人不想让我去某个地方。"
msgstr "As if someone didn't want me going somewhere."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREEGROWTHSOLUTION"
msgid "树的食物。"
msgstr "Tree food."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK.BURNING"
msgid "它的领子下面有点热。"
msgstr "It's a bit hot under its collar."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "它失去了支撑。"
msgstr "It lost its support."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK.GENERIC"
msgid "在我看来是藤。"
msgstr "Looks like a vine to me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK_SAPLING"
msgid "它的起步很坎坷。"
msgstr "Its start has been rocky."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TREE_ROCK_SEED"
msgid "一颗种子。"
msgstr "A seed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRIDENT"
msgid "这会很响。"
msgstr "This will be loud."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINITY_IMPACT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINITY_IMPACT"
msgid "三属性轮换。下一次是什么，由随机数决定。"
msgstr "Three elements in rotation. The next one is decided by a random number."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_1"
msgid "熔了。是那个玩火的女孩干的吗。"
msgstr "Melted. Was it that fire-playing girl's doing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_10"
msgid "它很快成了韦斯最爱的道具。"
msgstr "It quickly became Wes's favorite prop."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_11"
msgid "哈尔对我说着漂亮的谎。"
msgstr "Hal tells me pretty lies."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_12"
msgid "这东西摆明了在求人拿它做实验。"
msgstr "This thing is clearly begging to be experimented on."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_13"
msgid "这应该是某种宗教物件。"
msgstr "This should be some kind of religious object."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_14"
msgid "要是再有点茶就好了。"
msgstr "If only there were some tea."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_15"
msgid "麦斯威尔又把东西乱放了。"
msgstr "Maxwell left his things lying about again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_16"
msgid "麦斯威尔又把东西乱放了。"
msgstr "Maxwell left his things lying about again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_17"
msgid "可怕的餐具融合体。有些学问确实过头了。"
msgstr "A dreadful cutlery amalgam. Some learning truly goes too far."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_18"
msgid "它藏着什么。"
msgstr "What is it hiding."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_19"
msgid "转得不太好。"
msgstr "It doesn't spin well."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_2"
msgid "这卡祖笛怎么了。"
msgstr "What happened to this kazoo."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_20"
msgid "薇格弗德总会跳出来用它打我。"
msgstr "Wigfrid will always leap out and hit me with this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_21"
msgid "这个打蛋器已经完全变形了。"
msgstr "This egg beater is completely deformed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_22"
msgid "关于这根线，我有几个推论。"
msgstr "I have a few inferences about this string."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_23"
msgid "我自己能穿鞋。多谢。"
msgstr "I can put my shoes on myself. Thanks."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_24"
msgid "薇克伯顿大概养过猫。"
msgstr "Wickerbottom probably kept a cat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_25"
msgid "闻着有点陈。"
msgstr "Smells a bit stale."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.TRINKET_26"
msgid "食物加杯子。终极的求生容器。"
