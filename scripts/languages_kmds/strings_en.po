#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEAT_DRIED"
msgid "肉干，正好。"
msgstr "Jerky, just right."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEGAFLARE"
