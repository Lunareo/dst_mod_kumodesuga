msgstr "You can't tell from afar, but it stinks."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "长得太过头啦～这样很显眼哟～"
msgstr "Too big by half."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "被酸糊了一层呢～别碰哟～"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "丝缠了这么多呀～看来这些孩子很中意这棵树呢～"
msgstr "The spiders value it, so much silk."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBEARGER"
msgid "要变麻烦了呢～真期待～"
msgstr "This is about to get troublesome."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBIRD"
msgid "稀有的鸟吧，大概～"
msgstr "A rare bird, probably."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "正在吃腐肉呢～请无视吧～"
msgstr "Eating carrion, kindly look away."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "尸体的样子～挺忠实呢～"
msgstr "Corpse-shaped, faithful."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDDEERCLOPS"
msgid "眼睛里有东西哟～"
msgstr "There's something in its eye."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "呼吸停了呢～安静下来啦～"
msgstr "Its breathing has settled."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "变异的犬～危险哟～"
msgstr "A mutated hound, dangerous."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "想逃的冲动特别强烈呢～"
msgstr "A strong urge to flee."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATEDWARG"
msgid "眼睛好大～还发着光呢～"
msgstr "Big eyes, glowing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "结束啦～"
msgstr "It's over."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "变异过头啦～"
msgstr "Mutated way too far~"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "运气不错，它在睡呢～"
msgstr "Lucky me, it sleeps."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUTATOR_DROPPER"
