msgstr "So much knowledge, sadly unreadable."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
