msgstr "The scholarly term... \"dried\"."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "干肉要些时候。"
msgstr "Jerkying takes time."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
