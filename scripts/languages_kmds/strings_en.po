msgstr "Your Majesty!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE.BURNT"
msgid "王座，本来就有鱼味。"
msgstr "The throne. ...Fish-stench from the start."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE.GENERIC"
msgid "给沼王的王座。"
msgstr "A throne for the marsh king."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "用处大概永远不明了。"
msgstr "Its use will forever remain a mystery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "她在打算什么？"
msgstr "What is she planning?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "没有王的近卫。"
msgstr "The royal guard, without a king."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMWATCHTOWER_REGULAR"
