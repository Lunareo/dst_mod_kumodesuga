msgid "还会长回来吗。"
msgstr "Will it return?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOARDS"
msgid "木板。"
msgstr "Wooden boards."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOARON"
msgid "能打倒。"
msgstr "It can be felled."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOARRIOR"
msgid "很大！"
msgstr "Big!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATFRAGMENT03"
msgid "只剩一点残骸。"
msgstr "Little remains."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATFRAGMENT04"
msgid "只剩一点残骸。"
msgstr "Little remains."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATFRAGMENT05"
msgid "只剩一点残骸。"
msgstr "Little remains."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATPATCH"
msgid "为难时备着。"
msgstr "Disaster preparedness."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATPATCH_KELP"
msgid "先将就着。"
msgstr "A stopgap, for now."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "查验的地方！"
msgstr "A checkpoint!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "清单上再添一项。"
msgstr "One item, added to the checklist."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "被盯上了！"
msgstr "I am being marked!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK"
msgid "浮标，又是浮标。"
msgstr "A buoy. ...Another buoy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "浮标，又是浮标。"
msgstr "A buoy. ...Another buoy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "浮标，又是浮标。"
msgstr "A buoy. ...Another buoy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "浮标，又是浮标。"
msgstr "A buoy. ...Another buoy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "有人助威，心也热了。"
msgstr "Cheering. ...It has kindled."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_START"
msgid "总得有个起头。"
msgstr "Every course has a start."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "起点在哪。"
msgstr "A start, where?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "「货物」，船上人的说法。就是东西。"
msgstr "\"Cargo\". ...The sailor's term for. ...\"Things\"."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "老法子，看样子。"
msgstr "An old-style method. ...It seems."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "船上，也有了王的体面。"
msgstr "The boat. ...The crown's glory."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "给船围一圈。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_KELP"
msgid "挡不住全部，多少有用。"
msgstr "It cannot prevent everything. ...Helpful enough."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "给船围一圈。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "贝壳挡着。"
msgstr "A defense of shells."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "给船围一圈。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "撞上龙船，会被角顶。"
msgstr "Bumping the dragon boat. ...Gored by horns."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "给船围一圈。"
msgstr "A boat fender, planned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "炮能放了！"
msgstr "The cannon, ready to fire!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "该装弹了。"
msgstr "Ammunition should be loaded."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "没忘，只是还在等。"
msgstr "Not forgotten. ...Expectations, under cultivation."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_CANNON_KIT"
msgid "还不算炮。快了。"
msgstr "Not yet a cannon. ...Soon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_GRASS_ITEM"
msgid "姑且算条船。"
msgstr "A boat, provisionally."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ITEM"
msgid "想在水上试一试。"
msgstr "I want to experiment on the water."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_LEAK"
msgid "趁没沉，先补上。"
msgstr "Patch it before it sinks."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "动了！自然在预料里。"
msgstr "It moved! ...Within expectation, of course."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "被拉过去了，说不出名目。"
msgstr "Attracted by physics. ...The word will not come to me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "拉力！"
msgstr "Magnetism!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "附近有强的磁石。会被拉走。"
msgstr "A strong magnet nearby. ...It will be pulled in."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_MAGNET_KIT"
msgid "好点子。自夸一句。"
msgstr "A genius idea. ...If I say so myself."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ROTATOR"
msgid "方向对了。……也许该往左。"
msgstr "The direction is correct. ...Left, perhaps."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "该试着转一转。"
msgstr "It should be test-spun."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "牛毛做的。气味还在。"
msgstr "Beefalo wool. ...The smell lingers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_KELP"
msgid "太湿了。"
msgstr "Damp beyond reason."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_PETALS"
msgid "比牛毛的枕头香。"
msgstr "Fragrant, unlike the beefalo wool pillow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "谁会睡这个。"
msgstr "Who sleeps on this?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOMB_LUNARPLANT"
msgid "草木和火药，凑成一路。"
msgstr "Botany, plus chemistry. ...In cooperation."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "那株植物人……月的力好像醒了。"
msgstr "Wormwood. ...The moon's power seems awakened."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BONESHARD"
msgid "骸骨的碎片。"
msgstr "Bone shards."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BONESOUP"
msgid "骸骨汤，沃利的真本事。"
msgstr "Bone soup. ...The genuine Warly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BONESTEW"
msgid "骸骨汤。有营养。"
msgstr "Bone stew. ...Nourishing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOKSTATION.BURNT"
msgid "图书馆闭馆了。"
msgstr "The library has closed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOKSTATION.GENERIC"
msgid "书架。学问优先。"
msgstr "A bookshelf. ...Learning comes first."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_BEES"
msgid "蜂的书。嗡嗡，吵。"
msgstr "A book of bees. ...Buzz, buzz. Loud."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_BIRDS"
msgid "鸟的书。叽叽喳喳。"
msgstr "A book of birds. ...Chirp, chirp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_BRIMSTONE"
msgid "开头无聊。结尾不错。"
msgstr "A dull beginning. ...A fine ending."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_ELEMENTAL"
msgid "字看不懂。"
msgstr "The script is unreadable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_FIRE"
msgid "火的书。缺了那份迫切。"
msgstr "A book of fire. ...No urgency in it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_FISH"
msgid "钓鱼的书。鱼可不看书。"
msgstr "A book of fishing. ...The fish do not bite."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_FOSSIL"
msgid "能把怪物拦住一会儿。"
msgstr "It binds monsters, briefly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_GARDENING"
msgid "园艺书。土才更要紧。"
msgstr "A gardening book. ...The soil matters more."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_HORTICULTURE"
msgid "园艺书。翻过了。"
msgstr "A gardening book. ...Already read."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "看草生长。和从前一样。"
msgstr "Watching grass grow. ...Just the same."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_LIGHT"
msgid "光的书。写它的人很明亮。"
msgstr "A book of light. ...Whoever wrote it must be very bright."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "亮。非常亮。"
msgstr "Bright. ...Very."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_MOON"
msgid "月亮的书。一时的流行。"
msgstr "A book of the moon. ...A passing fad."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_RAIN"
msgid "雨的书。不太科学。"
msgstr "A book of rain. ...No. Not science."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "老太太守规矩。"
msgstr "The old lady keeps the rules."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_SILVICULTURE"
msgid "造林的书。嗯，受教了。"
msgstr "A book of forestry. ...Mm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_SLEEP"
msgid "电报码，五百页。真能催眠。"
msgstr "Telegraph code, five hundred pages. ...Soporific."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_TEMPERATURE"
msgid "温度的书。不冷不热。"
msgstr "A book of temperature. ...Not cold, not hot."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_TENTACLES"
msgid "触手的书。谁读谁上钩。"
msgstr "A book of tentacles. ...Whoever reads it takes the bait."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOK_WEB"
msgid "蛛网的教材。织法业余。"
msgstr "Web weaving, as a textbook. ...Amateur weaving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOMERANG"
msgid "空气力学。"
msgstr "Aerodynamics."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BOOTLEG"
msgid "某个海贼，少了一只战利品。"
msgstr "Some pirate. ...One trophy short."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BROKEN_FORGEDITEM"
msgid "坏了，像是能修。"
msgstr "Broken. ...It seems repairable."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "够热，能焊上。"
msgstr "Hot enough. ...It can be welded."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BRUSH"
msgid "牛喜欢这个。"
msgstr "The beefalo like this."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUGNET"
msgid "捕虫的网。"
msgstr "A bug net."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "嗯，海带。"
msgstr "Mm, kelp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "采完了。"
msgstr "All harvested."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BULLKELP_ROOT"
msgid "深水里能种。"
msgstr "It can be planted in deep water."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNDLE"
msgid "补给都在里面。"
msgstr "Supplies within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNDLEWRAP"
msgid "打包好，便于携带。"
msgstr "Bundled for carrying."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNNYMAN"
msgid "兔人。小心它的胡萝卜。"
msgstr "A bunnyman. ...Careful with the carrots."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUNNYSTEW"
msgid "运气用尽了。"
msgstr "My luck has run out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BURNT_MARSH_BUSH"
msgid "全焦了。"
msgstr "All charcoal."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUSHHAT"
msgid "扎人。"
msgstr "Prickly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTER"
msgid "黄油。居然是真的。"
msgstr "Butter. ...The real thing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLY.GENERIC"
msgid "蝶，在飞。"
msgstr "A butterfly, flying."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLY.HELD"
msgid "抓到了。"
msgstr "Caught it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLYMUFFIN"
msgid "蝶做的松饼。很甜。"
msgstr "A butterfly muffin. ...Sweet."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUTTERFLYWINGS"
msgid "翅膀。很轻。"
msgstr "Wings. ...Light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARD"
msgid "以尸体为食的鸟。在盘旋。"
msgstr "A buzzard. ...Circling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "火里的鸟。"
msgstr "A firebird, complete."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "鸟的尸首。"
msgstr "A bird's corpse."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "新的东西要出来了！"
