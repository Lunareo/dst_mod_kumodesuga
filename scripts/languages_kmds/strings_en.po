msgstr "Now this is the good stuff."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_PICKED"
msgid "能吃。但不想吃。"
msgstr "Edible. But I don't want it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "晒得不错。"
msgstr "Dried nicely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_PLANT"
msgid "芦荟在这儿。"
msgstr "There's the aloe."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUCCULENT_POTTED"
msgid "盆里的多肉。"
msgstr "A succulent in a pot."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUNKENCHEST.GENERIC"
