msgstr "Heating didn't improve them."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BERRIES_JUICY"
