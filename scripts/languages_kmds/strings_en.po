msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_5"
msgid "明天牙会反对。"
msgstr "My teeth will be furious tomorrow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_6"
msgid "这个不吃。"
msgstr "This one, I will not eat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_7"
msgid "葡萄干，话题就到这里。"
msgstr "Raisins... the center of attention."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_8"
msgid "棒棒糖。……好。"
msgstr "A lollipop. ...Good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENCANDY_9"
msgid "粘在牙上了。"
msgstr "It clings to the teeth."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "勇气满了。"
msgstr "Full of courage."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "很强的药。"
msgstr "A strong brew."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "没那么有效。"
msgstr "It fell short of great expectations."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "地狱的结晶。"
msgstr "A crystal of hell."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "里面有能变身的成分。"
msgstr "Transformative ingredients, blended."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "幽灵的装饰。能挂在树上。"
msgstr "A ghostly ornament. ...It could hang on a tree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "蝙蝠的装饰。"
msgstr "A bat ornament."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "木头做的。挂着正好。"
msgstr "Wooden. ...It seems fit to hang."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "像真的触手。"
msgstr "It resembles a real tentacle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "八条腕的装饰。"
msgstr "An eight-armed ornament."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "乌鸦的装饰。正流行。"
msgstr "A raven ornament. ...In fashion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HAMBAT"
msgid "不太卫生。"
msgstr "Unhygienic."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HAMMER"
msgid "该敲的时候就敲。"
msgstr "Hammer time."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HAMMER_MJOLNIR"
msgid "很重的锤。"
msgstr "A heavy hammer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "牛毛做的。气味还在。"
msgstr "Beefalo wool. ...The smell lingers."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_KELP"
msgid "太湿了。"
msgstr "Damp beyond reason."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_PETALS"
msgid "比牛毛的枕头香。"
msgstr "Fragrant, unlike the beefalo wool pillow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "谁会睡这个。"
msgstr "Who sleeps on this?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HAREBALL"
msgid "更难吃的，我也吃过。"
msgstr "I have eaten worse."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HAWAIIANSHIRT"
msgid "太花了。不适合打斗。"
msgstr "Too loud. ...Unfit for battle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSALVE"
msgid "刺痛，就是有效。"
msgstr "Stinging means it works."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSALVE_ACID"
msgid "多半的伤都能缓一缓。"
msgstr "Many problems, eased."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSALVE_FUMAROLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSALVE_FUMAROLE"
msgid "拿来挡暑气。"
msgstr "Against the summer heat."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEALINGSTAFF"
msgid "能把回复的力量引过去。"
msgstr "It channels restoring energy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.COLD"
msgid "冷的石头。"
msgstr "A cold stone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.FROZEN"
msgid "比冰还冷。"
msgstr "Colder than ice."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.GENERIC"
msgid "温度能调。"
msgstr "The temperature can be tuned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.HOT"
msgid "很烫，正好。"
msgstr "Hot. Good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEATROCK.WARM"
msgid "暖。石头也会暖。"
msgstr "Warm. ...Even a stone."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEDGEHOUND"
msgid "有埋伏！"
msgstr "An ambush!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HEDGEHOUND_BUSH"
msgid "灌木。"
msgstr "A bush."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB"
msgid "一个人住……会寂寞吧。"
msgstr "Solitary. ...Lonely, surely."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_FIRENETTLES"
msgid "「热饮」，得先提醒一句。"
msgstr "A \"hot drink\". ...A warning is needed."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_FOLIAGE"
msgid "放心，不会过量。"
msgstr "Reassuring. ...Not excessively."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
msgid "疯意，化开了。"
msgstr "Madness. ...Dissolving."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "月的味道，像蜡。"
msgstr "Moon flavor. ...A waxy feel."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "唔，让人安心的茶。"
msgstr "Mm. ...A calming tea."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
msgid "喝了会发狂的茶！"
msgstr "A maddening tea!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "留着当点心。"
msgstr "Save it for dessert."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRABTEA_TILLWEED"
msgid "为了身子，干杯！"
msgstr "To health. ...Cheers!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
msgid "凄凉，看不下去。"
msgstr "Forlorn. ...I can hardly bear to look."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC"
msgid "灯，亮堂了些。"
msgstr "A lamp. ...The mood brightens."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM"
msgid "一串灯，添些气氛。"
msgstr "Strings of lamps. ...They set the mood."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "给她换个新住处。妥当。"
msgstr "The crab's new home. ...Perfect."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_SHELL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_SHELL"
msgid "去珍珠家里？"
msgstr "A home, without its pearl?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE"
msgid "喝茶的时候！"
msgstr "Tea time!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.BREWING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.BREWING"
msgid "价钱不便宜。"
msgstr "I paid a high price."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.BURNT"
msgid "店烧光了。"
msgstr "The shop, burnt away."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC"
msgid "店空着。没有茶。"
msgstr "The shop is empty. ...No tea."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING.BOMBED"
msgid "松快的法子成了。"
msgstr "The relaxation formula, complete."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING.EMPTY"
msgid "水去哪了？"
msgstr "Where is the water?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING.GENERIC"
msgid "累了，想泡一泡。"
msgstr "Weary. ...I would like a soak."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "在盖。"
msgstr "Under construction."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "还差一点心意。"
msgstr "It needs a little love."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "空壳做的家。"
msgstr "An empty-shell home."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "说还是不说，难办。"
msgstr "To say, or not to say. ...A delicate matter."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "风铃的声音。好听。"
msgstr "The chime of a wind bell. ...Lovely."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_BUNDLE"
msgid "她给了不少。"
msgstr "She sends so much."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "她真的在卖贝壳。"
msgstr "She truly sells shells."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "没有收好。"
msgstr "I failed to keep it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HERMIT_PEARL"
msgid "要好好收着。"
msgstr "I will keep it preciously."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HIVEHAT"
msgid "戴上世界安静一些。"
msgstr "With it on, the world quiets a little."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOME"
msgid "有人住着。"
msgstr "Someone lives here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOMESIGN.BURNT"
msgid "「别玩火」。"
msgstr "\"Do not play with matches.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOMESIGN.GENERIC"
msgid "写着「你在这里」。"
msgstr "It reads, \"You are here.\""

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "空白的牌子。"
msgstr "A blank sign."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEY"
msgid "看着好吃！"
msgstr "It looks delicious!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEYCOMB"
msgid "蜂住过的地方。"
msgstr "Bees once lived here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEYHAM"
msgid "甜里带咸。"
msgstr "Sweet and salty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HONEYNUGGETS"
msgid "像鸡肉。其实不是。"
msgstr "Like chicken. ...No. It is not."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HORN"
msgid "牛场的声音都在里面。"
msgstr "The pasture's lowing lives within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HORRORFUEL"
msgid "背上发凉。"
msgstr "A chill runs down the spine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HORSESHOE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HORSESHOE"
msgid "马蹄铁，该留着。"
msgstr "A horseshoe. ...It should be kept."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTCHILI"
msgid "很辣！小心。"
msgstr "A spice alarm!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.BOMBED"
msgid "简单的化学反应。"
msgstr "A simple chemical reaction."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.EMPTY"
msgid "等它再满。"
msgstr "Waiting for it to refill."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.GENERIC"
msgid "累了。想在热水里泡一泡。"
msgstr "Tired. ...I would like a soak."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOTSPRING.GLASS"
msgid "月光下，水变成了玻璃。有意思。"
msgstr "Under the moon, water turned to glass. ...Science."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUND"
msgid "狗。小意思。"
msgstr "A hound. ...A small matter."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDBONE"
msgid "让人后背发凉。"
msgstr "It chills the spine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "现在安全了。"
msgstr "Safe, for now."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "味道不太好。"
msgstr "It does not smell good."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "糟了！"
msgstr "Not good!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDMOUND"
msgid "连骸骨都没剩下。"
msgstr "No bones left to pick."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDSTOOTH"
msgid "尖锐。"
msgstr "Sharp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "牙做的？不太干净。"
msgstr "Teeth? ...Hygiene, doubtful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HOUNDWHISTLE"
msgid "能止住狗的笛子。"
msgstr "A hound-stilling whistle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HUMANMEAT"
msgid "肉就是肉。界线在哪。"
msgstr "Meat is meat. ...Where lies the line?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HUMANMEAT_COOKED"
msgid "烤过之后也一样。……说不清对错。"
msgstr "Roasted pink. ...A moral grey."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HUMANMEAT_DRIED"
msgid "干了。……问题就消失了吗。"
msgstr "Dried. ...Does the problem vanish?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HUTCH"
msgid "哈奇。装鱼的箱子。"
msgstr "Hutch. ...A fishy chest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "一直想要一个。"
msgstr "I always wanted one."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "想要什么？……饿了吗。"
msgstr "What is it? ...Hungry?"

