msgstr "The stench, at its worst."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMCORPSE.GENERIC"
msgid "鱼人死了。"
msgstr "A merm, dead."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MERMCORPSE.REVIVING"
