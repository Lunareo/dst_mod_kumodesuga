#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.N"
msgid "北边～"
msgstr "North."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.NE"
msgid "东北边～"
msgstr "Northeast."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.NW"
msgid "西北边～"
msgstr "Northwest."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.S"
msgid "南边～"
msgstr "South."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.SE"
msgid "东南边～"
msgstr "Southeast."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.SW"
msgid "西南边～"
msgstr "Southwest."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPASS.W"
msgid "西边～"
msgstr "West."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOST"
msgid "植物的饵～再往上就没了～"
msgstr "Plant bait, nothing more."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "正好！这样就对啦～"
msgstr "Just right!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "居然还能更臭～真意外呢～"
msgstr "It can get stinkier, surprisingly."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "唔，太干了呢～"
msgstr "Mm, too dry."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "臭到极限啦～"
msgstr "The stench, at its limit."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTINGBIN.WET"
msgid "太湿了呢～"
msgstr "Too wet."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.COMPOSTWRAP"
