msgstr "It's pitiful and empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
