#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "空瓶子。里面什么都没有。"
msgstr "An empty bottle. ...Nothingness within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "再也不会疼了。"
msgstr "No more aching muscles, ever."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "光看着，肌肉就疼。"
msgstr "Just watching. ...My muscles ache."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MILKYWHITES"
msgid "唔。受不住。"
msgstr "Revolting."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINERHAT"
msgid "有了灯，手也空出来。"
msgstr "A lamp that frees the hands."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINIBOATLANTERN"
msgid "灯浮在水上。"
msgstr "A floating lamp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINIFAN"
msgid "风从后面出来。"
msgstr "The wind comes out the back."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINIFLARE"
msgid "点上火，让大家知道我在。"
msgstr "Lit. ...Everyone will know I am here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINISIGN.GENERIC"
msgid "画得再好些也行。"
msgstr "It could be drawn better."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINISIGN.UNDRAWN"
msgid "该画点什么。"
msgstr "Draw something. ...It is wanted."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINISIGN_ITEM"
msgid "先立起来。"
msgstr "Set it upright first."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINOTAUR"
msgid "一脸不高兴。"
msgstr "An unhappy face."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINOTAURCHEST"
msgid "里面是惊喜？还是恐怖。"
msgstr "A surprise within? ...Or a horror."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MINOTAURHORN"
msgid "没被顶飞。运气好。"
msgstr "Not gored. ...Lucky."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MITEGLAND.COLD"
msgid "凉下来了。"
msgstr "It has grown cold."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MITEGLAND.GENERIC"
msgid "小虫，不只会喷气。"
msgstr "The mite. ...It does more than vent."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MITEGLAND_COOKED"
msgid "煮过了，真要吃？"
msgstr "It is boiled. ...Must I truly eat it?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLE.ABOVEGROUND"
msgid "鼹鼠。想敲一下。只是想。"
msgstr "A mole. ...I want to whack it. ...I want to."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLE.HELD"
msgid "没地方挖了。……抱歉。"
msgstr "Nowhere left to dig. ...Sorry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLE.UNDERGROUND"
msgid "地下有东西。它在找矿物。"
msgstr "Something underground. It digs for minerals."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEBAT"
msgid "会打洞的蝙蝠，也算吸血一族。"
msgstr "A mole, a bat. ...A vampire."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEBATHILL"
msgid "巢里，藏着什么。"
msgstr "In the nest. ...What hides?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEHAT"
msgid "臭。不过视野很好。"
msgstr "Foul. ...But the view is fine."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOLEHILL"
msgid "洞。有家的感觉。"
msgstr "A hole. ...It feels like a home."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEY"
msgid "好奇的家伙。"
msgstr "A curious fellow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYBARREL"
msgid "动了一下？"
msgstr "Did it move?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYHUT.BURNT"
msgid "果然。"
msgstr "Called it!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYHUT.GENERIC"
msgid "树上的家，怕火。"
msgstr "A tree house. ...A fire hazard."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "进不去，只会往外送东西。"
msgstr "Cannot enter. ...Things only come out."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "机件，像见过。"
msgstr "Machinery. ...A sense of deja vu."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYPILLAR"
msgid "柱子，撑着这座岛。"
msgstr "A pillar. ...This island's very support."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYQUEEN"
msgid "猴王，这里的头目。"
msgstr "The monkey queen. ...The boss of this island."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEYTAIL"
msgid "能吃？得试试。"
msgstr "Edible? ...Experimentation required."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "像个船长。有派头。"
msgstr "It resembles a captain. ...Dashing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONKEY_SMALLHAT"
msgid "至少头发不湿。"
msgstr "At least my hair stays dry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERLASAGNA"
msgid "这算是对料理的不敬。"
msgstr "A desecration of cooking."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERMEAT"
msgid "唔。这个不吃。"
msgstr "Mm. ...I will not eat this."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERMEAT_DRIED"
msgid "味道很怪的肉干。"
msgstr "Strange-tasting jerky."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MONSTERTARTARE"
msgid "应该还有别的吃的。"
msgstr "There should be other food."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.BROKEN"
msgid "碎了。"
msgstr "Broken."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.GENERIC"
msgid "中间有个洞。放什么进去。"
msgstr "A hole in the middle. ...What goes there."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "石头亮了。"
msgstr "The stone has lit."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.STAFFED"
msgid "然后呢。"
msgstr "And now?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "感觉不对。"
msgstr "It feels wrong."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "月光里的虫子。很美。"
msgstr "A moon butterfly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "抓住了。"
msgstr "Caught it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "一对翅。"
msgstr "Wings."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "虫变成了树。不合常理。"
msgstr "A moth turned tree. ...Abnormal."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.CAVE"
msgid "这里看不见月亮。"
msgstr "No moon here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.GENERIC"
msgid "水面上的月之刻度。"
msgstr "A gauge of the moon, in water."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.GLASSED"
msgid "被注视着的感觉。"
msgstr "A feeling of being watched."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "满月。"
msgstr "Full moon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "新月。"
msgstr "New moon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "月在亏缺。"
msgstr "The moon wanes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "月在变满。"
msgstr "The moon waxes."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.WEREBEAVER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONDIAL.WEREBEAVER"
msgid "only_used_by_woodie"
msgstr "only_used_by_woodie"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS"
msgid "很尖。"
msgstr "Very sharp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASSAXE"
msgid "特别加固过。"
msgstr "Specially reinforced."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS_CHARGED"
msgid "能量散掉之前，得好好用。"
msgstr "Before the energy fades... use it for study."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS_ROCK"
msgid "能照出脸。"
msgstr "It reflects one's face."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "月亮玻璃里的龙虾。"
msgstr "A lobster in moon glass."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKCRATER"
msgid "有亮的东西埋着。值得看看。"
msgstr "Something gleaming is buried. ...For study."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKIDOL"
msgid "偶像。我不拜这个。"
msgstr "An idol. ...I do not worship it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKNUGGET"
msgid "从月亮来的石头。"
msgstr "A stone from the moon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCKSEED"
msgid "里面有学问！"
msgstr "Science within!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONROCK_PIECES"
msgid "能敲碎。"
msgstr "It can be broken apart."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSPIDERDEN"
msgid "不是普通的巢。"
msgstr "Not an ordinary den."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "是玻璃。"
msgstr "Glassy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "不是自然的力，在发光。"
msgstr "Unnatural energy. ...Glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "月亮的力加上土豆的力。没想到。"
msgstr "Moon energy, plus potato energy. ...Unexpected."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_SPARK"
msgid "就叫它「小火星」吧。……嗯。"
msgstr "\"Higgs particle\". ...So named. ...Mm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC"
msgid "新的发现，会电人。"
msgstr "A new discovery. ...Electric."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "里面没东西。"
msgstr "Nothing within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "头发乱了。"
msgstr "My hair turns wild."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "像是迷了路。"
msgstr "It looks lost."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "唔？这是什么。"
msgstr "Mm? ...What?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "它想被做完。"
msgstr "It wants to be finished."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "更大机关的一部分。"
msgstr "Part of a larger mechanism."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "在等什么。"
msgstr "It is waiting for something."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_CROWN"
msgid "钓上来的。得找那道裂缝。"
msgstr "Caught it. ...The rift must be found."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_GLASS"
msgid "它不喜欢待在地上。"
msgstr "The ground does not like it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ICON"
msgid "你知道该回哪里去。"
msgstr "You know where you belong."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_IDOL"
msgid "有种想把它带去某处的冲动。"
msgstr "An urge to carry it somewhere."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_LINK"
msgid "在准备什么。"
msgstr "It is preparing something."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "里面困着东西。"
msgstr "Something is trapped within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "里面困着东西。"
msgstr "Something is trapped within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "里面困着东西。"
msgstr "Something is trapped within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_SEED"
msgid "它想有个家。"
msgstr "It wants a home."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_ALTAR_WARD"
msgid "它想和同伴在一起。"
msgstr "It wants to be with its companions."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_CAP"
msgid "没什么胃口。"
msgstr "My appetite does not stir."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_CAP_COOKED"
msgid "为了长见识，代价不小。"
msgstr "For science. ...Much is paid."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "才刚开个头。"
msgstr "Science, only beginning."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "越来越像样了。"
msgstr "The sense of science, growing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "力被封在里面。用处我自然清楚。"
msgstr "Energy, being sealed in. ...Of course I know its use."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "脑子里，平静和恐惧一起跳。"
msgstr "My brain... calm and terror, taking turns."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "这里的裂纹显出来了。"
msgstr "Here, the fissure manifests."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "算不上学问。但有效。"
msgstr "It is not science. ...But it works."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.BURNING"
msgid "树在烧！"
msgstr "The tree is burning!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.BURNT"
msgid "树烧完了。"
msgstr "The tree has burned."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.CHOPPED"
msgid "很厚的树。"
msgstr "A thick tree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE.GENERIC"
msgid "长在月亮上的树。头一回听说。"
msgstr "A tree grown on the moon. ...First I have heard of it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "月树落下的花。"
msgstr "Blossom fallen from a moon tree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "晒得正好。"
msgstr "Dried, and well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOOSE"
msgid "这是什么。看不明白。"
msgstr "What is this. ...Unclear."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOOSEEGG"
msgid "里面的孩子在跳。"
msgstr "The children bounce with excitement."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "把孩子放在这里。"
msgstr "The children are kept here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOQUECA"
msgid "他厨艺很高。我不是厨子。"
msgstr "His cooking is superb. ...I am no chef."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITO.GENERIC"
msgid "吸血的虫。讨厌。"
msgstr "A bloodsucker. ...Loathsome."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITO.HELD"
msgid "这是我的血吗。"
msgstr "Is this my blood?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOBOMB"
msgid "手有点痒，想扔出去。"
msgstr "My hand itches. ...I want to throw it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOFERTILIZER"
msgid "植物喜欢，据说。"
msgstr "Plants like it. ...So they say."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOMERMSALVE"
msgid "鱼人里正流行。"
msgstr "Fashionable in merm circles."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOMUSK"
msgid "蚊子咬不到。"
msgstr "The mosquitoes cannot bite."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSQUITOSACK"
msgid "谁的血……"
msgstr "Whose blood is this..."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOSSLING"
msgid "啊！……说不清是什么。"
msgstr "Ah! ...It is not electronic!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOUND.DUG"
msgid "大概该挖这里。"
msgstr "It was due, probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MOUND.GENERIC"
msgid "下面有好东西！"
msgstr "Good things below!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MULLEDDRINK"
msgid "酒劲不小。我在旁边看。"
msgstr "The drink has a kick. ...I will watch from afar."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "门。……会有人从这里来吗。"
msgstr "A gate. ...Will someone come through it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "月岩的门。有点暖。"
msgstr "A moon rock gate. ...Somewhat warm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "两用。聪明的设计。"
msgstr "Two tools in one. ...A clever design."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHGNOME"
msgid "蘑菇小人，偶尔会动手。"
msgstr "A mushroom gnome. ...It attacks, occasionally."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMBOMB"
msgid "蘑菇炸弹。和我很合得来。"
msgstr "A mushroom bomb. ...It travels with me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMHAT"
msgid "蘑菇帽子。可爱。"
msgstr "A mushroom hat. ...Cute."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "苗焦了。"
msgstr "A burnt sprout."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "蘑菇的幼苗。"
msgstr "A sprout. ...Of mushroom."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "焦了。"
msgstr "Burnt."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "要放孢子。"
msgstr "It wants spores."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "长势很好。"
msgstr "Growing well."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "木头死了。换掉。"
msgstr "The log has died. ...Replace it."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "太冷，长不了。"
msgstr "Too cold to grow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "还会再长。"
msgstr "More will grow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "蘑菇很多。"
msgstr "Mushrooms aplenty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "全焦了。"
msgstr "All charcoal."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "很大的蘑菇。"
msgstr "A big mushroom."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "在发光。"
msgstr "Glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "烧焦了。"
msgstr "Burnt to a crisp."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "三色混在一起就会亮。"
msgstr "Mix all three colors, and it lights."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "蓝色的光。"
msgstr "Blue. ...Glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "裹着酸。"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "在发光。繁殖期。"
msgstr "Glowing. ...In bloom."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "中等的蘑菇树。"
msgstr "Medium. ...A mushtree."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_MOON"
msgid "月亮的蘑菇树，比别的更怪。"
msgstr "A moon mushtree. ...Stranger than the rest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "裹着酸。"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "正在繁殖。"
msgstr "In bloom."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "小的。带魔力的蘑菇？"
msgstr "Small. ...A magic mushroom?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "裹着酸。"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "远看看不出来。很臭。"
msgstr "From afar, one cannot tell. ...The stench."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "长得过头了。"
msgstr "Overly tall."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "裹着酸。"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "蜘蛛看重这棵树。丝很多。"
msgstr "The spiders prize it. ...Much silk."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBEARGER"
msgid "要麻烦了。"
msgstr "This is becoming a problem."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBIRD"
msgid "少见的鸟……大概。"
msgstr "A rare bird. ...Probably."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "在吃腐肉。请别看。"
msgstr "Feeding on carrion. ...Kindly look away."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "像尸首一样，守着不走。"
msgstr "Corpse-like. ...Faithful."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDDEERCLOPS"
msgid "那眼里，藏着东西。"
msgstr "Within the eye. ...Something resides."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "呼吸停了。"
msgstr "Its breath is at rest."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "变了样的犬。危险。"
msgstr "A mutated hound. ...Danger."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "很想走开。"
msgstr "The urge to flee is strong."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATEDWARG"
msgid "眼睛又大又亮。"
msgstr "Eyes. ...Large, and glowing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "结束了。"
msgstr "It is over."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "变得太过了。要当心。"
msgstr "Mutated too far. ...Stay alert."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "运气好。它在睡。"
msgstr "Fortunate. ...It sleeps."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_DROPPER"
msgid "刚吃过。……给蜘蛛朋友吧……？"
msgstr "Just ate. ...Give it to the spider friends...?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_HEALER"
msgid "刚吃过。……给蜘蛛朋友吧……？"
msgstr "Just ate. ...Give it to the spider friends...?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_HIDER"
msgid "唔，看着好吃，韦伯。"
msgstr "Mm... it looks tasty. ...Webber."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_MOON"
msgid "唔，看着好吃，韦伯。"
msgstr "Mm... it looks tasty. ...Webber."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_SPITTER"
msgid "刚吃过。……给蜘蛛朋友吧……？"
msgstr "Just ate. ...Give it to the spider friends...?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_WARRIOR"
msgid "唔，看着好吃，韦伯。"
msgstr "Mm... it looks tasty. ...Webber."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MUTATOR_WATER"
msgid "唔，看着好吃，韦伯。"
msgstr "Mm. ...It looks tasty. ...Webber."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NATURE_BLUEPRINT"
msgid "花，不会错。"
msgstr "Flowers. ...It cannot go wrong."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTCAPHAT"
msgid "睡觉戴的帽子。头发不会乱。"
msgstr "A nightcap. ...It prevents unruly hair."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTLIGHT"
msgid "奇怪的光。"
msgstr "An eerie light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMAREFUEL"
msgid "危险的东西。会让人发狂。"
msgstr "A dangerous thing. ...It maddens."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMAREGROWTH"
msgid "结晶，让人不安的材料。"
msgstr "A crystal. ...Worrisome material."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARELIGHT"
msgid "作用不明。"
msgstr "Purpose unclear."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMAREPIE"
msgid "有点古怪。"
msgstr "Somewhat strange."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "平静。"
msgstr "Calm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "噩梦快散了。"
msgstr "The nightmare will soon fade."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "这里没有魔力。"
msgstr "No magic here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "稳定。"
msgstr "Steady."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "在退去。"
msgstr "It is receding."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "魔力变浓了。"
msgstr "The magic thickens."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "越来越浓。"
msgstr "Thickening still."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTSTICK"
msgid "电。"
msgstr "Electricity."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NIGHTSWORD"
msgid "谁做出这种刀。可怕。"
msgstr "Who made this. ...Chilling."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NITRE"
msgid "地质我不懂。"
msgstr "Geology escapes me."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NITRE_FORMATION"
msgid "确实是某种石头。"
msgstr "A certain kind of rock, certainly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NONSLIPGRIT"
msgid "防滑，抓得住地。"
msgstr "Anti-slip. ...It grips the ground."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "脚下越发稳了。"
msgstr "Grip, increasing."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "土里的门道，看得见了。"
msgstr "Science in the soil. ...Now visible."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.OAR"
msgid "靠手划。"
msgstr "Manual propulsion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.OAR_DRIFTWOOD"
msgid "靠手划。"
msgstr "Manual propulsion."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.OAR_MONKEY"
msgid "桨也能当兵器。"
msgstr "An oar, doubled as a weapon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.OASISLAKE.EMPTY"
msgid "干透了。"
msgstr "Bone dry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.OASISLAKE.GENERIC"
msgid "是幻觉吗。"
msgstr "A mirage?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "泥和草。"
msgstr "Mud and weeds."

