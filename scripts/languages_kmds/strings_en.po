#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
