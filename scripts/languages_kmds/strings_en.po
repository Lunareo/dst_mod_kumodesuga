msgstr "The rain makes it longer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
