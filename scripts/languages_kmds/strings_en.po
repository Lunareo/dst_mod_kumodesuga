msgstr "So big! One eye."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "再小心也不嫌多呢～"
msgstr "One can't be too careful."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
