#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULTITOOL_AXE_PICKAXE"
