msgstr "Seeing is believing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_SMALL_7"
