msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "看着是故意做得难懂呢～"
msgstr "It seems deliberately confusing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
