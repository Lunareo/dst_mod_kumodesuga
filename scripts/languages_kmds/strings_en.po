msgstr "A few more flowers will do it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SKELETON"
msgid "你死，比我死好。"
msgstr "Better you die than me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SKELETONHAT"
