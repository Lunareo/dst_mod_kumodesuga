msgid "它们下去的时候还在动。"
msgstr "They were still moving when they went in."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_5"
msgid "明天我的牙会有意见。"
msgstr "My teeth will file complaints tomorrow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_6"
msgid "这些……我不会吃。"
msgstr "These... I won't eat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_7"
msgid "大家都会为这些东西吵起来。"
msgstr "Everyone will fight over these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_8"
msgid "不喜欢这个的人才傻。"
msgstr "Only a fool dislikes this one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENCANDY_9"
msgid "会黏在牙上。"
msgstr "It sticks to the teeth."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "满是胆量。"
msgstr "Brimming with courage."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "一瓶很强的药水。"
msgstr "A very strong potion."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "我期待的是更大的东西。"
msgstr "I was expecting something bigger."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "结晶化的地狱。"
msgstr "Crystallized hell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "里面掺了会让人变形的东西。"
msgstr "Something transformative has been mixed in."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "可以挂在树上的幽灵饰品。"
msgstr "A ghost ornament for hanging on trees."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "完全是蝙蝠的装饰。"
msgstr "An entirely batty decoration."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "挂在哪里都不错。"
msgstr "Would look fine hung anywhere."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "和真的触手很像。"
msgstr "Very like a real tentacle."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "八只手的装饰。"
msgstr "An eight-handed decoration."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "今年大家都在谈乌鸦形状的挂饰。"
msgstr "Crow-shaped ornaments are all the talk this year."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAMBAT"
msgid "这个不太卫生。"
msgstr "This isn't very sanitary."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAMMER"
msgid "停。是敲东西的时候了。"
msgstr "Stop. It's time for smashing things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAMMER_MJOLNIR"
msgid "一把很重的锤子，用来砸东西。"
msgstr "A very heavy hammer, for smashing things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "要是它没有牛的味道就好了。"
msgstr "If only it didn't smell of beefalo."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_KELP"
msgid "比我想要的更湿。"
msgstr "Wetter than I wanted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_PETALS"
msgid "至少比那个牛毛枕头好闻。"
msgstr "At least it smells better than that beefalo one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "谁会睡在这上面。"
msgstr "Who would sleep on this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAREBALL"
msgid "到了这个地步……我吃过更糟的东西。"
msgstr "At this point... I've eaten worse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HAWAIIANSHIRT"
msgid "这不适合在实验室里穿。"
msgstr "This isn't fit for laboratory wear."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSALVE"
msgid "刺痛说明它在起作用。"
msgstr "The sting means it's working."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSALVE_ACID"
msgid "这个能解决不少问题。"
msgstr "This solves quite a few problems."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSALVE_FUMAROLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSALVE_FUMAROLE"
msgid "它能压住热。"
msgstr "It can hold the heat down."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEALINGSTAFF"
msgid "它能导出让人复原的能量。"
msgstr "It channels restorative energy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.COLD"
msgid "一块冷的石头。"
msgstr "A cold stone."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.FROZEN"
msgid "比冰还冷。"
msgstr "Colder than ice."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.GENERIC"
msgid "它的温度可以调。"
msgstr "Its temperature can be adjusted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.HOT"
msgid "暖得刚好。"
msgstr "Comfortably warm."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEATROCK.WARM"
msgid "作为石头，算是又暖又亲切。"
msgstr "For a stone, quite warm and friendly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEDGEHOUND"
msgid "是埋伏。"
msgstr "It's an ambush."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HEDGEHOUND_BUSH"
msgid "是一丛灌木。"
msgstr "It's a bush."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB"
msgid "一个人住。是因为有趣吗。"
msgstr "Living alone. For fun?"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_FIRENETTLES"
msgid "它该附一张警告标签。"
msgstr "It should come with a warning label."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_FOLIAGE"
msgid "别担心，我不会喝疯。"
msgstr "Don't worry, I won't drink myself mad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
msgid "它确实把我的疯融掉了。"
msgstr "It really did melt my madness away."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "我不是要抱怨，但它有点蜡味。"
msgstr "Not to complain, but it's a bit waxy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "很安宁的味道。"
msgstr "A very peaceful flavor."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
msgid "让人发疯的茶。"
msgstr "A maddening tea."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "该留到最后再喝。"
msgstr "Should be saved for last."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRABTEA_TILLWEED"
msgid "来提一提健康。"
msgstr "Here's to health."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
msgid "太惨了。处理掉吧。"
msgstr "Too wretched. Dispose of it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_LIGHTPOST.GENERIC"
msgid "它们确实让气氛变轻。"
msgstr "They do lighten the mood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_LIGHTPOST_ITEM"
msgid "来把一点气氛串起来。"
msgstr "Time to string a little atmosphere together."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_RELOCATION_KIT"
msgid "那只蟹的新家会很合适。"
msgstr "The crab's new home will suit her well."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_SHELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_SHELL"
msgid "要去珍珠那里吗。"
msgstr "Off to see Pearl."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.ACTIVE"
msgid "喝茶的时候到了。"
msgstr "It's tea time."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.BREWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.BREWING"
msgid "我付了很高的价。"
msgstr "I paid a steep price."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.BURNT"
msgid "她的店烤糊了。"
msgstr "Her shop got toasted."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITCRAB_TEASHOP.GENERIC"
msgid "店里是空的。"
msgstr "The shop is empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING.BOMBED"
msgid "放松的完美配方。"
msgstr "The perfect recipe for relaxation."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING.EMPTY"
msgid "水在哪。"
msgstr "Where is the water."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING.GENERIC"
msgid "要是能泡一泡这身疲惫的骨头就好了。"
msgstr "If only these tired bones could soak a while."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "它还在搭建中。"
msgstr "It's still under construction."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "它只是需要一点关照。"
msgstr "It only needed a little care."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "只是一间空壳的房子。"
msgstr "Just an empty shell of a house."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "我该说点什么，还是不该提。"
msgstr "Should I say something, or not mention it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "很好听。"
msgstr "Very pleasant to the ear."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_BUNDLE"
msgid "她确实发了很多这个。"
msgstr "She really does hand out a lot of these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "她真的在卖海贝。"
msgstr "She really is selling seashells."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "我……没有照顾好它。"
msgstr "I... didn't take good care of it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HERMIT_PEARL"
msgid "我会好好照顾它。"
msgstr "I'll take good care of it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HIVEHAT"
msgid "戴着它，世界会显得没那么疯。"
msgstr "Wearing it makes the world look less insane."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOME"
msgid "这里应该有人住。"
msgstr "Someone should live here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOMESIGN.BURNT"
msgid "\"不要玩火。\""
msgstr "\"Don't play with fire.\""

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOMESIGN.GENERIC"
msgid "上面写着\"你在这里\"。"
msgstr "It says \"you are here\"."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "牌子上现在是空的。"
msgstr "The sign is empty right now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEY"
msgid "看起来好吃。"
msgstr "Looks tasty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEYCOMB"
msgid "蜂以前住在这里面。"
msgstr "Bees used to live in here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEYHAM"
msgid "又甜又咸。"
msgstr "Sweet and salty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HONEYNUGGETS"
msgid "味道像鸡肉。但应该不是。"
msgstr "Tastes like chicken. But probably isn't."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HORN"
msgid "里面像有一整片牛群。"
msgstr "Sounds like a whole herd inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HORRORFUEL"
msgid "它让我的背脊发凉。"
msgstr "It sends a chill up my spine."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HORSESHOE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HORSESHOE"
msgid "留着这个对我有好处。"
msgstr "Holding onto this is good for me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTCHILI"
msgid "五级警报。"
msgstr "Alert level five."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.BOMBED"
msgid "只是简单的化学反应。"
msgstr "Just simple chemistry."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.EMPTY"
msgid "只能等它重新满起来。"
msgstr "Can only wait for it to fill again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.GENERIC"
msgid "要是能泡一泡这身疲惫的骨头就好了。"
msgstr "If only these tired bones could soak a while."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOTSPRING.GLASS"
msgid "月光下水会变成玻璃。这就是规则。"
msgstr "Water turns to glass under moonlight. That's the rule."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUND"
msgid "你算不上什么，猎犬。"
msgstr "You're nothing, hound."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDBONE"
msgid "瘆人。"
msgstr "Eerie."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "现在应该安全了。"
msgstr "Should be safe now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "这味道不算好闻。"
msgstr "The smell isn't pleasant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "不妙。"
msgstr "Not good."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDMOUND"
msgid "我和主人之间没有旧账。真的。"
msgstr "I have no old scores with the master. Really."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDSTOOTH"
msgid "很尖。"
msgstr "Very sharp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "牙做的吗。这不太卫生。"
msgstr "Made of teeth. That's unsanitary."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HOUNDWHISTLE"
msgid "这能让狗停在原地。"
msgstr "This can make dogs stop in place."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUMANMEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUMANMEAT"
msgid "肉就是肉。人类的界线，管不到我。"
msgstr "Meat is meat. Human boundaries don't apply to me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUMANMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUMANMEAT_COOKED"
msgid "熟得漂亮。道德不影响口感。"
msgstr "Beautifully cooked. Morality doesn't affect the taste."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUMANMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUMANMEAT_DRIED"
msgid "晒干了，就只是肉干。"
msgstr "Dried, it's just jerky."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUTCH"
msgid "哈奇·摇尾鱼，私家侦探。"
msgstr "Hutch Fishtail, private eye."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "我一直想要一个。"
msgstr "I always wanted one of these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "它需要一点研究吗。"
msgstr "Does it need a bit of study."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICE"
msgid "冰。见到你很好。"
msgstr "Ice. Nice to meet you."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBERG.GENERIC"
msgid "那个我们绕开走。"
msgstr "We go around that one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBERG.MELTED"
msgid "它完全融了。"
msgstr "It melted completely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBERG_MELTED"
msgid "它完全融了。"
msgstr "It melted completely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEBOX"
msgid "冷被我收进箱子里了。"
msgstr "I've boxed the cold up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICECREAM"
msgid "冰淇淋。"
msgstr "Ice cream."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEHAT"
msgid "保持冷静。"
msgstr "Stay cool."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEHOUND"
msgid "每个季节都有对应的猎犬吗。"
msgstr "Is there a hound for every season."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICEPACK"
msgid "这层毛能稳住里面的温度。"
msgstr "This fur keeps the temperature inside stable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICESTAFF"
msgid "摸着很冷。"
msgstr "Cold to the touch."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICESTAFF2"
msgid "它附带一次冰冻的升级。"
msgstr "It comes with an ice upgrade."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICESTAFF3"
msgid "更强，更冷。"
msgstr "Stronger, colder."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ICE_BLUEPRINT"
msgid "我一般喜欢新鲜的牛，不是冻的。"
msgstr "I generally prefer my beefalo fresh, not frozen."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "接着，清醒的自己。"
msgstr "Carry on, sanity."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "与其说方尖碑，更像金字塔。"
msgstr "Less an obelisk than a pyramid."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESBOX"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESBOX2"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "薇诺娜一向像是个看得见将来的人。"
msgstr "Winona always seemed like someone who could see the future."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.INSPECTSELF"
msgid "我还是完整的吧。"
msgstr "I'm still in one piece, right."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.IPECACSYRUP"
msgid "这个我不想吃。"
msgstr "I don't want to eat this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.IVY_SNARE"
msgid "这就很没礼貌了。"
msgstr "That's just rude."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.JAMMYPRESERVES"
msgid "当时该做个罐子。"
msgstr "Should've made jars back then."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.JELLYBEAN"
msgid "一半是果冻，一半是豆。"
msgstr "Half jelly, half bean."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUNK_PILE"
msgid "翻一堆好废料吗。我从不拒绝。"
msgstr "Dig through a pile of fine scrap? I never refuse."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT"
msgid "上面有东西。"
msgstr "There's something on it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUNK_PILE_BIG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUNK_PILE_BIG.GENERIC"
msgid "我觉得它随时会倒。"
msgstr "I think it could topple at any moment."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.JUSTEGGS"
msgid "它需要一点培根。"
msgstr "It needs a little bacon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KABOBS"
msgid "串在棍子上的午饭。"
msgstr "Lunch on a stick."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELP"
msgid "它把我的口袋弄得又湿又脏。"
msgstr "It made my pocket wet and grimy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELPHAT"
msgid "有时候要先难受才会舒服。"
msgstr "Sometimes you must suffer before feeling good."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELP_COOKED"
msgid "它更接近液体，不是固体。"
msgstr "It's closer to liquid than solid."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KELP_DRIED"
msgid "钠含量偏高。"
msgstr "The sodium content runs high."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KILLERBEE.GENERIC"
msgid "是杀人蜂。"
msgstr "A killer bee."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KILLERBEE.HELD"
msgid "这东西很危险。"
msgstr "This thing is dangerous."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "烧起来了。"
msgstr "It caught fire."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "那不是真鸟，但小猫们不知道。"
msgstr "Not a real bird, but the kitties don't know that."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR1_KIT"
msgid "看起来要装一下。"
msgstr "Looks like some assembly is required."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "它化成火了。"
msgstr "It dissolved into fire."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "那些小猫太容易分心。我刚才在做什么。"
msgstr "Those kittens are far too easily distracted. What was I doing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDECOR2_KIT"
msgid "看着不难搭。"
msgstr "Doesn't look hard to put up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.BURNT"
msgid "不要。"
msgstr "No."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.GENERIC"
msgid "要塞进那里面得相当小。"
msgstr "One would have to be quite small to fit in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "它们会在哪呢。"
msgstr "Where could they be."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "时间不多了。它们在哪。"
msgstr "Running out of time. Where are they."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOONDEN_KIT"
msgid "一整套东西。"
msgstr "A complete set of things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_DECIDUOUS"
msgid "你不就是最可爱的小猫吗。"
msgstr "Aren't you the cutest little kitty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_DESERT"
msgid "我要收集更多……为了研究。"
msgstr "I must collect more... for research."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_FOREST"
msgid "你不就是最可爱的小猫吗。"
msgstr "Aren't you the cutest little kitty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_GRASS"
msgid "你不就是最可爱的小猫吗。"
msgstr "Aren't you the cutest little kitty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_MARSH"
msgid "我要收集更多……为了研究。"
msgstr "I must collect more... for research."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_MOON"
msgid "我要收集更多……为了研究。"
msgstr "I must collect more... for research."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_NAMETAG"
msgid "该想几个名字。让我看看，小威尔逊，小威尔逊二号……"
msgstr "Should think of some names. Let's see, little Wilson, little Wilson the second..."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_ROCKY"
msgid "我要收集更多……为了研究。"
msgstr "I must collect more... for research."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_SAVANNA"
msgid "你不就是最可爱的小猫吗。"
msgstr "Aren't you the cutest little kitty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KITCOON_YOT"
msgid "我要收集更多……为了研究。"
msgstr "I must collect more... for research."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KLAUS"
msgid "那到底是什么东西。"
msgstr "What on earth is that thing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KLAUSSACKKEY"
msgid "作为鹿角，它讲究得过分。"
msgstr "As antlers go, these are excessively refined."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KLAUS_SACK"
msgid "那个绝对要打开。"
msgstr "That absolutely must be opened."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT"
msgid "将军。"
msgstr "Checkmate."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "噩梦骑士。"
msgstr "Nightmare knight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_YOTH.FOLLOWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "好骑士。"
msgstr "Good knight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "谁在管事。你听说了吗。"
msgstr "Who's in charge. Have you heard."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "别在这里乱转。"
msgstr "Stop loitering here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFANT_CARCASS"
msgid "可爱地死了。"
msgstr "Died adorably."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFANT_SUMMER"
msgid "可爱又美味。"
msgstr "Cute and delicious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFANT_WINTER"
msgid "看着很暖，也很多肉。"
msgstr "Looks warm, and meaty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KOALEFIG_TRUNK"
msgid "很好，现在我鼻子塞住了。"
msgstr "Great. Now my nose is stuffed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KRAMPUS"
msgid "它在抢我的东西。"
msgstr "It's stealing my things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KRAMPUS_SACK"
msgid "上面全是坎普斯的黏液。"
msgstr "Covered in Krampus slime."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.KURIKUTA_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.KURIKUTA_DRIED"
msgid "干掉的果实。味道很奇怪。"
msgstr "Dried fruit. Tastes strange."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LANTERN"
msgid "比较文明的照明。"
msgstr "A more civilized lighting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LATKES"
msgid "这个我能再吃很多。"
msgstr "I could eat a lot more of these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "这件甲被石化过，防护到顶。"
msgstr "This armor was petrified. Maximum protection."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "这已经是最好的了。"
msgstr "This is the best there is."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "轻。但不太耐用。"
msgstr "Light. But not very durable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "很轻，为机动而做。"
msgstr "Very light, built for mobility."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "它能提供不错的防护。"
msgstr "It offers decent protection."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "那能让我打得重一点。"
msgstr "That would let me hit a bit harder."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "穿上那个，我能多做几次动作。"
msgstr "Wearing that, I could act a few more times."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "那应该能保我安全。"
msgstr "That should keep me safe."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "所有人，去砸掉那面战旗。"
msgstr "Everyone, smash that battle standard."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_BERNIE"
msgid "他也许能替我们引开注意。"
msgstr "He might draw their attention for us."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_BOARLORD"
msgid "这里管事的是他。"
msgstr "He's the one in charge here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "那个能造成很大的破坏。"
msgstr "That could deal tremendous damage."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "是石头怪物。"
msgstr "A stone monster."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "它的目光里满是学问。"
msgstr "Its gaze is full of learning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "那些软羽毛让我想跑起来。"
msgstr "Those soft feathers make me want to run."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "一股硫磺味。"
msgstr "A smell of sulfur."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "那朵花和治疗的魔术很合。"
msgstr "That flower pairs well with healing magic."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "这个花环能恢复一点体力。"
msgstr "This garland restores a bit of stamina."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "一件很锋利的器具。"
msgstr "A very sharp instrument."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "它需要一把钥匙。"
msgstr "It needs a key."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "这样就行了。"
msgstr "This will do."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "戴上它，我的攻击会更疼一点。"
msgstr "Wearing it, my hits will sting a bit more."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_LUCY"
msgid "那件武器是用来扔的。"
msgstr "That weapon is meant for throwing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "我们是从那里来的。希望也能从那里回去。"
msgstr "We came from there. Hopefully we can go back that way."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "我先走了。"
msgstr "I'll go on ahead."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "那些结晶会让我的能力更快。"
msgstr "Those crystals will speed my abilities up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_SPAWNER"
msgid "那些敌人是从这里出来的。"
msgstr "Those enemies come out of there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "看起来打起来很有分量。"
msgstr "Looks like it packs weight in a fight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "它似乎能放大治疗的手艺。"
msgstr "It seems to amplify the healing craft."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE"
msgid "太烫。拿不住。"
msgstr "Too hot. Can't hold it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_COCOON"
msgid "冷下来了。也安静下来了。"
msgstr "It's cooled down. And quieted down."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "里面透出微弱的暖意。"
msgstr "A faint warmth seeps from inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "那颗蛋不够暖。"
msgstr "That egg isn't warm enough."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "没想到蛋也会开心。"
msgstr "Didn't know eggs could be happy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.CONTENT"
msgid "它看着很满足。"
msgstr "It looks very content."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.GENERIC"
msgid "乖孩子是谁呢。"
msgstr "Who's a good child."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "听见很小的一声肚子叫。"
msgstr "Heard a tiny stomach growl."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_PET.STARVING"
msgid "这小东西快饿死了。"
msgstr "This little thing is starving."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVAE_TOOTH"
msgid "是破壳用的牙。"
msgstr "A tooth for breaking out of the shell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVASPIT.COOL"
msgid "我管它叫\"玄武岩唾液\"。"
msgstr "I call it \"basaltsaliva\"."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVASPIT.HOT"
msgid "烫的口水。"
msgstr "Hot spit."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVA_POND"
msgid "岩浆。壮观。"
msgstr "Magma. Spectacular."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LAVA_POND_ROCK"
msgid "石头。和别处的石头一样。"
msgstr "A rock. Same as rocks anywhere else."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEAFLOAF"
msgid "来源不明的叶肉。"
msgstr "Leaf flesh of unknown origin."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEAFYMEATBURGER"
msgid "素食。但并不无害。"
msgstr "Vegetarian. But not harmless."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "学问是不是走得太远了。"
msgstr "Hasn't learning gone a bit too far."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEIF"
msgid "它很大。"
msgstr "It's big."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEIF_IDOL"
msgid "用木头雕一棵树，似乎有点多余。"
msgstr "Carving a tree out of wood seems a bit redundant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LEIF_SPARSE"
msgid "它很大。"
msgstr "It's big."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LICHEN"
msgid "这种光线下只有蓝藻能长。"
msgstr "In this light, only cyanobacteria grow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIFEINJECTOR"
msgid "一次突破。这就是解药。"
msgstr "One breakthrough. This is the antidote."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTBULB"
msgid "看起来意外地可口。"
msgstr "Surprisingly looks delicious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTCRAB"
msgid "它会自己发光。"
msgstr "It glows all by itself."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTER"
msgid "那是她的幸运打火机。"
msgstr "That's her lucky lighter."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTFLIER"
msgid "很奇怪，带着一只，口袋会变轻。"
msgstr "How strange. Carrying one makes the pocket lighter."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "它好像不喜欢被雷打。"
msgstr "It seems to dislike being struck by lightning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "\"咩\"你自己去说。"
msgstr "You go say \"baa\" yourself."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNINGGOATHORN"
msgid "像一根小型的避雷针。"
msgstr "Like a small lightning rod."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "雷电归我了。"
msgstr "The lightning is mine now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "把天上的东西收下来。"
msgstr "Brings the sky's things down to earth."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LITTLE_WALRUS"
msgid "它不会一直这么可爱。"
msgstr "It won't stay this cute forever."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGLOG"
msgid "它看着很不安。"
msgstr "It looks uneasy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGTREE"
msgid "它在看我吗。"
msgstr "Is it looking at me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGTREE_ROOT"
msgid "里面有东西。得把它挖出来。"
msgstr "Something is inside. Have to dig it out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LIVINGTREE_SAPLING"
msgid "它会长得又大又可怕。"
msgstr "It will grow big and dreadful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOBSTERBISQUE"
msgid "再加点盐会更好，但那不是我的事。"
msgstr "A bit more salt would be better, but that's not my call."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOBSTERDINNER"
msgid "早上吃的话还算晚餐吗。"
msgstr "If eaten in the morning, does it still count as dinner."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOG.BURNING"
msgid "很烫的木头。"
msgstr "Very hot wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOG.GENERIC"
msgid "大，重，而且是木头。"
msgstr "Big, heavy, and made of wood."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LORDFRUITFLY"
msgid "喂，别再折腾那些植物了。"
msgstr "Hey, stop tormenting those plants."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_1"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_10"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_11
