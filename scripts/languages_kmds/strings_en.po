msgid "跑了。……可惜。"
msgstr "Escaped. ...A pity."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TOADESCAPING"
msgid "蟾蜍要逃。追。"
msgstr "The toad means to flee. ...After it."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TOOL_SLIP"
msgid "滑手了。握紧。"
msgstr "It slipped. ...Grip harder."

#. STRINGS.CHARACTERS.WRATH.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WRATH.ANNOUNCE_TOOL_TOOWEAK"
