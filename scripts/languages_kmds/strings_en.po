msgstr "So small, a baby shroom?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "被酸糊了一层呢～别碰哟～"
msgstr "Coated in acid."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHTREE_TALL.BLOOM"
