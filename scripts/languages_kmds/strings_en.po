msgstr "Something about to become a boat bumper."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.BOAT_BUMPER_SHELL"
