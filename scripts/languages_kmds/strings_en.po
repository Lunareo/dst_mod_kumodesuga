msgstr "Not warm enough."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "幸福的蛋。第一次见。"
msgstr "A happy egg. A first."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.CONTENT"
msgid "看着挺开心。"
msgstr "It looks happy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.GENERIC"
msgid "乖怪物。"
msgstr "A good monster."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "肚子小声叫着。"
msgstr "A tiny tummy rumble."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_PET.STARVING"
msgid "饿坏了。"
msgstr "Starving."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAE_TOOTH"
msgid "卵里的牙。"
msgstr "An egg tooth."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVASPIT.COOL"
msgid "像岩石的口水。冷了。"
msgstr "Lava spit. Cooled."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVASPIT.HOT"
msgid "滚烫的口水。"
msgstr "Hot spittle."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVA_POND"
msgid "岩浆池。壮观。"
msgstr "A lava pond. Grand."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVA_POND_ROCK"
msgid "岩浆池的石头。暖的。"
msgstr "A lava pond. The stones are warm."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEAFLOAF"
msgid "叶子和肉。谜。"
msgstr "A leaf-meat mystery."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEAFYMEATBURGER"
msgid "素食。但里面很残酷。"
msgstr "Vegetarian. But it contains cruelty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "菜叶做的蛋奶点心。功夫菜。"
msgstr "A leaf souffle. A labor-intensive dish."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEIF"
msgid "好大！"
msgstr "Big!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEIF_IDOL"
msgid "用木头雕树。多余。"
msgstr "Carving a tree from wood. Redundant."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LEIF_SPARSE"
msgid "好大！"
msgstr "Big!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LICHEN"
msgid "这种光下，也只有藻类活得下来。"
msgstr "Only lichen, under this light."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIFEINJECTOR"
msgid "生命注射器。恶心，但有用。"
msgstr "A life injector. Revolting, but useful."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTBULB"
msgid "会发光的球。不是给我吃的。"
msgstr "It looks tasty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTCRAB"
msgid "发光的蟹！"
msgstr "A glowing crab!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTER"
msgid "她的幸运打火机。"
msgstr "Her lucky lighter."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTFLIER"
msgid "不可思议。口袋变轻了。"
msgstr "How strange. Carrying one makes the pocket lighter."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "雷我可不喜欢。"
msgstr "It does not care for lightning."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "「咩」什么咩。"
msgstr "\"Baa\"? There is nothing to baa about."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNINGGOATHORN"
msgid "小型避雷针。"
msgstr "A small lightning rod."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "这份力量归我了！"
msgstr "The lightning is mine!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "把天上的力量取下来。"
msgstr "It harvests heaven's power."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LITTLE_WALRUS"
msgid "可爱不是永远的。"
msgstr "Cute. It will not last forever."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGLOG"
msgid "一张不安的脸。"
msgstr "An uneasy face."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGTREE"
msgid "在注视我？"
msgstr "Is it watching me?"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGTREE_ROOT"
msgid "里面是什么。该追下去。"
msgstr "Something inside. It must be dug out."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LIVINGTREE_SAPLING"
msgid "会长成很可怕的东西。"
msgstr "It will grow into a great horror."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LOBSTERBISQUE"
msgid "盐少了点。没意见。"
msgstr "A little light on salt. No objections."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LOBSTERDINNER"
