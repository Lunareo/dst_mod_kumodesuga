msgstr "A door... from where will my guests arrive?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
