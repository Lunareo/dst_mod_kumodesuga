msgstr "More learned than the last one."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "不管是什么，现在烧掉了。"
msgstr "Whatever it was, it's burned now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "我造出了什么东西。"
msgstr "I have built something."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "火解决不了取名的问题。"
msgstr "Fire doesn't solve naming problems."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "谁会给东西取这种名字。"
msgstr "Who would name a thing that."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESKIN_TOOL"
msgid "我喜欢这些粉。有学问的味道。"
msgstr "I like these powders. They smell of learning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "没什么用了。"
msgstr "Of no use now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "长得很俊。"
msgstr "Handsomely made."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RESURRECTIONSTONE"
msgid "留一个落脚点总是明智的。"
msgstr "Keeping a checkpoint is always wise."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.REVIVER"
msgid "这颗丑心脏一跳，幽灵就能回来。"
msgstr "One beat of this ugly heart, and a ghost comes back."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RHINODRILL"
msgid "他天生适合这种活。"
msgstr "He was born for this line of work."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROASTTURKEY"
msgid "那根多汁的腿上写着我的名字。"
msgstr "That juicy leg has my name on it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN.GENERIC"
msgid "这是说冬天走了吗。"
msgstr "Does this mean winter is over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN.HELD"
msgid "它喜欢我的口袋。"
msgstr "It likes my pocket."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "在冰冷的荒地上活着。"
msgstr "Surviving on the frozen wasteland."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBIN_WINTER.HELD"
msgid "很软。"
msgstr "Very soft."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBOT_BLUEPRINT"
msgid "一个缝纫的活，却要焊这么多东西。"
msgstr "A sewing job, yet so much welding."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROBOT_PUPPET"
msgid "他们被困住了。"
msgstr "They're trapped."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK"
msgid "它装不进我的口袋。"
msgstr "It won't fit in my pocket."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCKS"
msgid "用这些能做点东西。"
msgstr "Something could be made with these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCKY"
msgid "爪子很可怕。"
msgstr "Those claws are fearsome."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "它结果的日子结束了。"
msgstr "Its fruit-bearing days are over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "它在烧。"
msgstr "It's burning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "看着病得不轻。"
msgstr "Looks very sick."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "嗯。有点不对。"
msgstr "Hm. Something's off."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "一株灌木……来自月亮。"
msgstr "A shrub... from the moon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "要等一阵才会再结果。"
msgstr "A while before it fruits again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "外面很热。"
msgstr "It's hot out here."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "咬那个会崩牙。"
msgstr "Biting that would crack a tooth."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "没煮过的石果最糟。"
msgstr "Uncooked stone fruit is the worst."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "现在它软得能吃了。"
msgstr "It's soft enough to eat now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "它在长。"
msgstr "It's sprouting."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_ICE.GENERIC"
msgid "冰。见到你很好。"
msgstr "Ice. Nice to meet you."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_ICE.MELTED"
msgid "等它再冻起来才有用。"
msgstr "Useless until it freezes again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_ICE_MELTED"
msgid "等它再冻起来才有用。"
msgstr "Useless until it freezes again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "结了壳的岩浆坑。"
msgstr "A crusted-over lava pool."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.LOW"
msgid "岩浆在结壳。"
msgstr "The magma is crusting over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "舒服。"
msgstr "Comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_LIGHT.OUT"
msgid "看着很脆。"
msgstr "Looks brittle."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_MOON"
msgid "那块石头来自月亮。"
msgstr "That stone came from the moon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "它僵在那里，像吓坏了。"
msgstr "It's frozen in place, as if terrified."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "它僵在那里，像吓坏了。"
msgstr "It's frozen in place, as if terrified."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROOK"
msgid "攻城。"
msgstr "Siege."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROOK_NIGHTMARE"
msgid "看起来很能打。"
msgstr "Looks like it can fight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROPE"
msgid "几段短绳。"
msgstr "A few short ropes."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "这会让我们一直悬着。"
msgstr "This will keep us in suspense."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "这不太像薇诺娜平时的风格。"
msgstr "This doesn't quite seem Winona's usual style."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROTTENEGG.CAN_PROCESS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROTTENEGG.CAN_PROCESS"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROTTENEGG.GENERIC"
msgid "臭。"
msgstr "Rotten."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ROYAL_JELLY"
msgid "吃下去的人会得到力量。"
msgstr "Whoever eats it gains power."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUBBLE"
msgid "只是些石头碎块。"
msgstr "Just some rock debris."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUINSHAT"
msgid "我的头发还好吗。"
msgstr "Is my hair still okay."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUINS_BAT"
msgid "分量不轻。"
msgstr "Not light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.RUINS_RUBBLE"
msgid "这个能修好。"
msgstr "This can be repaired."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "我听见低语。它想要什么。"
msgstr "I hear whispering. What does it want."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "它在下判断。"
msgstr "It's deliberating."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLEHORN"
msgid "用它能把鞍卸下来。"
msgstr "With it, the saddle can come off."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_BASIC"
msgid "靠它能骑上那种有味道的动物。"
msgstr "With it, one can ride that smelly animal."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_RACE"
msgid "这副鞍很快。"
msgstr "This saddle is fast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_SHADOW"
msgid "它让我想起某些事。真是。"
msgstr "It reminds me of certain things. Truly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_WAR"
msgid "唯一的问题是会磨伤。"
msgstr "The only issue is chafing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SADDLE_WATHGRITHR"
msgid "那是薇格弗德做的吗。看着很随意。"
msgstr "Did Wigfrid make this. It looks casual."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALSA"
msgid "好……辣。"
msgstr "Good... and spicy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTBOX"
msgid "对付食物变坏的办法。"
msgstr "The answer to food going bad."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTLICK"
msgid "要舔多少下才到中心。"
msgstr "How many licks to the center."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTLICK_IMPROVED"
msgid "光看着它我就渴了。"
msgstr "I'm thirsty just looking at it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTROCK"
msgid "好奇心让我想舔它。"
msgstr "Curiosity makes me want to lick it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTSTACK.GENERIC"
msgid "那些是天然形成的吗。"
msgstr "Did those form naturally."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTSTACK.GROWING"
msgid "它大概就是这样长的。"
msgstr "So that's how it grows."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "挖完了。全挖完了。"
msgstr "Mined out. All mined out."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTY_DOG"
msgid "谁是骄傲的小海豹。"
msgstr "Who's a proud little seal."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SALTY_DOGHAT"
msgid "它只附带一段友情。"
msgstr "It only comes with friendship."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANDBLOCK"
msgid "很粗糙。"
msgstr "Very crude."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANDSPIKE"
msgid "差点被穿成串。"
msgstr "I was almost skewered."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANITYROCK.ACTIVE"
msgid "那块石头看着很疯。"
msgstr "That stone looks insane."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SANITYROCK.INACTIVE"
msgid "剩下的部分去哪了。"
msgstr "Where did the rest of it go."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.BURNING"
msgid "烧得很快。"
msgstr "Burns fast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.DISEASED"
msgid "看着病得不轻。"
msgstr "Looks very sick."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.DISEASING"
msgid "嗯。有点不对。"
msgstr "Hm. Something's off."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.GENERIC"
msgid "小树很可爱。"
msgstr "Little trees are cute."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.PICKED"
msgid "这是给它的教训。"
msgstr "A lesson for it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SAPLING.WITHERED"
msgid "凉下来它大概就没事了。"
msgstr "It'll be fine once it cools down, probably."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCANDATA"
msgid "一股新鲜研究的味道。"
msgstr "The smell of fresh research."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCARECROW.BURNING"
msgid "有人让那个草人吃了苦头。"
msgstr "Someone made that scarecrow suffer."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCARECROW.BURNT"
msgid "有人杀了那个稻草人。"
msgstr "Someone murdered that scarecrow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCARECROW.GENERIC"
msgid "穿戴整齐，却无处可去。"
msgstr "Dressed neatly, with nowhere to go."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCORCHED_SKELETON"
msgid "瘆人。"
msgstr "Eerie."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCRAPBOOK_PAGE"
msgid "外面还有别人喜欢做剪贴簿。"
msgstr "Someone out there enjoys scrapbooking too."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCRAPHAT"
msgid "那顶帽子的尖几乎和我的脑子一样利。"
msgstr "That hat's point is nearly as sharp as my brain."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "它让我看着更出众吗。"
msgstr "Does it make me look more distinguished."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "可以开始雕了。"
msgstr "Ready to start carving."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "烧得干净。"
msgstr "Burned clean."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "用这个能做石雕。"
msgstr "Stone sculptures can be made with this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "杰作。"
msgstr "A masterpiece."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "看着旧。摸着新。"
msgstr "Looks old. Feels new."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "然后呢。"
msgstr "And then what."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "里面有东西在动。"
msgstr "Something is moving inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "缺了很大一块。"
msgstr "A large chunk is missing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "那是头吗。"
msgstr "Is that a head."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "一座奇怪的大理石像。"
msgstr "A strange marble figure."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "至少现在拼回一整块了。"
msgstr "At least it's whole again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "里面有东西在动。"
msgstr "Something is moving inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "他在压力下裂开了。"
msgstr "He cracked under pressure."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "剩下的部分呢。"
msgstr "Where is the rest of it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "某种大理石像。"
msgstr "Some kind of marble figure."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "补好了。"
msgstr "Patched up."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "里面有东西在动。"
msgstr "Something is moving inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "状态不算好。"
msgstr "Not in great shape."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "这是从哪来的。"
msgstr "Where did this come from."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "那些学问随海丢了。"
msgstr "That learning went down with the sea."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "该先做几个箱子。"
msgstr "Time to make a few boxes first."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEAFOODGUMBO"
msgid "一份很大的海鲜浓汤。"
msgstr "A very large seafood stew."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEASTACK"
msgid "一块石头。"
msgstr "A rock."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "有意思。它是空的。"
msgstr "Interesting. It's empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "你不就是最可爱的一团纯能量吗。"
msgstr "Aren't you the cutest blob of pure energy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEEDPOUCH"
msgid "我早就厌倦口袋里散着种子。"
msgstr "I'd long since tired of seeds spilling in my pocket."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEEDS"
msgid "每一颗都是小小的谜。"
msgstr "Each one is a tiny mystery."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEEDS_COOKED"
msgid "这一烤，里面的命就没了。"
msgstr "That roasting ended the life inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SENTRYWARD"
msgid "用来画地图的装置。"
msgstr "A device for drawing maps."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_KIT"
msgid "缝补用的。"
msgstr "For mending."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "烧得干净，也无处可去。"
msgstr "Burned clean, with nowhere to go."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "穿戴整齐，却无处可去。"
msgstr "Dressed neatly, with nowhere to go."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SEWING_TAPE"
msgid "适合修东西。"
msgstr "Good for fixing things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWDANCER"
msgid "有些东西看过就忘不掉。"
msgstr "Some things can't be unseen."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWDIGGER"
msgid "很好。他又多了一个。"
msgstr "Good. Another one for him."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWHEART"
msgid "某种力量让它重新动了。"
msgstr "Some force made it move again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "那个坑看着深不见底。"
msgstr "That pit looks bottomless."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "可怕。"
msgstr "Dreadful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "翻过来了。"
msgstr "Flipped over."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "是头，还是头。"
msgstr "A head, or the head."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "手拿开。"
msgstr "Hands off."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "它看着很想打一场。"
msgstr "It looks eager for a fight."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "这一只嘴很多。"
msgstr "This one has a lot of mouth."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "它让我的脑子发痒。"
msgstr "It makes my brain itch."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "那对翅膀似乎只是好看。"
msgstr "Those wings seem purely decorative."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_BATTLEAXE"
msgid "我宁愿把这把斧头埋了。"
msgstr "I'd rather bury this axe."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_BEEF_BELL"
msgid "它和我那只旧牛铃一模一样。"
msgstr "It's identical to my old cowbell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_FORGE"
msgid "它会让什么样的黑暗设计成形。"
msgstr "What kind of dark design will it bring to form."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_FORGE_KIT"
msgid "不做几个试验就太不讲道理了。"
msgstr "Not running a few experiments would be unreasonable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHADOW_HEART_VEIN"
msgid "一次徒劳的尝试。"
msgstr "A futile attempt."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHALLOW_GRAVE"
msgid "你死，比我死好。"
msgstr "Better you die than me."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHARK"
msgid "我们大概需要更大的船。"
msgstr "We're probably going to need a bigger boat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHARKBOI"
msgid "让我发抖。"
msgstr "It makes me shiver."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHELLWEAVER"
msgid "我要用盐做点有用的东西。"
msgstr "I'll make something useful out of salt."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SHELL_CLUSTER"
