msgstr "Cute, and dead."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KOALEFANT_SUMMER"
msgid "可爱。……也能当食物。"
msgstr "Cute, and tasty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KOALEFANT_WINTER"
msgid "暖和，肉又多。"
msgstr "Warm, and meaty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KOALEFIG_TRUNK"
msgid "鼻子堵住了。"
msgstr "My nose is stuffed."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KRAMPUS"
msgid "东西被它盯上了！"
msgstr "My things are being marked!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KRAMPUS_SACK"
msgid "黏液黏糊糊的。"
msgstr "Sticky with mucus."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KURIKUTA_DRIED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.KURIKUTA_DRIED"
msgid "果干……聊胜于无。我更想吃带血的肉。"
msgstr "Dried fruit.... Better than nothing. I'd rather have meat. The bloody kind."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LANTERN"
msgid "文明的光。"
msgstr "The light of civilization."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LATKES"
msgid "煎饼。油多。"
msgstr "A pancake. Tasty."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "石化，防御拉满。"
msgstr "Stone-clad defense at its utmost."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "最高级。"
msgstr "The highest grade."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "很轻。但很脆。"
msgstr "Light. But weak."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
