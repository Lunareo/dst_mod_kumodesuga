msgstr "Checkpoint!"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
