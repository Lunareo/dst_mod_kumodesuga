msgstr "This one is a bit plain."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "这才是真货。"
msgstr "Now this is the genuine article."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "这才是真货。"
msgstr "Now this is the genuine article."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OCEANFISH_MEDIUM_8"
