msgstr "That looks terrifyingly strong."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "现在还盖着。"
msgstr "Still covered for now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "现在还盖着。"
msgstr "Still covered for now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SURFNTURF"
msgid "刚刚好。"
msgstr "Just right."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SWEATERVEST"
msgid "这件背心讲究到不行。"
msgstr "This vest is refined beyond measure."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SWEETPOTATO"
