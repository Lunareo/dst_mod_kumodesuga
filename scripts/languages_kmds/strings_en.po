msgstr "Completely dead."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
