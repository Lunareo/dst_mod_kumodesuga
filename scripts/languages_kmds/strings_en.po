msgstr "Jerky time!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "算是「干」了。"
msgstr "In a \"dried\" state."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DRYING"
