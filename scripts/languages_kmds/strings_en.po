msgstr "Its acorns were stolen, furious."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECK_OF_CARDS"
msgid "牌齐全吗？"
msgstr "A full deck?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_CENTERPIECE"
msgid "做得挺精致呢～"
msgstr "Exquisite."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "花瓶～里面没花呢～"
msgstr "A vase, without flowers."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "小小的光～有它就好～"
msgstr "A little light, a good thing."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "花瓶～里面有花呢～"
msgstr "A vase, with flowers."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "麦斯威尔催过换灯泡的事呢～"
msgstr "Maxwell has been nagged about that bulb."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "不新鲜了呀～"
msgstr "Past its prime."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_LAMP"
msgid "把光迎进来啦～"
msgstr "Welcoming in the light."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "很美呢～"
msgstr "Beautiful."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "画什么好呢～"
msgstr "What shall I draw?"

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "挺好看的呢～"
msgstr "Lovely."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEER.ANTLER"
msgid "这对角真气派呢～"
msgstr "Such splendid antlers."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEER.GENERIC"
msgid "在盯着我吗？……没有吧～"
msgstr "Is it staring at me? ...No, surely not."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.DEERCLOPS"
