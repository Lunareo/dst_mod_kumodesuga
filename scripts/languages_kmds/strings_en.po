#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "要放孢子进去才行呢～"
msgstr "Needs spores."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.MUSHROOM_FARM.LOTS"
