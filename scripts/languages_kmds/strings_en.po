#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATFRAGMENT05"
msgid "剩得不多了呢～"
msgstr "Not much left."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.BOATPATCH"
