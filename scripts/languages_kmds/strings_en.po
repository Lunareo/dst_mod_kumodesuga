msgstr "Wood armor, ordinary."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARMOR_BRAMBLE"
msgid "防御力最高的一套～穿上就无敌啦～"
msgstr "Maximum prickly defense."

#. STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.ARIEL.DESCRIBE.ARMOR_CARROTLURE"
