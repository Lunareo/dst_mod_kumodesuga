msgstr "The rain makes it longer."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
