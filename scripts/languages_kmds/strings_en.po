#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "说「风干」不太准。"
msgstr "Drying, imprecisely."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
