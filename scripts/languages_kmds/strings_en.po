msgstr "It hastens the crystal's power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAARENA_SPAWNER"
msgid "敌人从这里出来。"
msgstr "The enemies come from here."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "一击很重。"
msgstr "The feel of a mighty blow."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "治疗的效果好像更强了。"
msgstr "It seems to raise the healing effect."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE"
msgid "太烫，碰不得。"
msgstr "Hot. It cannot be touched."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_COCOON"
msgid "冷下来的茧。"
msgstr "A cooling cocoon."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "里面是温的。"
msgstr "Faintly warm within."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "温度不够。"
msgstr "Not warm enough."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "幸福的蛋。初次见面。"
msgstr "A contented egg. ...A first."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.CONTENT"
msgid "看着很开心。"
msgstr "It looks happy."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.GENERIC"
msgid "好怪物。"
msgstr "A good monster."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "肚子在小声叫。"
msgstr "Its stomach growls, faintly."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_PET.STARVING"
msgid "饿坏了。"
msgstr "Desperately hungry."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVAE_TOOTH"
msgid "卵里的牙。"
msgstr "An egg tooth."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVASPIT.COOL"
msgid "像岩石一样的口水。冷了。"
msgstr "Rock spittle. ...Cooled."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVASPIT.HOT"
msgid "滚烫的口水。"
msgstr "Hot spittle."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVA_POND"
msgid "岩浆池。壮观。"
msgstr "A lava pond. ...Majestic."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LAVA_POND_ROCK"
msgid "岩浆池。石头是暖的。"
msgstr "A lava pond. ...The stones are warm."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LEAFLOAF"
msgid "叶子和肉，想不通。"
msgstr "A leaf-meat mystery."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LEAFYMEATBURGER"
msgid "算素的，可里面仍有杀生。"
msgstr "Vegetarian. ...Yet it contains cruelty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "手艺，是不是过头了。"
msgstr "Science. ...Taken too far?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LEIF"
msgid "好大！"
msgstr "Big!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LEIF_IDOL"
msgid "用木头雕树，绕了远路。"
msgstr "Carving a tree from wood. ...Circuitous."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LEIF_SPARSE"
msgid "好大！"
msgstr "Big!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LICHEN"
msgid "这种光下，只长得出藻类。"
msgstr "Only lichen, under this light."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIFEINJECTOR"
msgid "学问的突破！能治伤！"
msgstr "A scientific breakthrough! ...And healing!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTBULB"
msgid "看起来能吃。"
msgstr "It looks tasty."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTCRAB"
msgid "会发光的小家伙！"
msgstr "A glowing crab!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTER"
msgid "她的幸运打火机。"
msgstr "Her lucky lighter."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTFLIER"
msgid "不可思议，口袋轻了。"
msgstr "Wondrous. ...My pocket grows lighter."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "雷，我不喜欢。"
msgstr "It does not care for lightning."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "「咩」是什么意思。"
msgstr "\"Baa\"? There is nothing to baa about."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNINGGOATHORN"
msgid "小的避雷针。"
msgstr "A small lightning rod."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "这力量是我的了！"
msgstr "The power is mine!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "把天上的力接下来。"
msgstr "It harvests heaven's power."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LITTLE_WALRUS"
msgid "可爱不会一直可爱。"
msgstr "Cute. It will not last forever."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGLOG"
msgid "一张不安的脸。"
msgstr "An uneasy face."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGTREE"
msgid "在看着我？"
msgstr "Is it watching me?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGTREE_ROOT"
msgid "里面有什么。该追下去。"
msgstr "Something within. ...It should be pursued."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LIVINGTREE_SAPLING"
msgid "会长成很可怕的东西。"
msgstr "It will grow into something greatly feared."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LOBSTERBISQUE"
msgid "盐少了些。没意见。"
msgstr "Low on salt. ...No complaints."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LOBSTERDINNER"
msgid "早上吃……算晚餐吗？"
msgstr "Eaten in the morning... or is it dinner?"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LOG.BURNING"
msgid "热的木头！"
msgstr "Hot wood!"

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LOG.GENERIC"
msgid "又大又重的木头。"
msgstr "A big, heavy log."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LORDFRUITFLY"
msgid "喂，别扰乱这片地。"
msgstr "Hey. ...Do not disturb the plants."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.LOST_TOY_1"
msgid "总觉得有来由。……说不上来。"
msgstr "It has an air of purpose. ...I cannot grasp it."

