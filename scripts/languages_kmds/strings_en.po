msgstr "Better than the dark."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.HIGH"
msgid "烧得过头了。"
msgstr "The fire is excessive."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.LOW"
msgid "火太小。"
msgstr "The fire is low."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.NORMAL"
msgid "正好。"
msgstr "Just right."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIRE.OUT"
msgid "结束了。"
msgstr "Over."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "快灭了。加点柴。"
msgstr "Dying. Add fuel."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "总比一片黑好。"
msgstr "Better than the dark."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "有围栏就放心。"
msgstr "Good, to have a rim."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.LOW"
msgid "火太小。"
msgstr "The fire is low."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "正好。"
msgstr "Just right."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLDFIREPIT.OUT"
msgid "还能再点起来。"
msgstr "It can be lit again."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COLLAPSEDCHEST"
msgid "压坏了。装不下了吧。"
msgstr "The laws of physics, bent."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.E"
msgid "东。"
msgstr "East."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.GENERIC"
msgid "哪边是哪边？"
msgstr "Which way am I facing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.N"
msgid "北。"
msgstr "North."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.NE"
msgid "东北。"
msgstr "Northeast."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.NW"
msgid "西北。"
msgstr "Northwest."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.S"
msgid "南。"
msgstr "South."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.SE"
msgid "东南。"
msgstr "Southeast."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.SW"
msgid "西南。"
msgstr "Southwest."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPASS.W"
msgid "西。"
msgstr "West."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOST"
msgid "植物的饵。仅此而已。"
msgstr "Plant food. Nothing more."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "正好！"
msgstr "Just right!"

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "居然还能更臭。意外。"
msgstr "It could smell even worse. Surprising."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "太干了。"
msgstr "Mm. Too dry."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "臭。到极限了。"
msgstr "Revolting. The limit."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTINGBIN.WET"
msgid "太湿了。"
msgstr "Too wet."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COMPOSTWRAP"
msgid "沃姆伍德劝我吃。我拒了。"
msgstr "Wormwood offered food. I declined."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CONSTRUCTION_PLANS"
msgid "设计图。有用，收下了。"
msgstr "Blueprints. Useful. I'll take them."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKBOOK"
msgid "料理的知识。看着就饿。"
msgstr "Cooking knowledge. It makes me hungrier."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDMANDRAKE"
msgid "可怜的家伙。"
msgstr "The poor thing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDMEAT"
msgid "烤得正好。……可惜血都放掉了。"
msgstr "Roasted just right.... Too much blood left in it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDMONSTERMEAT"
msgid "比生的好一点。就一点。"
msgstr "Slightly better than raw. Only slightly."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKEDSMALLMEAT"
msgid "不用担心寄生虫了。"
msgstr "No more parasite worries."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKIECUTTER"
msgid "盯着我的船，不安分。"
msgstr "It eyes my boat. Uneasy."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKIECUTTERHAT"
msgid "至少头发是干的。"
msgstr "At least my hair stays dry."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKIECUTTERSHELL"
msgid "只剩壳了。"
msgstr "Only the shell remains."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "字迹乱得读不了。"
msgstr "The handwriting cannot be read."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.BURNT"
msgid "锅自己被煮了。"
msgstr "The pot itself was cooked."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "还要一会儿。"
msgstr "It will take a while."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "快好了。"
msgstr "Nearly done."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.DONE"
msgid "好了。开吃。"
msgstr "Done. Eat."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOKPOT.EMPTY"
msgid "看着它就饿。"
msgstr "It looks hungry."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COOLANT"
msgid "在冒泡。冷的东西我喜欢。"
msgstr "Bubbling. Full of potential."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.COONTAIL"
msgid "还在摇。"
msgstr "Still swishing."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN"
msgid "糖分很高。"
msgstr "High in sugar."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN_COOKED"
msgid "烤过了，糖分还是高。"
msgstr "Roasted, and still sugary."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN_OVERSIZED"
msgid "玉米穗。真大。"
msgstr "A big ear of corn."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CORN_SEEDS"
msgid "种子。"
msgstr "Seeds."

