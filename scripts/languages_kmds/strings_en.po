msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_2"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_42"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_43"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LOST_TOY_7"
msgid "这件事有很正当的解释。"
msgstr "There is a perfectly valid explanation for this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "运气不错的发现。"
msgstr "A lucky find."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUCY"
msgid "比我平常用的斧头好看。"
msgstr "Nicer looking than my usual axe."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUMPY_SAPLING"
msgid "这棵树是怎么繁殖的。"
msgstr "How does this tree even reproduce."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARFROG"
msgid "别看了。"
msgstr "Stop looking."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARPLANTHAT"
msgid "它让我看着比平常更亮。"
msgstr "It makes me look brighter than usual."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARPLANT_HUSK"
msgid "它硬得惊人。这个我能用。"
msgstr "Startlingly hard. I could use this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARPLANT_KIT"
msgid "我在兼职做裁缝。"
msgstr "I'm moonlighting as a tailor."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "结晶化的光。"
msgstr "Crystallized light."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARRIFT_PORTAL"
msgid "那么多学问藏在里面……我却拿不到。"
msgstr "So much learning hidden inside... and none of it mine to take."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARTHRALL_PLANT"
msgid "它似乎不在意别人的距离。"
msgstr "It seems unbothered by other people's distance."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "它的脾气很扎人。"
msgstr "Its temper is prickly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_FORGE"
msgid "正适合做点很聪明的东西。"
msgstr "Just the place to make something clever."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_FORGE_KIT"
msgid "几种元素的简单组合。"
msgstr "A simple combination of several elements."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_GRAZER"
msgid "它一定是从那道奇怪的裂缝过来的。"
msgstr "It must have come through that strange fissure."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_SEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUNAR_SEED"
msgid "这曾是它王冠的一部分。"
msgstr "This used to be part of its crown."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUREPLANT"
msgid "很吸引人。"
msgstr "Very enticing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUREPLANTBULB"
msgid "可以开一片肉的农场了。"
msgstr "One could farm meat with this."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.LUTEFISK"
msgid "有没有别的鱼。"
msgstr "Is there any other fish."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MADSCIENCE_LAB"
msgid "用一点理智换来这些，不算贵。"
msgstr "A bit of sanity for all this. A fair price."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MAGICIAN_CHEST"
msgid "为什么我开始觉得不安。"
msgstr "Why am I starting to feel uneasy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS"
msgid "确实是只恶禽。"
msgstr "Truly a villainous fowl."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS_BEAK"
msgid "一股鱼味。"
msgstr "A fishy smell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS_FEATHER"
msgid "从一只讲究的羽毛恶兽身上拔下来的。"
msgstr "Plucked from a refined feathery beast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "我在织羽毛。"
msgstr "I'm weaving feathers."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MALE_PUPPET"
msgid "他被困住了。"
msgstr "He's trapped."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKE"
msgid "曼德拉草的根有奇怪的性质。"
msgstr "Mandrake roots have strange properties."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKESOUP"
msgid "它不会再醒了。"
msgstr "It won't wake up again."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKE_ACTIVE"
msgid "安静。"
msgstr "Quiet."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.MANDRAKE_COOKED"
msgid "现在不觉得它奇怪了。"
msgstr "It doesn't seem strange anymore."

