msgstr "Assembled wrong. Do it again."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "在忙。"
msgstr "Busy."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "死了。"
msgstr "Dead."

#. STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.SOPHIA.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
