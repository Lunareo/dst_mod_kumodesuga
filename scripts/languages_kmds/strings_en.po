msgstr "Be careful around this tree."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
