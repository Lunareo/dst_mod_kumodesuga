msgstr "Quiet."

#. STRINGS.CHARACTERS.WRATH.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WRATH.DESCRIBE.FIRESUPPRESSOR.ON"
