msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "眼睛在跟着人转。"
msgstr "The eye follows one about."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "碍眼的雕塑。"
msgstr "An eyesore of a sculpture."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "虫子的雕像。谁想看这个。"
msgstr "A worm. Of course."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "让人想起坏事。"
msgstr "A memory. The bad kind."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "石头也会盯人。"
msgstr "A stone stare."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_FORMAL"
msgid "不像个王。"
msgstr "It does not resemble a king."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "这样比较好。"
msgstr "Better this way."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "看着它，肚子就叫了。"
msgstr "Looking at it, my stomach growled."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KITCOON"
msgid "这个倒是好找。"
msgstr "This one is easy to find."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KLAUS"
msgid "不带装饰的克劳斯。……想要。"
msgstr "A Klaus with \"no decorations\". I want it."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "马。石头做的。"
msgstr "A knight. Made of stone."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "棋子自己动了。"
msgstr "The chess piece moved of its own accord."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "不袭击人的话还算好看。"
msgstr "So long as it does not attack, all is well."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "想抱一下。……石头做的，算了。"
msgstr "I want to hug it. Stone chafes."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "这回换你僵在那儿。"
msgstr "This time, you are the one frozen."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MOON"
msgid "最近灵感不错。"
msgstr "Feeling inspired lately."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "栩栩如生。……凑合吧。"
msgstr "Lifelike.... Mm. Passable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_MUSE"
msgid "嗯……在哪见过？"
msgstr "Hm... have we met? Where."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_PAWN"
msgid "小卒。……我懂它的心情。"
msgstr "A pawn. I understand its plight."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_PIPE"
msgid "烟斗。我不抽。"
msgstr "A pipe. I don't smoke."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "比看起来更重。"
msgstr "Heavier than it looks."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "棋子自己动了。"
msgstr "The chess piece moved of its own accord."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "带鳍的感觉。"
msgstr "It has the feel of a fin."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_STALKER"
msgid "骸骨就该这么老实待着。"
msgstr "A skeleton, properly still."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "当凳子？不合适。"
msgstr "A stool? No, unsuitable."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "那一晚，眼神交流最糟。"
msgstr "That night, the worst meeting of eyes."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "身高不够。"
msgstr "Falls short in height."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "月亮之上的心情？"
msgstr "Above the moon. A mood."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "设计不错。做得差了点。"
msgstr "Good design. Dubious execution."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "只差一口吐息。"
msgstr "Lacking only the howl."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "现在想起来还发抖。"
msgstr "I am still trembling."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_YOTD"
msgid "光看着，心跳就加速。"
msgstr "Just looking makes my heart race."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_YOTH"
msgid "一脸苦相的骑士。"
msgstr "The bitter knights."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESSPIECE_YOTS"
msgid "拜金的东西，我远离。"
msgstr "Gold diggers, keep away. A principle of mine."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTER"
msgid "切斯特。会走路的毛球箱。"
msgstr "Chester. A fluffy box."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "在看着我呢。"
msgstr "It's looking at me."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "睡了。"
msgstr "It sleeps."

#. STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.SOPHIA.DESCRIBE.CHESTUPGRADE_STACKSIZE"
