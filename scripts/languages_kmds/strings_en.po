msgstr "A very strange sound."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
