msgstr "So much seaweed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "里面还能再塞点海带。"
msgstr "There's room for a bit more kelp in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "它又可怜又空。"
msgstr "It's pitiful and empty."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "好多海草。"
msgstr "So much seaweed."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "里面还能再塞点海带。"
msgstr "There's room for a bit more kelp in there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONEMANBAND"
msgid "该再加一个牛铃。"
msgstr "Should add one more cowbell."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION"
msgid "看着很脆。"
msgstr "Looks crisp."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION_COOKED"
msgid "一次成功的化学反应。"
msgstr "A successful chemical reaction."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION_OVERSIZED"
msgid "它们长得真快。……我的眼睛有点酸。"
msgstr "They grow fast.... My eyes sting a little."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ONION_SEEDS"
msgid "一把奇怪的种子。"
msgstr "A handful of strange seeds."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OPALPRECIOUSGEM"
msgid "这颗宝石有点特别。"
msgstr "This gem is a bit special."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OPALSTAFF"
msgid "宝石插在棍子上会更好看。这已经被证明了。"
msgstr "A gem looks better on a stick. This has been proven."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGEAMULET"
msgid "传送很方便。"
msgstr "Teleporting is convenient."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGEGEM"
msgid "橙色的宝石。"
msgstr "An orange gem."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGEMOONEYE"
msgid "有它盯着，没人会走丢。"
msgstr "With it watching, no one gets lost."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ORANGESTAFF"
msgid "比走路好。"
msgstr "Better than walking."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTER"
msgid "你该看看另一个家伙。"
msgstr "You should see the other fellow."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTERDEN.GENERIC"
msgid "除了那个窝，那里没什么别的。"
msgstr "Nothing there but that den."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "我该走近看看。"
msgstr "I should come closer and look."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.OTTERDEN_DEAD"
msgid "我们进了不少水。"
msgstr "We've taken on quite a bit of water."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONETREE"
msgid "作为棕榈树，它有点像松树。"
msgstr "For a palm tree, it's a bit pine-like."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONE_SAPLING"
msgid "它梦想有一天成为树。"
msgstr "It dreams of becoming a tree someday."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONE_SCALE"
msgid "要是树有脚趾甲，大概就是这个样子。"
msgstr "If trees had toenails, this is what they'd look like."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PALMCONE_SEED"
msgid "一棵树最开始的样子。"
msgstr "How a tree begins."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PANDORASCHEST"
msgid "里面可能有好东西。也可能是坏东西。"
msgstr "Good things might be inside. Or bad things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PANETTONE"
msgid "这节庆面包发得很好。"
msgstr "This festive bread rose well."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PANFLUTE"
msgid "用来给动物唱小曲。"
msgstr "For serenading animals."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PAPYRUS"
msgid "几张纸。"
msgstr "A few sheets of paper."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PAVLOVA"
msgid "我很喜欢做得好的蛋白饼。"
msgstr "I'm very fond of well-made meringue."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEGHOOK"
msgid "那口水会腐蚀东西。"
msgstr "That spit will corrode things."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUIN"
msgid "大概是繁殖季。"
msgstr "Probably breeding season."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "这才叫火鸟。"
msgstr "Now that's a fire bird."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "我说这是禽。"
msgstr "I say it's a fowl."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "它正在变成新的物种。"
msgstr "It's becoming a new species."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER"
msgid "辣得不错。"
msgstr "Nicely spicy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPERPOPPER"
msgid "满满一口。"
msgstr "A full mouthful."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER_COOKED"
msgid "它本来就是辣的。"
msgstr "It was spicy to begin with."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER_OVERSIZED"
msgid "一颗尺寸相当不寻常的辣椒。"
msgstr "A pepper of quite unusual dimensions."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEPPER_SEEDS"
msgid "一把种子。"
msgstr "A handful of seeds."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERD"
msgid "笨鸟。离那些浆果远一点。"
msgstr "Silly bird. Stay away from those berries."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDFAN"
msgid "大得不合常理。"
msgstr "Unreasonably large."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDSHRINE.BURNT"
msgid "这样完全不行。"
msgstr "This is completely unacceptable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDSHRINE.EMPTY"
msgid "该在那里种点东西。"
msgstr "Something should be planted there."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PERDSHRINE.GENERIC"
msgid "我觉得它想要什么。"
msgstr "I think it wants something."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PEROGIES"
msgid "这个做得不错。"
msgstr "Well made."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS"
msgid "让那些花知道谁说话管用。"
msgstr "Let the flowers know who decides."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS_DRIED"
msgid "晒得不错。"
msgstr "Dried nicely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS_EVIL"
msgid "这些东西我不太想拿着。"
msgstr "I'd rather not hold these."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETALS_EVIL_DRIED"
msgid "晒得不错。"
msgstr "Dried nicely."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PETRIFIED_TREE"
msgid "它僵在那里，像吓坏了。"
msgstr "It's frozen in place, as if terrified."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PHLEGM"
msgid "又厚又韧。还带咸味。"
msgstr "Thick and tough. Salty too."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PHONOGRAPH"
msgid "不好，那个我以前见过。"
msgstr "Bad. I've seen that one before."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PICKAXE"
msgid "很有代表性。不是吗。"
msgstr "Very representative. Isn't it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "砸得漂亮。"
msgstr "Smashes beautifully."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PICKLEDHERRING"
msgid "你不会听到我抱怨。"
msgstr "You won't hear me complain."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE1"
msgid "你在看什么。"
msgstr "What are you looking at."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE2"
msgid "他得了金子热。"
msgstr "He's got gold fever."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE3"
msgid "泥点进你眼里了。"
msgstr "Mud got in your eye."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITE4"
msgid "你不去打别人吗。"
msgstr "Aren't you going to fight someone else."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER1"
msgid "你在看什么。"
msgstr "What are you looking at."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER2"
msgid "他得了金子热。"
msgstr "He's got gold fever."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER3"
msgid "泥点进你眼里了。"
msgstr "Mud got in your eye."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGELITEFIGHTER4"
msgid "你不去打别人吗。"
msgstr "Aren't you going to fight someone else."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGGUARD"
msgid "它看起来没有其他那些友善。"
msgstr "It looks less friendly than the others."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGGYBACK"
msgid "这只小猪\"回家\"了。"
msgstr "This little piggy \"went home\"."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHEAD.BURNT"
msgid "脆了。"
msgstr "Crispy now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHEAD.GENERIC"
msgid "看着像献给野兽的贡品。"
msgstr "Looks like an offering to the beast."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.BURNT"
msgid "现在不讲究了，猪。"
msgstr "Not refined anymore, pig."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.FULL"
msgid "能看见一个鼻子贴在窗上。"
msgstr "A nose is pressed against the window."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.GENERIC"
msgid "这些猪的房子挺讲究。"
msgstr "These pigs have rather refined houses."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "开门。我知道你在家。"
msgstr "Open up. I know you're home."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGKING"
msgid "很臭。"
msgstr "Very smelly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.DEAD"
msgid "该有人去通知它的家人。"
msgstr "Someone should notify its family."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.FOLLOWER"
msgid "你是我的随从之一。"
msgstr "You are one of my attendants."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.GENERIC"
msgid "它们让我有点不适。"
msgstr "They make me a bit uneasy."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.GUARD"
msgid "看着很认真。"
msgstr "Looks very serious."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGMAN.WEREPIG"
msgid "这只猪不友善。"
msgstr "This pig is not friendly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSHRINE.BURNT"
msgid "烧完了。"
msgstr "Finished burning."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSHRINE.EMPTY"
msgid "它想要肉。"
msgstr "It wants meat."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSHRINE.GENERIC"
msgid "又有东西可以做了。"
msgstr "Something else to work with."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGSKIN"
msgid "尾巴还留在上面。"
msgstr "The tail is still on it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGTENT"
msgid "一股培根味。"
msgstr "Smells of bacon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIGTORCH"
msgid "看着很舒服。"
msgstr "Looks comfortable."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIG_COIN"
msgid "打起来的时候它会派上用场。"
msgstr "It will come in handy when fighting starts."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIG_TOKEN"
msgid "这个看着很重要。"
msgstr "This looks important."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PINECONE"
msgid "里面有一棵想出来的树。"
msgstr "A tree that wants out is inside."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PINECONE_SAPLING"
msgid "它很快就会长成树。"
msgstr "It'll grow into a tree soon."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIRATE_FLAG_POLE"
msgid "喂。"
msgstr "Hey."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PIRATE_STASH"
msgid "我喜欢这个布置。"
msgstr "I like this arrangement."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PITCHFORK"
msgid "现在只缺一群愤怒的人。"
msgstr "Now all that's missing is an angry mob."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANTMEAT"
msgid "看着没什么食欲。"
msgstr "Not appetizing."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANTMEAT_COOKED"
msgid "至少现在是热的。"
msgstr "At least it's warm now."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANTREGISTRYHAT"
msgid "要理解植物，就得穿上植物。"
msgstr "To understand plants, one must wear the plant."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "长着叶子。"
msgstr "Growing leaves."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "长得太慢了。"
msgstr "Growing far too slowly."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.READY"
msgid "可以收了。"
msgstr "Ready to harvest."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "热把它杀了。"
msgstr "The heat killed it."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "\"作者 C.W.\""
msgstr "\"By C.W.\""

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "这一出你看过了吗。"
msgstr "Have you seen this one yet."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "作者写着\"E.\"吗。"
msgstr "Does it say \"E.\" as the author."

