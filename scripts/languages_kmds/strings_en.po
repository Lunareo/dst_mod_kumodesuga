msgstr "A stump."

#. STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAKABA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
